// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// =====================================================
// MODELS - Human Resources Management System
// =====================================================

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String    @unique @db.VarChar(255)
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  role                   String    @db.VarChar(50)
  employeeId             String?   @unique @map("employee_id") @db.Uuid
  isActive               Boolean   @default(true) @map("is_active")
  isGlobalBranchAccess   Boolean   @default(false) @map("is_global_branch_access")
  isEmailVerified        Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken String?   @map("email_verification_token") @db.VarChar(255)
  emailVerifiedAt        DateTime? @map("email_verified_at") @db.Timestamp(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee                 Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  rewards                  Reward[]                  @relation("CreatedByUser")
  disciplines              Discipline[]              @relation("CreatedByUser")
  chatMessages             ChatMessage[]
  auditLogs                AuditLog[]
  approvedLeaves           LeaveRequest[]            @relation("ApprovedByUser")
  requestedChanges         DepartmentChangeRequest[] @relation("RequestedBy")
  reviewedChanges          DepartmentChangeRequest[] @relation("ReviewedBy")
  departmentHistoryChanges DepartmentHistory[]       @relation("ChangedBy")
  uploadedDocuments        EmployeeDocument[]

  // NEW: Performed activities
  performedActivities EmployeeActivity[] @relation("PerformedActivities")

  // NEW: Contract termination relations
  requestedTerminations TerminationRequest[] @relation("RequestedTerminations")
  approvedTerminations  TerminationRequest[] @relation("ApprovedTerminations")
  createdAppendices     ContractAppendix[]   @relation("CreatedAppendices")
  companyKnowledges     CompanyKnowledge[]   @relation("UserKnowledge")
  notifications         Notification[]       @relation("UserNotifications")

  // Task Tracker relations
  taskComments             TaskComment[]             @relation("TaskComments")
  taskAttachments          TaskAttachment[]          @relation("TaskAttachments")
  taskActivities           TaskActivity[]            @relation("TaskActivities")
  approvedTimesheets       Timesheet[]               @relation("ApprovedTimesheets")
  leaveApprovals           LeaveApproval[]           @relation("LeaveApprovalDecider")
  leaveAttachments         LeaveAttachment[]         @relation("LeaveAttachmentUploader")
  approvedReimbursements   Reimbursement[]           @relation("ReimbursementApprover")
  reimbursementAttachments ReimbursementAttachment[] @relation("ReimbursementAttachmentUploader")
  approvedAdvanceLoans     AdvanceLoanRequest[]      @relation("AdvanceLoanApprover")
  approvedTravelRequests   TravelRequest[]           @relation("TravelApprover")
  trainingNominationsMade  TrainingNomination[]      @relation("TrainingNominatedBy")
  approvedTrainings        TrainingNomination[]      @relation("TrainingApprover")
  budgetsCreated           Budget[]                  @relation("BudgetCreatedBy")
  lettersIssued            LetterRequest[]           @relation("LetterIssuedBy")
  grievancesHandled        Grievance[]               @relation("GrievanceHandler")
  grievanceEvents          GrievanceEvent[]          @relation("GrievanceEventActor")
  assetAssignmentsMade     AssetAssignment[]         @relation("AssetAssignedBy")
  assetReturnsReceived     AssetAssignment[]         @relation("AssetReturnReceivedBy")
  advanceLoanAttachments   AdvanceLoanAttachment[]   @relation("AdvanceLoanAttachmentUploader")
  overtimeRequestsEdited   OvertimeRequest[]         @relation("OvertimeRequestEditor")

  // Legal document lifecycle relations
  createdLegalDocuments EmployeeLegalDocument[]   @relation("LegalDocumentCreator")
  legalDocAttachments   LegalDocumentAttachment[] @relation("LegalDocumentAttachmentUploader")

  // Multi-branch access grants (which branches this user may see)
  branchAccess UserBranchAccess[]

  // HR Copilot conversations
  copilotConversations CopilotConversation[]

  // WhatsApp delivery identities (0..n numbers per user)
  whatsappIdentities WhatsAppIdentity[] @relation("UserWhatsAppIdentities")

  // Discord accounts linked to this user
  discordIdentities DiscordIdentity[] @relation("UserDiscordIdentities")

  // Telegram chats linked to this user
  telegramIdentities TelegramIdentity[] @relation("UserTelegramIdentities")

  // Document engine authorship. Kept as four distinct relations rather than one
  // generic "actor" edge because drafting, publishing, uploading stationery and
  // generating a document are four different acts with four different audiences.
  docTemplateVersionsAuthored  DocumentTemplateVersion[] @relation("DocTemplateVersionAuthor")
  docTemplateVersionsPublished DocumentTemplateVersion[] @relation("DocTemplateVersionPublisher")
  documentAssetsCreated        DocumentAsset[]           @relation("DocumentAssetAuthor")
  generatedDocuments           GeneratedDocument[]       @relation("GeneratedDocumentAuthor")
  documentBatchesRequested     DocumentBatch[]           @relation("DocumentBatchRequester")

  @@index([role])
  @@map("users")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  managerId   String?  @map("manager_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  parent             Department?               @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Department[]              @relation("DepartmentHierarchy")
  manager            Employee?                 @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees          Employee[]                @relation("EmployeeDepartment")
  budgetLines        BudgetLine[]
  teams              Team[]
  changeRequests     DepartmentChangeRequest[]
  history            DepartmentHistory[]
  managerTransitions ManagerTransition[]
  oldParentRequests  DepartmentChangeRequest[] @relation("OldParent")
  newParentRequests  DepartmentChangeRequest[] @relation("NewParent")
  projects           Project[]

  @@map("departments")
}

// =====================================================
// Multi-Branch: physical location / office
// Orthogonal to Department. Employee has both a branchId (location)
// and a departmentId (function), independently.
// =====================================================
model Branch {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(255)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  // Physical address
  addressLine String? @map("address_line") @db.Text
  city        String? @db.VarChar(120)
  state       String? @db.VarChar(120)
  country     String? @db.VarChar(2) // ISO-3166 alpha-2 (location)
  postalCode  String? @map("postal_code") @db.VarChar(20)

  // Allowed banking countries (ISO-2) for employees of this branch. Empty => fall
  // back to `country`. Drives which bank-detail field schemas employees may use.
  bankingCountries String[] @default([]) @map("banking_countries")

  // Per-branch identity printed on generated documents (nullable => inherit the
  // company-wide SystemSetting, the same convention as the config block below).
  // A salary certificate issued by the Sohar office naming the Muscat CR number
  // is wrong in a way a bank will act on.
  phone       String? @db.VarChar(50)
  email       String? @db.VarChar(150)
  crNumber    String? @map("cr_number") @db.VarChar(50)
  vatNumber   String? @map("vat_number") @db.VarChar(50)

  // Per-branch config (nullable => inherit global SystemSetting)
  timezone        String? @db.VarChar(100) // IANA tz
  officeStartTime String? @map("office_start_time") @db.VarChar(5) // "HH:MM"
  officeEndTime   String? @map("office_end_time") @db.VarChar(5)
  weeklyOffDays   String? @map("weekly_off_days") @db.VarChar(20) // CSV of day numbers "5,6"; null => inherit global calendar_weekly_holidays

  // Per-branch geofence
  geofencingEnabled Boolean? @map("geofencing_enabled")
  latitude          Decimal? @db.Decimal(10, 7)
  longitude         Decimal? @db.Decimal(10, 7)
  geofenceRadiusM   Int?     @map("geofence_radius_meters")

  managerId String? @map("manager_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  manager          Employee?          @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees        Employee[]         @relation("EmployeeBranch")
  attendances      Attendance[]       @relation("AttendanceBranch")
  userAccess       UserBranchAccess[]
  holidays         Holiday[]
  payrolls         Payroll[]
  payrollBatches   PayrollBatch[]
  assets           AssetItem[]
  trainingSessions TrainingSession[]
  budgets          Budget[]
  loanTypes        LoanType[]
  ledgerAccounts   LedgerAccount[]
  ledgerMappings   LedgerMapping[]
  journalEntries   JournalEntry[]
  loanPolicy       LoanPolicy?

  // External attendance provider wired to this branch (at most one).
  attendanceIntegration AttendanceIntegration?

  // Wage-file (WPS) setup for this branch (at most one) + the files generated.
  wpsConfiguration WpsConfiguration?
  wpsFiles         WpsFile[]

  // Employee-form override for this branch (at most one active). Absent => the
  // company-wide template applies.
  profileTemplates ProfileTemplate[]

  // Document engine. Same COMPANY-or-BRANCH shape as profileTemplates above:
  // absent => the company-wide row applies.
  documentTemplates   DocumentTemplate[]
  documentAssets      DocumentAsset[]
  documentSignatories DocumentSignatory[]
  generatedDocuments  GeneratedDocument[]
  documentBatches     DocumentBatch[]

  @@index([isActive])
  @@map("branches")
}

// Grants: which branches a user (admin/HR) may access.
// A user's effective envelope = these rows ∪ their own employee.branchId,
// unless User.isGlobalBranchAccess = true (all branches).
model UserBranchAccess {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

model DepartmentChangeRequest {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  requestType  String @map("request_type") @db.VarChar(50)
  requestedBy  String @map("requested_by") @db.Uuid

  oldManagerId String? @map("old_manager_id") @db.Uuid
  oldParentId  String? @map("old_parent_id") @db.Uuid
  oldData      Json?   @map("old_data")

  newManagerId String? @map("new_manager_id") @db.Uuid
  newParentId  String? @map("new_parent_id") @db.Uuid
  newData      Json?   @map("new_data")

  reason String @db.Text
  status String @default("PENDING") @db.VarChar(50)

  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamp(6)
  reviewNote String?   @map("review_note") @db.Text

  effectiveDate DateTime @map("effective_date") @db.Timestamp(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requester   User                @relation("RequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer    User?               @relation("ReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  oldManager  Employee?           @relation("OldManager", fields: [oldManagerId], references: [id], onDelete: SetNull)
  newManager  Employee?           @relation("NewManager", fields: [newManagerId], references: [id], onDelete: SetNull)
  oldParent   Department?         @relation("OldParent", fields: [oldParentId], references: [id], onDelete: SetNull)
  newParent   Department?         @relation("NewParent", fields: [newParentId], references: [id], onDelete: SetNull)
  transitions ManagerTransition[]

  @@map("department_change_requests")
}

model DepartmentHistory {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  changeType   String @map("change_type") @db.VarChar(50)
  changedBy    String @map("changed_by") @db.Uuid

  oldValue     Json?   @map("old_value")
  newValue     Json?   @map("new_value")
  changeReason String? @map("change_reason") @db.Text

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation("ChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@map("department_history")
}

model ManagerTransition {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId    String  @map("department_id") @db.Uuid
  changeRequestId String? @map("change_request_id") @db.Uuid

  oldManagerId String? @map("old_manager_id") @db.Uuid
  newManagerId String  @map("new_manager_id") @db.Uuid

  status String @default("INITIATED") @db.VarChar(50)

  handoverTasks      Json @default("[]") @map("handover_tasks")
  completedTasks     Json @default("[]") @map("completed_tasks")
  progressPercentage Int  @default(0) @map("progress_percentage")

  startDate     DateTime  @default(now()) @map("start_date") @db.Timestamp(6)
  targetEndDate DateTime  @map("target_end_date") @db.Timestamp(6)
  actualEndDate DateTime? @map("actual_end_date") @db.Timestamp(6)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department    Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  changeRequest DepartmentChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  oldManager    Employee?                @relation("TransitionOldManager", fields: [oldManagerId], references: [id], onDelete: SetNull)
  newManager    Employee                 @relation("TransitionNewManager", fields: [newManagerId], references: [id], onDelete: Restrict)

  @@map("manager_transitions")
}

model Employee {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode     String   @unique @map("employee_code") @db.VarChar(50)
  fullName         String   @map("full_name") @db.VarChar(255)
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  gender           String?  @db.VarChar(20)
  idCard           String   @unique @map("id_card") @db.VarChar(50)
  address          String?  @db.Text
  phone            String?  @db.VarChar(20)
  /// ISO-3166 alpha-2 used to read `phone` when it was typed without a country
  /// prefix, so one instance can message a workforce spread over several
  /// countries. Null means "not stated" and falls back to the branch country,
  /// then whatsapp.defaultRegion, then payroll_country — it does NOT mean the
  /// number is local. A `phone` already stored with a '+' ignores this entirely.
  phoneCountryCode String?  @map("phone_country_code") @db.VarChar(2)
  email            String   @unique @db.VarChar(255)
  avatarUrl        String?  @map("avatar_url") @db.Text

  departmentId String  @map("department_id") @db.Uuid
  // Multi-branch home location. Nullable through backfill; set NOT NULL in Phase 4 (migration C).
  branchId     String? @map("branch_id") @db.Uuid

  // Dynamic supervisor assignment — an approval-responsibility link, NOT an RBAC role.
  // Independent of department management (managedDepartments). One supervisor per employee;
  // a supervisor may have many supervisees. SetNull so removing a supervisor detaches reports
  // without touching the org hierarchy. Resolved into req.user.supervisedEmployeeIds per request.
  supervisorId String?   @map("supervisor_id") @db.Uuid
  position     String    @db.VarChar(100)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String    @default("ACTIVE") @db.VarChar(50)

  // The contracted rate. Its PERIOD depends on salaryType: a monthly amount for
  // MONTHLY employees, a per-day rate for DAILY (daily-wage) employees.
  baseSalary Decimal @map("base_salary") @db.Decimal(12, 2)

  // Pay basis — MONTHLY (fixed monthly salary, absence handled by LOP) or DAILY
  // (daily-wage: paid strictly per day actually worked). Drives both the payroll
  // earnings calc and the overtime hourly rate. Deliberately an explicit column
  // rather than being inferred from the free-text employmentType label.
  salaryType String @default("MONTHLY") @map("salary_type") @db.VarChar(20)

  // Employment classification — a CONTRACT_TYPE library label (LibraryItem).
  // Drives the Overtime Policy inheritance chain (Employee Override → Employment
  // Type → Company Default). Null = not set → falls through to the company
  // default. Sourced from the Contract Type library so it is admin-configurable.
  employmentType String? @map("employment_type") @db.VarChar(100)

  // Per-employee Overtime Policy override — the highest-priority tier. Null →
  // fall through to the employment-type policy, then the company default, then
  // the legacy global overtime settings.
  overtimePolicyId String? @map("overtime_policy_id") @db.Uuid

  // Timezone for remote workers (IANA tz string e.g. 'America/New_York').
  // null = inherit company timezone set in system settings.
  timezone String? @db.VarChar(100)

  // Personal date-display format preference (one of 'DD/MM/YYYY',
  // 'MM/DD/YYYY', 'YYYY-MM-DD'). null = app default (DD/MM/YYYY).
  dateFormat String? @map("date_format") @db.VarChar(20)

  // Identity of this employee inside the branch's external attendance provider
  // (see AttendanceIntegration). Null = not linked yet; the sync auto-matches on
  // employeeCode and backfills this column, or an admin binds it by hand.
  // Unique per branch rather than globally: two providers may legitimately reuse
  // the same external id string for different people.
  attendanceExternalId String? @map("attendance_external_id") @db.VarChar(100)

  /// Values for Employee Profile Template fields whose storage is JSONB —
  /// i.e. the fields an admin invented, keyed by ProfileTemplateField.fieldKey.
  /// Fields bound to real columns NEVER live here; the mapping is the code
  /// registry EMPLOYEE_BOUND_COLUMNS, verified against Prisma.dmmf by a spec.
  /// GIN-indexed in migration 20260807120000.
  customFields Json? @map("custom_fields") @db.JsonB

  // Profile completion tracking
  hasCompleteProfile Boolean   @default(false) @map("has_complete_profile")
  profileLastUpdated DateTime? @map("profile_last_updated") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department            Department               @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  branch                Branch?                  @relation("EmployeeBranch", fields: [branchId], references: [id], onDelete: Restrict)
  managedBranches       Branch[]                 @relation("BranchManager")
  user                  User?
  managedDepartments    Department[]             @relation("DepartmentManager")
  supervisor            Employee?                @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees           Employee[]               @relation("EmployeeSupervisor")
  overtimePolicy        OvertimePolicy?          @relation("EmployeeOvertimePolicy", fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  contracts             Contract[]
  attendances           Attendance[]
  attendanceCorrections AttendanceCorrection[]
  overtimeRequests      OvertimeRequest[]
  reimbursements        Reimbursement[]
  advanceLoanRequests   AdvanceLoanRequest[]
  garnishmentOrders     GarnishmentOrder[]
  loanSettlements       LoanSettlement[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  leaveTypeBalances     LeaveTypeBalance[]
  leaveAccrualHistory   LeaveAccrualHistory[]
  salaryComponents      SalaryComponent[]
  payrollItems          PayrollItem[]
  gratuityAccruals      GratuityAccrual[]
  employeeRecoveries    EmployeeRecovery[]
  transfers             EmployeeTransfer[]
  gradeId               String?                  @map("grade_id") @db.Uuid
  grade                 Grade?                   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  finalSettlements      FinalSettlement[]
  leaveEncashments      LeaveEncashmentRequest[]
  payrollCarryForwards  PayrollCarryForward[]
  rewards               Reward[]
  disciplines           Discipline[]
  history               EmployeeHistory[]
  chatHistory           ChatHistory[]
  teamMemberships       TeamMember[]             @relation("EmployeeTeamMemberships")
  ledTeams              Team[]                   @relation("TeamLead")

  // Department change request relations
  oldManagerRequests    DepartmentChangeRequest[] @relation("OldManager")
  newManagerRequests    DepartmentChangeRequest[] @relation("NewManager")
  oldManagerTransitions ManagerTransition[]       @relation("TransitionOldManager")
  newManagerTransitions ManagerTransition[]       @relation("TransitionNewManager")

  // NEW: Employee profile and documents
  profile   EmployeeProfile?
  documents EmployeeDocument[]

  // Enterprise payment info — versioned bank details + change requests (Bank Master).
  bankDetails        EmployeeBankDetail[]
  bankChangeRequests BankChangeRequest[]
  wpsFileRows        WpsFileRow[]

  // Legal document lifecycle (visa, future: passport/work permit/emirates id)
  legalDocuments EmployeeLegalDocument[]

  // Company assets held. An OPEN assignment (returnedAt = null) blocks offboarding.
  assetAssignments AssetAssignment[] @relation("AssetHolder")

  // Trip requests raised. Expense claims land on `reimbursements` above.
  travelRequests TravelRequest[] @relation("TravelRequester")

  // Training nominations. Costs also land on `reimbursements`.
  trainingNominations TrainingNomination[] @relation("TrainingNominee")

  // Self-service letters and grievances.
  letterRequests    LetterRequest[] @relation("LetterRequester")

  // Documents generated ABOUT this employee, and their place in a bulk run.
  generatedDocuments GeneratedDocument[] @relation("GeneratedDocumentSubject")
  documentBatchItems DocumentBatchItem[] @relation("DocumentBatchSubject")
  grievancesRaised  Grievance[]     @relation("GrievanceRaisedBy")
  grievancesAgainst Grievance[]     @relation("GrievanceAgainst")

  // NEW: Employee activities
  activities      EmployeeActivity[] @relation("EmployeeActivities")
  workSchedules   WorkSchedule[]     @relation("EmployeeWorkSchedules")
  faceDescriptors FaceDescriptor[]   @relation("EmployeeFaceDescriptors")

  // Task Tracker relations
  assignedTasks           Task[]               @relation("TaskAssignees")
  reportedTasks           Task[]               @relation("ReportedTasks")
  workLogs                WorkLog[]            @relation("WorkLogs")
  timesheets              Timesheet[]          @relation("Timesheets")
  payrollBatchMemberships PayrollBatchMember[]

  // Project Management relations
  ownedProjects      Project[]       @relation("ProjectOwner")
  projectMemberships ProjectMember[] @relation("ProjectMemberEmployee")

  // `name` is the Prisma-side compound key; `map` is the actual DB index name —
  // without the latter Prisma would expect its own generated name and report drift.
  @@unique([branchId, attendanceExternalId], name: "unique_branch_external_attendance_id", map: "unique_branch_external_attendance_id")
  @@index([status])
  @@index([departmentId])
  @@index([branchId])
  @@index([supervisorId])
  @@index([overtimePolicyId])
  @@index([attendanceExternalId])
  @@map("employees")
}

model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  code         String   @unique @db.VarChar(50)
  description  String?  @db.Text
  departmentId String   @map("department_id") @db.Uuid
  teamLeadId   String?  @map("team_lead_id") @db.Uuid
  type         String   @default("PERMANENT") @db.VarChar(50) // PERMANENT, PROJECT, CROSS_FUNCTIONAL
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamLead   Employee?    @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members    TeamMember[]
  projects   Project[]

  @@map("teams")
}

model TeamMember {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId               String    @map("team_id") @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  role                 String    @default("MEMBER") @db.VarChar(50) // LEAD, MEMBER, CONTRIBUTOR
  allocationPercentage Int       @default(100) @map("allocation_percentage") // 0-100
  startDate            DateTime  @default(now()) @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation("EmployeeTeamMemberships", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId, startDate])
  @@map("team_members")
}

model Contract {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  contractType      String    @map("contract_type") @db.VarChar(50)
  workType          String    @default("FULL_TIME") @map("work_type") @db.VarChar(20)
  workHoursPerWeek  Int       @default(40) @map("work_hours_per_week")
  contractNumber    String?   @unique @map("contract_number") @db.VarChar(100)
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  salary            Decimal   @db.Decimal(12, 2)
  terms             String?   @db.Text
  notes             String?   @db.Text
  fileUrl           String?   @map("file_url") @db.Text
  status            String    @default("ACTIVE") @db.VarChar(50)
  terminatedReason  String?   @map("terminated_reason") @db.Text
  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  terminationRequests TerminationRequest[]
  appendices          ContractAppendix[]

  @@index([employeeId])
  @@index([status, endDate])
  @@map("contracts")
}

model Attendance {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  date             DateTime  @db.Date
  checkIn          DateTime? @map("check_in") @db.Timestamp(6)
  checkOut         DateTime? @map("check_out") @db.Timestamp(6)
  workHours        Decimal?  @map("work_hours") @db.Decimal(5, 2)
  isLate           Boolean   @default(false) @map("is_late")
  isEarlyLeave     Boolean   @default(false) @map("is_early_leave")
  isEarlyCheckIn   Boolean   @default(false) @map("is_early_check_in")
  isLateCheckout   Boolean   @default(false) @map("is_late_checkout")
  status           String    @default("PRESENT") @db.VarChar(50)
  notes            String?   @db.Text
  sessions         Json?
  checkInLatitude  Decimal?  @map("check_in_latitude") @db.Decimal(10, 7)
  checkInLongitude Decimal?  @map("check_in_longitude") @db.Decimal(10, 7)
  checkInAccuracy  Decimal?  @map("check_in_accuracy_m") @db.Decimal(8, 2)
  // Denormalized branch captured at check-in (stays with the branch where it happened,
  // even after the employee transfers). Nullable for legacy/imported rows.
  branchId         String?   @map("branch_id") @db.Uuid

  // Provenance. Null on rows written before this column existed — treated as
  // "unknown, safe to overwrite" by the sync conflict guard, with a notes-text
  // fallback that protects legacy manual entries. Values: ESS | MANUAL | SYNC |
  // AUTO | LEAVE. Deliberately VarChar, not a Postgres enum: ALTER TYPE ... ADD
  // VALUE cannot run inside a transaction, which makes enums painful to extend.
  source      String?   @db.VarChar(20)
  // Opaque record id from the external provider, for traceability + idempotency.
  externalRef String?   @map("external_ref") @db.VarChar(100)
  syncedAt    DateTime? @map("synced_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch      Branch?                @relation("AttendanceBranch", fields: [branchId], references: [id], onDelete: Restrict)
  corrections AttendanceCorrection[]

  @@unique([employeeId, date], name: "unique_employee_date")
  @@index([employeeId, date])
  @@index([date, status])
  @@index([branchId, date])
  @@index([source, date])
  @@map("attendances")
}

model LeaveRequest {
