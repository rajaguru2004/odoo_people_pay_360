  improvementsJson Json?   @map("improvements_json") @db.JsonB
  risksJson        Json?   @map("risks_json") @db.JsonB
  summary          String? @db.Text
  recommendation   String? @db.VarChar(30) // PROMOTE|REWARD|MAINTAIN|COACH|PIP
  rankOverall      Int?    @map("rank_overall")
  rankDepartment   Int?    @map("rank_department")
  metricsJson      Json?   @map("metrics_json") @db.JsonB // raw collected aggregates (explainability trail)
