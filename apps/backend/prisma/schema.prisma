enum LibraryType {
  POSITION
  SALARY_COMPONENT_TYPE
  CONTRACT_TYPE
  WORK_MODE
  LEAVE_TYPE
  DOCUMENT_TYPE
  VISA_TYPE
  EMPLOYMENT_TYPE
  ASSET_CATEGORY
  PER_DIEM_DESTINATION
  COURSE_CATEGORY
  BUDGET_CATEGORY
  GRIEVANCE_CATEGORY
}

model LibraryItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryType LibraryType @map("library_type")
  label       String      @db.VarChar(200)
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")

  // Metadata fields for LEAVE_TYPE
  defaultDays        Int?    @map("default_days")
  isPaid             Boolean @default(true) @map("is_paid")
  requiresNoticeDays Int     @default(0) @map("requires_notice_days")
  affectsBalance     Boolean @default(true) @map("affects_balance")
  genderRestriction  String? @map("gender_restriction") @db.VarChar(10)

  // Metadata field for EMPLOYMENT_TYPE: the pay basis this employment type
  // FORCES on any employee assigned to it. 'MONTHLY' | 'DAILY' | null
  // (unspecified — the employee's own salaryType stands). The server derives
  // Employee.salaryType from this, so no employment-type LABEL is ever
  // hardcoded in pay logic. VarChar, mirroring Employee.salaryType, so
  // toSalaryBasis() normalizes both sides with one function.
  payBasis String? @map("pay_basis") @db.VarChar(20)

  // Metadata field for PER_DIEM_DESTINATION: daily allowance for this
  // destination. Snapshotted onto TravelRequest at submit — never read live,
  // because remove() is a hard delete and edits must not change approved trips.
  perDiemRate Decimal? @map("per_diem_rate") @db.Decimal(12, 2)

  // Metadata field for LEAVE_TYPE: what happens to a loan EMI in a cycle this
  // leave overlaps. 'CONTINUE' | 'PAUSE' | 'EXTEND' | null (inherit the global
  // loan_unpaid_leave_policy). Resolved strictest-wins across every approved
  // leave overlapping the cycle, which is how maternity / sabbatical /
  // suspension / long-medical each get their own rule without new code.
  loanDeductionPolicy String? @map("loan_deduction_policy") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([libraryType, label])
  @@map("library_items")
}

model LeaveTypeBalance {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  year                 Int
  leaveTypeKey         String    @map("leave_type_key") @db.VarChar(100) // matches LibraryItem.label
  allocated            Int       @default(0)
  used                 Int       @default(0)
  carriedOver          Int       @default(0)
  /// When the carried balance lapses, if the policy sets an expiry.
  carriedOverExpiresOn DateTime? @map("carried_over_expires_on") @db.Date
  /// Which year the carried days came from, so a reversal knows what to undo.
  carriedFromYear      Int?      @map("carried_from_year")
  /// The run that wrote them. A reversal touches exactly these rows, no others.
  carryForwardRunId    String?   @map("carry_forward_run_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveTypeKey])
  @@map("leave_type_balances")
}

