enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  LOCKED
}

/// What kind of run a payroll is. Distinguishes a regular cycle from a bonus,
/// an adjustment (retro pay, arrears), an off-cycle run and a final settlement.
enum PayrollRunType {
  REGULAR
  OFF_CYCLE
  BONUS
  ADJUSTMENT
  FINAL_SETTLEMENT
}

// ── Configurable approval hierarchy ─────────────────────────────────────────
// Which request kinds route through the configurable engine.
enum ApprovalRequestType {
  LEAVE
  OVERTIME
  BANK_CHANGE
  TRAVEL
  TRAINING
}

// Step resolvers — how each step's approver(s) are found at runtime. These are
// NOT RBAC roles; SUPERVISOR/MANAGER resolve to data-driven assignees.
enum ApproverType {
  SUPERVISOR
  MANAGER
  HR_MANAGER
  ADMIN
}

// How a chain's steps are activated.
//   SEQUENTIAL — one step at a time; a step only becomes actionable after the
//                previous step's approver accepts (default).
//   PARALLEL   — every step is actionable immediately; the request is approved
//                only once all steps have approved (any order).
enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
}

// Admin-configured ordered approval chain, one active per request type.
model ApprovalWorkflow {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType ApprovalRequestType @map("request_type")
  name        String?             @db.VarChar(150)
  mode        ApprovalMode        @default(SEQUENTIAL)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  steps ApprovalStep[]

  @@index([requestType])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId   String       @map("workflow_id") @db.Uuid
  stepOrder    Int          @map("step_order") // 1..n
  approverType ApproverType @map("approver_type")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
  @@map("approval_steps")
}

// Runtime approval trail materialized per request. Generalizes the legacy
// LeaveApproval model so leave + overtime share one engine. resolvedApproverId
// is snapshotted when a step becomes active so mid-flight supervisor
// reassignment cannot hijack an already-active decision.
model RequestApproval {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType        ApprovalRequestType @map("request_type")
  requestId          String              @map("request_id") @db.Uuid // leaveRequestId | overtimeRequestId
  stepOrder          Int                 @map("step_order")
  approverType       ApproverType        @map("approver_type")
  resolvedApproverId String?             @map("resolved_approver_id") @db.Uuid // snapshotted user at activation
  status             String              @default("PENDING") @db.VarChar(50) // PENDING | ACTIVE | APPROVED | REJECTED | SKIPPED
  comment            String?             @db.Text
  decidedById        String?             @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?           @map("decided_at") @db.Timestamp(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([requestType, requestId])
  @@index([resolvedApproverId])
  @@map("request_approvals")
}

model Payroll {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month             Int
  year              Int
  status            PayrollStatus  @default(DRAFT)
  totalAmount       Decimal        @default(0) @map("total_amount") @db.Decimal(15, 2)
  finalizedAt       DateTime?      @map("finalized_at") @db.Timestamp(6)
  finalizedBy       String?        @map("finalized_by") @db.Uuid
  approvedBy        String?        @map("approved_by") @db.Uuid
  approvedAt        DateTime?      @map("approved_at") @db.Timestamp(6)
  rejectedBy        String?        @map("rejected_by") @db.Uuid
  rejectedAt        DateTime?      @map("rejected_at") @db.Timestamp(6)
  rejectionReason   String?        @map("rejection_reason") @db.Text
  lockedAt          DateTime?      @map("locked_at") @db.Timestamp(6)
  lockedBy          String?        @map("locked_by") @db.Uuid
  /// Distinguishes a regular cycle from a bonus, an adjustment (retro pay,
  /// arrears), an off-cycle run and a final settlement.
  runType           PayrollRunType @default(REGULAR) @map("run_type")
  unlockedAt        DateTime?      @map("unlocked_at") @db.Timestamp(6)
  unlockedBy        String?        @map("unlocked_by") @db.Uuid
  unlockReason      String?        @map("unlock_reason") @db.Text
  unlockCount       Int            @default(0) @map("unlock_count")
  version           Int            @default(1)
  previousVersionId String?        @map("previous_version_id") @db.Uuid
  submittedAt       DateTime?      @map("submitted_at") @db.Timestamp(6)
  submittedBy       String?        @map("submitted_by") @db.Uuid
  notes             String?        @db.Text
  batchId           String?        @map("batch_id") @db.Uuid
  branchId          String?        @map("branch_id") @db.Uuid // per-branch payroll; null => legacy company-wide run
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  batch           PayrollBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items           PayrollItem[]
  previousVersion Payroll?      @relation("PayrollVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    Payroll[]     @relation("PayrollVersions")

  // Period uniqueness is an EXPRESSION index Prisma cannot express, enforced in
  // migration 20260805100000. A plain @@unique([month, year, batchId]) does not
  // bind: batch_id is NULL for every run without a batch, and Postgres treats
  // NULLs as distinct, so it permitted unlimited duplicate runs for a period.
  //   CREATE UNIQUE INDEX uniq_payroll_period_branch_batch_version ON payrolls(
  //     month, year, COALESCE(branch_id, <nil-uuid>), COALESCE(batch_id, <nil-uuid>), version);
  @@index([status])
  @@index([approvedBy])
  @@index([version])
  @@index([previousVersionId])
  @@index([branchId])
  @@map("payrolls")
}

model PayrollItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollId       String   @map("payroll_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  baseSalary      Decimal  @map("base_salary") @db.Decimal(12, 2)
  workDays        Int      @map("work_days")
  actualWorkDays  Decimal  @map("actual_work_days") @db.Decimal(5, 2)
  allowances      Decimal  @default(0) @db.Decimal(12, 2)
  bonus           Decimal  @default(0) @db.Decimal(12, 2)
  deduction       Decimal  @default(0) @db.Decimal(12, 2)
  overtimeHours   Decimal  @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  overtimePay     Decimal  @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  foodAllowance   Decimal  @default(0) @map("food_allowance") @db.Decimal(12, 2)
  /// Site allowance granted by an approver on an individual overtime request.
  ///
  /// Its own column rather than folded into `foodAllowance` so the payslip can
  /// name what it is paying for. An EARNING, taxable, and it reaches the
  /// allowances sum like any other earning.
  siteAllowance   Decimal  @default(0) @map("site_allowance") @db.Decimal(12, 2)
  /// Court-ordered attachment of earnings. Subtracted from the pool after the
  /// statutory deductions, so the statutory > garnishment > protected-net
  /// priority ladder is enforced structurally rather than aspirationally.
  garnishment     Decimal  @default(0) @db.Decimal(12, 2)
  /// Leave paid out instead of taken.
  ///
  /// Its own column rather than folded into `bonus`: `bonus` means rewards, and
  /// overloading it would make the taxability question a migration instead of a
  /// setting. Contributes a literal 0 while the feature is off.
  leaveEncashment Decimal  @default(0) @map("leave_encashment") @db.Decimal(12, 2)
  /// Asset damage, training bonds and other employer recoveries.
  ///
  /// Its own column because recovery must be POST-TAX. `deduction` sits inside
  /// gross, so folding it there would reduce the employee's taxable base, which
  /// is simply wrong; `garnishment` would mislabel it.
  otherRecovery   Decimal  @default(0) @map("other_recovery") @db.Decimal(12, 2)
  /// End-of-service benefit PAID THROUGH this run.
  ///
  /// Normally zero: gratuity is a provision, not a payslip line, and an exit is
  /// settled outside payroll. Some jurisdictions require the whole exit package
  /// to appear on the payslip, and `payroll_eosb_pay_through_final_run` says
  /// whether this is one of them.
  /// Only ever non-zero on a FINAL_SETTLEMENT run.
  gratuityPayout  Decimal  @default(0) @map("gratuity_payout") @db.Decimal(12, 2)
  insurance       Decimal  @default(0) @db.Decimal(12, 2)
  tax             Decimal  @default(0) @db.Decimal(12, 2)
  netSalary       Decimal  @map("net_salary") @db.Decimal(12, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  payroll          Payroll                  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines            PayrollItemLine[]
  leaveEncashments LeaveEncashmentRequest[]

  @@unique([payrollId, employeeId], name: "unique_payroll_employee")
  @@index([employeeId])
  @@map("payroll_items")
}

/// One line of a payslip's itemised breakdown.
///
/// The columns on `PayrollItem` stay authoritative: they are what the employee
/// is paid and what every existing report reads.
/// A line explains a column, it never produces one — which is what lets this
/// ship on a running payroll without changing a single figure.
///
/// `bucket` names the column the line rolls into, and the reconciliation
/// invariant is stated per bucket: `sum(lines where bucket = b) == item.b`.
/// Grouping by EARNING/DEDUCTION alone would not do, because `deduction`,
/// `insurance` and `tax` are three separate deduction columns computed by three
/// different rules — a PF line could reconcile against an insurance premium and
/// the sum would balance while the payslip lied.
model PayrollItemLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollItemId String   @map("payroll_item_id") @db.Uuid
  /// Stable machine key the UI and reports join on: BASIC, PF, LOP, OT…
  code          String   @db.VarChar(50)
  /// The human label AS AT GENERATION. Snapshotted rather than derived so
  /// renaming a library item cannot rewrite what a payslip issued two years
  /// ago says it paid.
  label         String   @db.VarChar(150)
  /// EARNING | DEDUCTION. This carries the sign; `amount` is always positive.
  category      String   @db.VarChar(20)
  /// The `PayrollItem` column this line rolls into.
  bucket        String   @db.VarChar(30)
  amount        Decimal  @db.Decimal(12, 2)
  sourceType    String?  @map("source_type") @db.VarChar(30)
  sourceId      String?  @map("source_id") @db.Uuid
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  item PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollItemId, displayOrder])
  @@map("payroll_item_lines")
}

/// Held against the employee and taken from the next run, so a short recovery
/// under-recovers for ONE period instead of being silently written off. This
/// is one mechanism serving two decisions: a garnishment larger than available
/// pay, and any other deduction that exceeded net.
///
/// A balance does NOT die with the employment. On exit an unrecovered row
/// becomes `RECEIVABLE` — a debt on record — rather than being written off
/// silently.
model PayrollCarryForward {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid

  /// GARNISHMENT | DEDUCTION — what the shortfall came from.
  kind String @db.VarChar(20)

  /// The `Garnishment` the shortfall belongs to, when there is one.
  sourceId String? @map("source_id") @db.Uuid

  /// The original shortfall, and how much of it later runs have taken.
  amount          Decimal @db.Decimal(12, 2)
  amountRecovered Decimal @default(0) @map("amount_recovered") @db.Decimal(12, 2)

  /// OUTSTANDING | RECOVERED | RECEIVABLE | WAIVED
  status String @default("OUTSTANDING") @db.VarChar(20)

  /// The run that could not take it, and the run that finally cleared it.
  /// SetNull rather than Cascade: deleting a draft payroll must not destroy
  /// the record of a debt it created.
  originPayrollId  String? @map("origin_payroll_id") @db.Uuid
  clearedPayrollId String? @map("cleared_payroll_id") @db.Uuid

  /// The MOST RECENT run to take something off this balance, and how much.
  ///
  /// Only the last one, deliberately: this exists so deleting or unlocking a
  /// run can put back exactly what that run took, and a reversal always
  /// targets the newest run against the balance. A full recovery history would
  /// be a second table for a question nobody has asked.
  lastRecoveryPayrollId String?  @map("last_recovery_payroll_id") @db.Uuid
  lastRecoveryAmount    Decimal? @map("last_recovery_amount") @db.Decimal(12, 2)

  /// Why it could not be taken — carried straight onto the payslip note.
  reason String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  clearedAt DateTime? @map("cleared_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([branchId, status])
  @@map("payroll_carry_forwards")
}

model PayrollBatch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  branchId    String?  @map("branch_id") @db.Uuid // per-branch batch; null => legacy company-wide
