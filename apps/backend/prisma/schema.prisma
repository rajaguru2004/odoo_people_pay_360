// People Pay 360 — Prisma schema
//
// Conventions carried over from the ESS/HRM checkout and worth keeping:
//   • Model names are PascalCase singular; every table/column is mapped to
//     snake_case with @map/@@map, so the database reads naturally to a DBA and
//     the client reads naturally to TypeScript.
//   • Ids are database-generated uuids (`gen_random_uuid()`), not application
//     ones, so a row inserted by a migration or by hand is indistinguishable
//     from one the app made.
//   • Money is Decimal(18, 3) — three decimals because the Gulf currencies this
//     is built for (OMR, KWD, BHD) are thousandths, not hundredths. Never Float:
//     binary floating point cannot represent 0.1 and payroll must balance.
//   • Timestamps are @db.Timestamp(6) and stored UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  ADMIN
  HR_MANAGER
  PAYROLL_OFFICER
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

/// Where a day's attendance row ended up. Stored, not derived, because the
/// rules that produce it (grace period, half-day threshold, the branch calendar)
/// change over time and a historical row must keep the verdict it was given.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

/// How a row got there. Load-bearing for the correction flow: a MANUAL row was
/// entered by a human and must never be silently overwritten by a later import.
enum AttendanceSource {
  ESS
  MANUAL
  BIOMETRIC
  IMPORT
  SYSTEM
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftType {
  MORNING
  AFTERNOON
  FULL_DAY
  NIGHT
  FLEXIBLE
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  PART_TIME
  INTERNSHIP
  CONSULTANT
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum WorkType {
  FULL_TIME
  PART_TIME
  REMOTE
  HYBRID
}

/// Why the employment ended. Drives the settlement calculation downstream, so
/// it is an enum rather than free text.
enum TerminationCategory {
  RESIGNATION
  DISMISSAL
  END_OF_CONTRACT
  RETIREMENT
  REDUNDANCY
  MUTUAL_AGREEMENT
  DEATH
}

/// What a department change request is asking for. The reviewer's screen
/// branches on this, and so does the apply step.
enum DepartmentChangeType {
  MANAGER
  PARENT
  RENAME
  DEACTIVATE
}

enum TeamType {
  PERMANENT
  PROJECT
  CROSS_FUNCTIONAL
}

enum TeamMemberRole {
  LEAD
  MEMBER
  CONTRIBUTOR
}

/// Government identifier categories. `VISA` is the one the visa-report screen
/// filters on; the rest share the same expiry-tracking machinery.
enum LegalDocumentCategory {
  VISA
  LABOUR_CARD
  CIVIL_ID
  NATIONAL_ID
  WORK_PERMIT
  PASSPORT
  RESIDENCE_PERMIT
}

enum LegalDocumentStatus {
  ACTIVE
  EXPIRED
  RENEWED
  CANCELLED
}

// =====================================================
// IDENTITY
// =====================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(EMPLOYEE)
  employeeId   String?   @unique @map("employee_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee  Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  // Review trails. Every one is SetNull on the reviewer side and Restrict on the
  // requester side: deactivating a reviewer must not erase the request they
  // approved, and a request with no requester at all is a record nobody owns.
  changeRequestsRaised   DepartmentChangeRequest[] @relation("ChangeRequestRequester")
  changeRequestsReviewed DepartmentChangeRequest[] @relation("ChangeRequestReviewer")
  terminationsRaised     TerminationRequest[]      @relation("TerminationRequester")
  terminationsReviewed   TerminationRequest[]      @relation("TerminationReviewer")
  correctionsReviewed    AttendanceCorrection[]    @relation("CorrectionReviewer")

  // Employee self-service
  leavesApproved       LeaveRequest[]       @relation("LeaveApprovedBy")
  leaveAttachments     LeaveAttachment[]    @relation("LeaveAttachmentUploader")
  overtimeApproved     OvertimeRequest[]    @relation("OvertimeApprovedBy")
  overtimeEdited       OvertimeRequest[]    @relation("OvertimeRequestEditor")
  approvalsAssigned    RequestApproval[]    @relation("RequestApprovalApprover")
  approvalsDecided     RequestApproval[]    @relation("RequestApprovalDecider")
  documentsUploaded    EmployeeDocument[]   @relation("DocumentUploader")
  lettersIssued        LetterRequest[]      @relation("LetterIssuedBy")
  assetsAssigned       AssetAssignment[]    @relation("AssetAssignedBy")
  assetReturnsReceived AssetAssignment[]    @relation("AssetReturnReceivedBy")
  trainingNominated    TrainingNomination[] @relation("TrainingNominatedBy")
  trainingApproved     TrainingNomination[] @relation("TrainingApprover")
  grievancesHandled    Grievance[]          @relation("GrievanceHandler")
  grievanceEvents      GrievanceEvent[]     @relation("GrievanceEventActor")

  @@index([role])
  @@map("users")
}

// =====================================================
// ORGANISATION
// =====================================================

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  legalName String?  @map("legal_name") @db.VarChar(255)
  /// IANA zone. Every wall-clock the app stores — shift starts, cut-off times —
  /// is interpreted in THIS zone, not in the browser's. Getting that wrong is
  /// how reminders end up firing hours early for half the workforce.
  timezone  String   @default("Asia/Muscat") @db.VarChar(64)
  currency  String   @default("OMR") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branches Branch[]

  @@map("companies")
}

/// A physical place of work.
///
/// Orthogonal to Department: an employee has a branch (where they are) and a
/// department (what they do), and neither implies the other. Every per-branch
/// setting below is NULLABLE and means "inherit the company value" when unset —
/// an explicit null rather than a copied default, so changing the company
/// setting moves every branch that never overrode it.
model Branch {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(255)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  // Where it is.
  addressLine String? @map("address_line") @db.Text
  city        String? @db.VarChar(120)
  state       String? @db.VarChar(120)
  /// ISO-3166 alpha-2.
  country     String? @db.VarChar(2)
  postalCode  String? @map("postal_code") @db.VarChar(20)

  // Identity printed on documents this branch issues. A salary certificate from
  // the Sohar office naming the Muscat CR number is wrong in a way a bank acts on.
  phone     String? @db.VarChar(32)
  email     String? @db.VarChar(255)
  crNumber  String? @map("cr_number") @db.VarChar(64)
  vatNumber String? @map("vat_number") @db.VarChar(64)

  // The working calendar. `officeStartTime`/`officeEndTime` are WALL CLOCK in
  // `timezone` — "08:00", not an instant — because a shift starts at eight in
  // the morning wherever the reader happens to be.
  timezone        String? @db.VarChar(64)
  officeStartTime String? @map("office_start_time") @db.VarChar(5)
  officeEndTime   String? @map("office_end_time") @db.VarChar(5)
  /// Minutes after `officeStartTime` before an arrival counts as LATE.
  graceMinutes    Int?    @map("grace_minutes")
  /// Weekly rest days as ISO weekday numbers (1 = Monday … 7 = Sunday). Empty
  /// means "inherit the company calendar", which is why it is not defaulted to
  /// a Fri/Sat pair that would be wrong for half the region.
  weeklyOffDays   Int[]   @default([]) @map("weekly_off_days")

  // Geofence for ESS check-in. All four are needed for a fence to apply.
  geofencingEnabled Boolean? @map("geofencing_enabled")
  latitude          Decimal? @db.Decimal(10, 7)
  longitude         Decimal? @db.Decimal(10, 7)
  geofenceRadiusM   Int?     @map("geofence_radius_meters")

  managerId String? @map("manager_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager          Employee?         @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  departments      Department[]
  employees        Employee[]
  attendances      Attendance[]
  holidays         Holiday[]
  assets           AssetItem[]
  trainingSessions TrainingSession[]

  @@index([companyId])
  @@index([isActive])
  @@map("branches")
}

/// A functional unit, optionally nested inside another.
///
/// `parentId` is what the org chart walks. A cycle in it would make that walk
/// non-terminating, so the service refuses to create one — the database cannot
/// express that constraint.
model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  managerId   String?  @map("manager_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch         Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent         Department?               @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[]              @relation("DepartmentHierarchy")
  manager        Employee?                 @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees      Employee[]
  teams          Team[]
  changeRequests DepartmentChangeRequest[]
  oldParentOf    DepartmentChangeRequest[] @relation("ChangeRequestOldParent")
  newParentOf    DepartmentChangeRequest[] @relation("ChangeRequestNewParent")

  @@index([branchId])
  @@index([parentId])
  @@map("departments")
}

/// A proposed change to a department that somebody else has to approve.
///
/// The old and new values are captured as COLUMNS, not only inside `payload`,
/// so the queue screen can render "Finance → Operations" without resolving two
/// json blobs, and so the apply step has a typed value to write back.
model DepartmentChangeRequest {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String               @map("department_id") @db.Uuid
  changeType   DepartmentChangeType @map("change_type")
  status       RequestStatus        @default(PENDING)

  oldManagerId String? @map("old_manager_id") @db.Uuid
  newManagerId String? @map("new_manager_id") @db.Uuid
  oldParentId  String? @map("old_parent_id") @db.Uuid
  newParentId  String? @map("new_parent_id") @db.Uuid
  oldName      String? @map("old_name") @db.VarChar(255)
  newName      String? @map("new_name") @db.VarChar(255)

  reason        String    @db.Text
  effectiveDate DateTime  @map("effective_date") @db.Date
  requestedById String    @map("requested_by_id") @db.Uuid
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamp(6)
  reviewNote    String?   @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("ChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  oldManager  Employee?   @relation("ChangeRequestOldManager", fields: [oldManagerId], references: [id], onDelete: SetNull)
  newManager  Employee?   @relation("ChangeRequestNewManager", fields: [newManagerId], references: [id], onDelete: SetNull)
  oldParent   Department? @relation("ChangeRequestOldParent", fields: [oldParentId], references: [id], onDelete: SetNull)
  newParent   Department? @relation("ChangeRequestNewParent", fields: [newParentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([status])
  @@map("department_change_requests")
}

// =====================================================
// PEOPLE
// =====================================================

model Employee {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode  String         @unique @map("employee_code") @db.VarChar(32)
  firstName     String         @map("first_name") @db.VarChar(120)
  lastName      String         @map("last_name") @db.VarChar(120)
  workEmail     String?        @unique @map("work_email") @db.VarChar(255)
  personalEmail String?        @map("personal_email") @db.VarChar(255)
  phone         String?        @db.VarChar(32)
  position      String?        @db.VarChar(160)
  status        EmployeeStatus @default(ACTIVE)
  hireDate      DateTime?      @map("hire_date") @db.Date
  exitDate      DateTime?      @map("exit_date") @db.Date

  // Personal details. `dateOfBirth` is a DATE, never an instant — see the note
  // on formatDateOnly in the frontend: a birthday put through a zone conversion
  // lands on the previous day for anyone west of Greenwich.
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @db.VarChar(20)
  /// ISO-3166 alpha-2.
  nationality String?   @db.VarChar(2)
  /// Government identifier — civil ID, national ID, whatever the jurisdiction
  /// issues. Unique because two employees sharing one is a duplicate record.
  nationalId  String?   @unique @map("national_id") @db.VarChar(64)
  address     String?   @db.Text

  branchId     String? @map("branch_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  managerId    String? @map("manager_id") @db.Uuid
  /// The approval link, which is NOT the org hierarchy.
  ///
  /// `managerId` says where a person sits in the structure; `supervisorId` says
  /// who signs their leave and their timesheet. They are usually the same
  /// person and sometimes deliberately are not — a matrixed engineer reports to
  /// a functional head and is supervised by a project lead. Keeping one column
  /// for both is how a reorganisation silently reroutes every pending approval.
  supervisorId String? @map("supervisor_id") @db.Uuid

  /// Personal IANA zone. NULL means "use the branch zone, then the company
  /// zone" — an explicit null rather than a copied default, so changing the
  /// company zone moves everyone who never set one.
  timezone  String? @db.VarChar(64)
  avatarUrl String? @map("avatar_url") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager            Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]       @relation("EmployeeManager")
  supervisor         Employee?        @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisees        Employee[]       @relation("EmployeeSupervisor")
  managedDepartments Department[]     @relation("DepartmentManager")
  managedBranches    Branch[]         @relation("BranchManager")
  user               User?
  salaryStructure    SalaryStructure?
  payslips           Payslip[]

  contracts             Contract[]
  attendances           Attendance[]
  attendanceCorrections AttendanceCorrection[]
  workSchedules         WorkSchedule[]
  faceEnrollments       FaceEnrollment[]
  legalDocuments        EmployeeLegalDocument[]
  teamMemberships       TeamMember[]
  ledTeams              Team[]                  @relation("TeamLead")

  oldManagerOf DepartmentChangeRequest[] @relation("ChangeRequestOldManager")
  newManagerOf DepartmentChangeRequest[] @relation("ChangeRequestNewManager")

  // Employee self-service
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  leaveTypeBalances   LeaveTypeBalance[]
  leaveAccruals       LeaveAccrualHistory[]
  overtimeRequests    OvertimeRequest[]
  /// An EMPLOYMENT_TYPE library label. The MIDDLE tier of the overtime policy
  /// chain — employee override, then this, then the company default. Null falls
  /// through to the next tier rather than meaning "no overtime", which is why
  /// it is nullable and not defaulted.
  ///
  /// Held on the employee rather than read from the live contract: a contract
  /// that ends must not silently change which policy governs a request that was
  /// already approved under it.
  employmentType      String?               @map("employment_type") @db.VarChar(100)
  overtimePolicyId    String?               @map("overtime_policy_id") @db.Uuid
  overtimePolicy      OvertimePolicy?       @relation("EmployeeOvertimePolicy", fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  documents           EmployeeDocument[]
  letterRequests      LetterRequest[]       @relation("LetterRequester")
  assetAssignments    AssetAssignment[]     @relation("AssetHolder")
  trainingNominations TrainingNomination[]  @relation("TrainingNominee")
  grievancesRaised    Grievance[]           @relation("GrievanceRaisedBy")
  grievancesAgainst   Grievance[]           @relation("GrievanceAgainst")

  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([supervisorId])
  @@index([managerId])
  @@map("employees")
}

// =====================================================
// PEOPLE — TEAMS
// =====================================================

/// A working group inside a department, with its own lead.
///
/// Distinct from Department: a department is permanent structure, a team is who
/// is actually working together this quarter. A person may be in several.
model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  departmentId String   @map("department_id") @db.Uuid
  teamLeadId   String?  @map("team_lead_id") @db.Uuid
  type         TeamType @default(PERMANENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamLead   Employee?    @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members    TeamMember[]

  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String         @map("team_id") @db.Uuid
  employeeId String         @map("employee_id") @db.Uuid
  role       TeamMemberRole @default(MEMBER)
  /// 0–100. A person split across three teams at 100% each is a staffing
  /// problem the roster should be able to show, so this is stored rather than
  /// assumed.
  allocation Int            @default(100)
  startDate  DateTime       @default(now()) @map("start_date") @db.Date
  endDate    DateTime?      @map("end_date") @db.Date
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One membership per person per team. A second stint is the same row
  /// reactivated, not a duplicate — otherwise every roster count double-counts.
  @@unique([teamId, employeeId])
  @@index([employeeId])
  @@map("team_members")
}

// =====================================================
// PEOPLE — CONTRACTS
// =====================================================

model Contract {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  contractNumber   String         @unique @map("contract_number") @db.VarChar(64)
  contractType     ContractType   @map("contract_type")
  workType         WorkType       @default(FULL_TIME) @map("work_type")
  status           ContractStatus @default(DRAFT)
  startDate        DateTime       @map("start_date") @db.Date
  /// NULL for a permanent contract. Anything else is a date the expiry report
  /// counts down to.
  endDate          DateTime?      @map("end_date") @db.Date
  /// End of the probation window, when there is one. Its own column rather than
  /// a derived "startDate + 3 months": probation lengths differ per contract
  /// and per jurisdiction, and the People hub counts down to this exact date.
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  workHoursPerWeek Int            @default(40) @map("work_hours_per_week")
  /// The contracted rate for the period implied by `contractType`. Decimal(18,3)
  /// for the same reason as every other money column — see the header note.
  salary           Decimal        @db.Decimal(18, 3)
  currency         String         @default("OMR") @db.VarChar(3)
  noticePeriodDays Int            @default(30) @map("notice_period_days")
  annualLeaveDays  Int            @default(30) @map("annual_leave_days")
  terms            String?        @db.Text
  notes            String?        @db.Text
  documentUrl      String?        @map("document_url") @db.VarChar(512)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  terminations TerminationRequest[]

  @@index([employeeId])
  @@index([status, endDate])
  @@map("contracts")
}

/// The offboarding request, and its approval.
///
/// Separate from `Employee.exitDate` on purpose: a termination is PROPOSED,
/// reviewed and only then applied, and the employee record must not change
/// while the request is still pending.
model TerminationRequest {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  category        TerminationCategory
  status          RequestStatus       @default(PENDING)
  noticeDate      DateTime            @map("notice_date") @db.Date
  terminationDate DateTime            @map("termination_date") @db.Date
  reason          String              @db.Text
  /// Whether the notice period is being served or paid out. Reaches the final
  /// settlement, so it is recorded at request time rather than inferred later.
  noticeServed    Boolean             @default(true) @map("notice_served")
  requestedById   String              @map("requested_by_id") @db.Uuid
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamp(6)
  reviewNote      String?             @map("review_note") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("TerminationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?    @relation("TerminationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([status])
  @@index([terminationDate])
  @@map("termination_requests")
}

/// A government document with an expiry date — visa, labour card, passport.
///
/// One `isCurrent` record per (employee, category); a renewal creates a NEW row
/// pointing back at the one it replaced and marks the old one RENEWED. History
/// is never overwritten, because "when did this visa actually lapse" is a
/// question an auditor asks about a date that has already passed.
model EmployeeLegalDocument {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  category         LegalDocumentCategory @default(VISA)
  status           LegalDocumentStatus   @default(ACTIVE)
  documentNumber   String                @map("document_number") @db.VarChar(100)
  documentType     String?               @map("document_type") @db.VarChar(100)
  country          String                @db.VarChar(100)
  nationality      String?               @db.VarChar(2)
  issueDate        DateTime              @map("issue_date") @db.Date
  expiryDate       DateTime              @map("expiry_date") @db.Date
  issuingAuthority String?               @map("issuing_authority") @db.VarChar(200)
  placeOfIssue     String?               @map("place_of_issue") @db.VarChar(200)
  sponsor          String?               @db.VarChar(200)
  remarks          String?               @db.Text
  isCurrent        Boolean               @default(true) @map("is_current")
  renewedFromId    String?               @map("renewed_from_id") @db.Uuid
  documentUrl      String?               @map("document_url") @db.VarChar(512)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  renewedFrom EmployeeLegalDocument?  @relation("LegalDocumentRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    EmployeeLegalDocument[] @relation("LegalDocumentRenewal")

  @@index([employeeId, category])
  @@index([category, status])
  @@index([expiryDate])
  @@map("employee_legal_documents")
}

// =====================================================
// TIME AND ATTENDANCE
// =====================================================

/// One row per employee per day.
///
/// `date` is a DATE, not an instant: it is the day the work is ATTRIBUTED to,
/// which for a night shift is not the calendar day the check-out falls on. The
/// check-in and check-out beside it are instants, stored UTC, because those are
/// moments in time and the report renders them in the branch's zone.
model Attendance {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String           @map("employee_id") @db.Uuid
  branchId      String?          @map("branch_id") @db.Uuid
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in") @db.Timestamp(6)
  checkOut      DateTime?        @map("check_out") @db.Timestamp(6)
  /// Hours actually worked, computed at check-out. Stored rather than derived
  /// on read so a month's report is one query and not one subtraction per row.
  workHours     Decimal?         @map("work_hours") @db.Decimal(6, 2)
  /// Hours the roster asked for that day — what `workHours` is short OF.
  expectedHours Decimal?         @map("expected_hours") @db.Decimal(6, 2)
  status        AttendanceStatus @default(PRESENT)
  source        AttendanceSource @default(ESS)
  isLate        Boolean          @default(false) @map("is_late")
  isEarlyLeave  Boolean          @default(false) @map("is_early_leave")
  /// Minutes past the grace window. Zero for an on-time arrival, so a report can
  /// sum it without a null check.
  lateMinutes   Int              @default(0) @map("late_minutes")
  notes         String?          @db.Text

  // Where the punch happened, when the branch runs a geofence.
  checkInLatitude   Decimal? @map("check_in_latitude") @db.Decimal(10, 7)
  checkInLongitude  Decimal? @map("check_in_longitude") @db.Decimal(10, 7)
  checkOutLatitude  Decimal? @map("check_out_latitude") @db.Decimal(10, 7)
  checkOutLongitude Decimal? @map("check_out_longitude") @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch      Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date, status])
  @@index([branchId, date])
  @@map("attendances")
}

/// "The clock has me at 09:40, I was here at 08:55" — and somebody has to agree.
///
/// Approving one WRITES the requested times onto the Attendance row and stamps
/// it MANUAL, which is why `Attendance.source` exists: a later import must not
/// silently undo a human decision.
model AttendanceCorrection {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String        @map("employee_id") @db.Uuid
  /// Null when the day has no attendance row at all — a missed punch. Approving
  /// such a request CREATES the row.
  attendanceId      String?       @map("attendance_id") @db.Uuid
  date              DateTime      @db.Date
  originalCheckIn   DateTime?     @map("original_check_in") @db.Timestamp(6)
  originalCheckOut  DateTime?     @map("original_check_out") @db.Timestamp(6)
  requestedCheckIn  DateTime?     @map("requested_check_in") @db.Timestamp(6)
  requestedCheckOut DateTime?     @map("requested_check_out") @db.Timestamp(6)
  reason            String        @db.Text
  status            RequestStatus @default(PENDING)
  reviewedById      String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamp(6)
  reviewNote        String?       @map("review_note") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  reviewedBy User?       @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status])
  @@map("attendance_corrections")
}

/// The roster: what a given person was asked to work on a given day.
///
/// Absent means "the branch calendar applies". Present means this one person
/// deviates from it, which is the only reason to store a row at all — a table
/// with one row per employee per day would be headcount × 365 rows a year
/// saying nothing the branch calendar does not already say.
model WorkSchedule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  date          DateTime  @db.Date
  shiftType     ShiftType @default(FULL_DAY) @map("shift_type")
  /// Wall clock in the employee's effective zone — "08:00", not an instant.
  startTime     String?   @map("start_time") @db.VarChar(5)
  endTime       String?   @map("end_time") @db.VarChar(5)
  requiredHours Decimal?  @map("required_hours") @db.Decimal(5, 2)
  isWorkDay     Boolean   @default(true) @map("is_work_day")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("work_schedules")
}

/// A non-working day.
///
/// `branchId` null means company-wide. A branch-specific row on the same date
/// is allowed and wins, which is how a national holiday observed in one country
/// and not another is expressed without a second calendar.
model Holiday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  name        String   @db.VarChar(255)
  date        DateTime @db.Date
  year        Int
  isRecurring Boolean  @default(false) @map("is_recurring")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([year])
  @@index([date])
  @@map("holidays")
}

/// A face template registered for one employee.
///
/// The descriptor is a 128-float embedding, NOT an image: it cannot be turned
/// back into a photograph, which is what makes storing it at all defensible.
/// `quality` is the detector's confidence at enrolment — a low-quality template
/// matches badly, so the screen surfaces it rather than hiding it.
model FaceEnrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  descriptor Float[]
  quality    Float
  imageUrl   String?  @map("image_url") @db.VarChar(512)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("face_enrollments")
}

// =====================================================
// PAYROLL
// =====================================================

model SalaryComponent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String              @unique @db.VarChar(32)
  name           String              @db.VarChar(160)
  type           SalaryComponentType
  /// Whether this component counts toward gratuity / end-of-service accrual.
  isGratuityBase Boolean             @default(false) @map("is_gratuity_base")
  isTaxable      Boolean             @default(true) @map("is_taxable")
  sequence       Int                 @default(100)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  structureLines SalaryStructureLine[]
  payslipLines   PayslipLine[]

  @@map("salary_components")
}

model SalaryStructure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  currency      String   @default("OMR") @db.VarChar(3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    SalaryStructureLine[]

  @@map("salary_structures")
}

model SalaryStructureLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  structureId String  @map("structure_id") @db.Uuid
  componentId String  @map("component_id") @db.Uuid
  amount      Decimal @db.Decimal(18, 3)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([structureId, componentId])
  @@map("salary_structure_lines")
}

model PayrollRun {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Period is stored as its first day, not as "2026-09", so it sorts and
  /// range-queries as a date rather than as a string.
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date
  status      PayrollRunStatus @default(DRAFT)
  currency    String           @default("OMR") @db.VarChar(3)
  totalGross  Decimal          @default(0) @map("total_gross") @db.Decimal(18, 3)
  totalNet    Decimal          @default(0) @map("total_net") @db.Decimal(18, 3)
  approvedAt  DateTime?        @map("approved_at") @db.Timestamp(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  payslips Payslip[]

  @@unique([periodStart, periodEnd])
  @@index([status])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId    String   @map("payroll_run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  grossPay        Decimal  @default(0) @map("gross_pay") @db.Decimal(18, 3)
  totalDeductions Decimal  @default(0) @map("total_deductions") @db.Decimal(18, 3)
  netPay          Decimal  @default(0) @map("net_pay") @db.Decimal(18, 3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines      PayslipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model PayslipLine {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payslipId   String              @map("payslip_id") @db.Uuid
  componentId String?             @map("component_id") @db.Uuid
  /// Denormalised on purpose: a payslip is a legal record of what was paid, so
  /// it must still read correctly after the component behind it is renamed or
  /// retired. Never resolve these labels through the component at display time.
  label       String              @db.VarChar(160)
  type        SalaryComponentType
  amount      Decimal             @db.Decimal(18, 3)
  sequence    Int                 @default(100)

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@map("payslip_lines")
}

// =====================================================
// PLATFORM
// =====================================================

model SystemSetting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text
  /// Set when `value` holds ciphertext rather than plaintext (integration
  /// credentials). Encrypted values are never returned by any API response.
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================
// EMPLOYEE SELF-SERVICE
//
// Ported from the system this platform replaces, so the screens that read them
// port across unchanged. Two adaptations were unavoidable and are the only
// ones: money is Decimal(18, 3) here rather than (12, 2) — the Gulf currencies
// this runs on are thousandths, and a payslip that rounds to hundredths does
// not balance — and relations point at this schema's Employee and User.
// =====================================================

enum ApprovalRequestType {
  LEAVE
  OVERTIME
  TRAINING
}

enum ApproverType {
  SUPERVISOR
  MANAGER
  HR_MANAGER
  ADMIN
}

enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  LOST
  RETIRED
}

/// Admin-editable pick lists. One table rather than a dozen tiny ones, because
/// every one of them is "a label somebody in HR wants to add without a deploy".
enum LibraryType {
  POSITION
  CONTRACT_TYPE
  EMPLOYMENT_TYPE
  WORK_MODE
  LEAVE_TYPE
  DOCUMENT_TYPE
  VISA_TYPE
  ASSET_CATEGORY
  COURSE_CATEGORY
  GRIEVANCE_CATEGORY
}

model LibraryItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryType LibraryType @map("library_type")
  label       String      @db.VarChar(200)
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")

  /// LEAVE_TYPE metadata.
  defaultDays        Int?    @map("default_days")
  isPaid             Boolean @default(true) @map("is_paid")
  requiresNoticeDays Int     @default(0) @map("requires_notice_days")
  affectsBalance     Boolean @default(true) @map("affects_balance")
  genderRestriction  String? @map("gender_restriction") @db.VarChar(10)

  /// EMPLOYMENT_TYPE metadata: the pay basis this type forces on anyone
  /// assigned it. MONTHLY | DAILY | null (the employee's own basis stands).
  payBasis String? @map("pay_basis") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([libraryType, label])
  @@map("library_items")
}

// ── Approval chains ──────────────────────────────────────────────────────────

model ApprovalWorkflow {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType ApprovalRequestType @map("request_type")
  name        String?             @db.VarChar(150)
  mode        ApprovalMode        @default(SEQUENTIAL)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  steps ApprovalStep[]

  @@index([requestType])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId   String       @map("workflow_id") @db.Uuid
  stepOrder    Int          @map("step_order")
  approverType ApproverType @map("approver_type")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
  @@map("approval_steps")
}

/// One row per step per request, created when the request is raised.
///
/// `resolvedApproverId` is SNAPSHOTTED when the step activates, not resolved on
/// read: the person who was the supervisor when the step opened is the person
/// who owes the decision, even if the reporting line moves underneath it.
model RequestApproval {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestType        ApprovalRequestType @map("request_type")
  requestId          String              @map("request_id") @db.Uuid
  stepOrder          Int                 @map("step_order")
  approverType       ApproverType        @map("approver_type")
  resolvedApproverId String?             @map("resolved_approver_id") @db.Uuid
  /// PENDING | ACTIVE | APPROVED | REJECTED | SKIPPED
  status             String              @default("PENDING") @db.VarChar(50)
  comment            String?             @db.Text
  decidedById        String?             @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?           @map("decided_at") @db.Timestamp(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  resolvedApprover User? @relation("RequestApprovalApprover", fields: [resolvedApproverId], references: [id], onDelete: SetNull)
  decidedBy        User? @relation("RequestApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([requestType, requestId])
  @@index([resolvedApproverId])
  @@map("request_approvals")
}

// ── Leave ────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  /// A LEAVE_TYPE library label, copied rather than referenced — a renamed
  /// library entry must not rewrite the history of what was taken.
  leaveType      String    @map("leave_type") @db.VarChar(50)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  totalDays      Int       @map("total_days")
  reason         String    @db.Text
  status         String    @default("PENDING") @db.VarChar(50)
  approverId     String?   @map("approver_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver    User?             @relation("LeaveApprovedBy", fields: [approverId], references: [id], onDelete: SetNull)
  attachments LeaveAttachment[]

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveAttachment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId String    @map("leave_request_id") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(255)
  fileUrl        String    @map("file_url") @db.Text
  fileSize       BigInt?   @map("file_size")
  mimeType       String?   @map("mime_type") @db.VarChar(100)
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  uploader     User?        @relation("LeaveAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([leaveRequestId])
  @@map("leave_attachments")
}

model LeaveBalance {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  year        Int
  annualLeave Int      @default(30) @map("annual_leave")
  sickLeave   Int      @default(30) @map("sick_leave")
  usedAnnual  Int      @default(0) @map("used_annual")
  usedSick    Int      @default(0) @map("used_sick")
  carriedOver Int      @default(0) @map("carried_over")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

/// Per-leave-type entitlement, keyed on the library label.
///
/// Beside `LeaveBalance` rather than replacing it: that model carries the two
/// statutory buckets every employee has, this one carries whatever else the
/// organisation has invented.
model LeaveTypeBalance {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  year         Int
  leaveTypeKey String   @map("leave_type_key") @db.VarChar(100)
  allocated    Int      @default(0)
  used         Int      @default(0)
  carriedOver  Int      @default(0) @map("carried_over")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, leaveTypeKey])
  @@map("leave_type_balances")
}

// ── Overtime ─────────────────────────────────────────────────────────────────

model OvertimePolicy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(150)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  /// The company-wide fallback. At most one should be active.
  isDefault      Boolean  @default(false) @map("is_default")
  /// Middle tier: an EMPLOYMENT_TYPE label. Null = not scoped to one.
  employmentType String?  @map("employment_type") @db.VarChar(100)
  schemaVersion  Int      @default(1) @map("schema_version")
  rules          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employees        Employee[]        @relation("EmployeeOvertimePolicy")
  overtimeRequests OvertimeRequest[]

  @@index([isActive])
  @@index([employmentType])
  @@map("overtime_policies")
}

model OvertimeRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  date            DateTime @db.Date
  startTime       DateTime @map("start_time") @db.Timestamp(6)
  endTime         DateTime @map("end_time") @db.Timestamp(6)
  hours           Decimal  @db.Decimal(5, 2)
  regularHours    Decimal  @default(0) @map("regular_hours") @db.Decimal(5, 2)
  lateHours       Decimal  @default(0) @map("late_hours") @db.Decimal(5, 2)
  doubleHours     Decimal  @default(0) @map("double_hours") @db.Decimal(5, 2)
  /// Double-rate hours worked inside the LATE window. Kept apart from
  /// `doubleHours` because the two are paid at different multipliers; folded
  /// together, the distinction survives only in `otType`, which cannot express
  /// a request that spans both.
  doubleLateHours Decimal  @default(0) @map("double_late_hours") @db.Decimal(5, 2)
  dayType         String   @default("WEEKDAY") @map("day_type") @db.VarChar(20)
  otType          String   @default("REGULAR") @map("ot_type") @db.VarChar(20)

  foodAllowance         Decimal  @default(0) @map("food_allowance") @db.Decimal(18, 3)
  siteAllowance         Decimal  @default(0) @map("site_allowance") @db.Decimal(18, 3)
  siteAllowanceNote     String?  @map("site_allowance_note") @db.Text
  /// NULLABLE on purpose: "the approver did not touch it" and "the approver set
  /// it to zero" are different facts. Null lets the policy compute it; any
  /// value, zero included, wins.
  foodAllowanceOverride Decimal? @map("food_allowance_override") @db.Decimal(18, 3)

  approverNote      String?   @map("approver_note") @db.Text
  editedById        String?   @map("edited_by_id") @db.Uuid
  editedAt          DateTime? @map("edited_at") @db.Timestamp(6)
  /// What the employee actually filed. Written on the FIRST edit only, so a
  /// second approver cannot overwrite the original with an already-edited value.
  originalStartTime DateTime? @map("original_start_time") @db.Timestamp(6)
  originalEndTime   DateTime? @map("original_end_time") @db.Timestamp(6)

  /// The policy that classified these hours, so pay is calculated against the
  /// same rules that were in force when the request was approved.
  overtimePolicyId String?   @map("overtime_policy_id") @db.Uuid
  reason           String    @db.Text
  status           String    @default("PENDING") @db.VarChar(50)
  approverId       String?   @map("approver_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason   String?   @map("rejected_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimePolicy OvertimePolicy? @relation(fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  approver       User?           @relation("OvertimeApprovedBy", fields: [approverId], references: [id], onDelete: SetNull)
  editedBy       User?           @relation("OvertimeRequestEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("overtime_requests")
}

// ── The employee's own records ───────────────────────────────────────────────

model EmployeeDocument {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String  @map("employee_id") @db.Uuid
  documentType String  @map("document_type") @db.VarChar(50)
  fileName     String  @map("file_name") @db.VarChar(255)
  fileUrl      String  @map("file_url") @db.Text
  fileSize     BigInt? @map("file_size")
  mimeType     String? @map("mime_type") @db.VarChar(100)
  description  String? @db.Text

  issueDate         DateTime? @map("issue_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  /// True for letters and certificates the system produced, so the vault can
  /// tell them apart from what the employee uploaded.
  isSystemGenerated Boolean   @default(false) @map("is_system_generated")
  /// Set when the file lives in the private bucket — a salary certificate must
  /// not be readable by link alone.
  privateRef        String?   @map("private_ref") @db.Text

  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploader User?    @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("employee_documents")
}

model LetterTemplate {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SALARY_CERTIFICATE | NOC | EXPERIENCE | EMBASSY | …
  key              String  @db.VarChar(50)
  name             String  @db.VarChar(200)
  locale           String  @default("en") @db.VarChar(5)
  bodyHtml         String  @map("body_html") @db.Text
  /// A salary certificate states someone's pay to a bank, so it needs a
  /// signature step. Low-risk letters can be issued on request.
  requiresApproval Boolean @default(true) @map("requires_approval")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([key, locale])
  @@map("letter_templates")
}

model LetterRequest {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  templateKey String  @map("template_key") @db.VarChar(50)
  locale      String  @default("en") @db.VarChar(5)
  purpose     String? @db.Text
  addressedTo String? @map("addressed_to") @db.VarChar(200)

  status String @default("PENDING") @db.VarChar(20)

  /// Printed on the letter and verifiable without signing in.
  serialNumber String? @unique @map("serial_number") @db.VarChar(50)
  fileRef      String? @map("file_ref") @db.Text
  /// The vault entry this letter was filed as.
  documentId   String? @map("document_id") @db.Uuid

  issuedById     String?   @map("issued_by_id") @db.Uuid
  issuedAt       DateTime? @map("issued_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation("LetterRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy User?    @relation("LetterIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status])
  @@map("letter_requests")
}

// ── Assets ───────────────────────────────────────────────────────────────────

model AssetItem {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetTag     String      @map("asset_tag") @db.VarChar(50)
  /// An ASSET_CATEGORY library label, copied not referenced.
  category     String      @db.VarChar(100)
  name         String      @db.VarChar(200)
  serialNumber String?     @map("serial_number") @db.VarChar(150)
  branchId     String      @map("branch_id") @db.Uuid
  status       AssetStatus @default(AVAILABLE)

  purchaseDate   DateTime? @map("purchase_date") @db.Date
  purchaseCost   Decimal?  @map("purchase_cost") @db.Decimal(18, 3)
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  notes          String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch      Branch            @relation(fields: [branchId], references: [id])
  assignments AssetAssignment[]

  /// Asset numbering belongs to a BRANCH — two sites genuinely both run a
  /// "LAP-001", and a global unique refuses the second one with a conflict
  /// naming a row that branch cannot see.
  @@unique([branchId, assetTag])
  @@index([branchId, status])
  @@index([category])
  @@map("asset_items")
}

model AssetAssignment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId            String    @map("asset_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  assignedAt         DateTime  @map("assigned_at") @db.Date
  assignedById       String    @map("assigned_by_id") @db.Uuid
  conditionOut       String?   @map("condition_out") @db.VarChar(50)
  /// The digital receipt: the employee confirming they took possession.
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.Timestamp(6)
  acknowledgedNote   String?   @map("acknowledged_note") @db.Text
  returnedAt         DateTime? @map("returned_at") @db.Date
  conditionIn        String?   @map("condition_in") @db.VarChar(50)
  returnReceivedById String?   @map("return_received_by_id") @db.Uuid
  notes              String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  asset      AssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("AssetHolder", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("AssetAssignedBy", fields: [assignedById], references: [id])
  returnedTo User?     @relation("AssetReturnReceivedBy", fields: [returnReceivedById], references: [id], onDelete: SetNull)

  /// An OPEN assignment (returnedAt null) is what blocks offboarding.
  @@index([employeeId, returnedAt])
  @@index([assetId])
  @@map("asset_assignments")
}

// ── Training ─────────────────────────────────────────────────────────────────

model Course {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(50)
  title           String   @db.VarChar(200)
  category        String?  @db.VarChar(100)
  provider        String?  @db.VarChar(200)
  description     String?  @db.Text
  durationHours   Decimal? @map("duration_hours") @db.Decimal(6, 2)
  defaultCost     Decimal? @map("default_cost") @db.Decimal(18, 3)
  /// Months a certificate stays valid; null = it never expires.
  certValidMonths Int?     @map("cert_valid_months")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  sessions TrainingSession[]

  @@index([isActive])
  @@map("courses")
}

model TrainingSession {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  /// Null = open to every branch.
  branchId String? @map("branch_id") @db.Uuid

  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  location    String?  @db.VarChar(200)
  trainer     String?  @db.VarChar(200)
  seats       Int?
  costPerSeat Decimal? @map("cost_per_seat") @db.Decimal(18, 3)
  status      String   @default("SCHEDULED") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  nominations TrainingNomination[]

  @@index([startDate])
  @@index([status])
  @@map("training_sessions")
}

model TrainingNomination {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String @map("session_id") @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  nominatedById String @map("nominated_by_id") @db.Uuid

  justification String?  @db.Text
  /// Snapshotted from the session at nomination: an approved cost must not move
  /// when somebody edits the session later.
  cost          Decimal? @db.Decimal(18, 3)

  /// PENDING | APPROVED | REJECTED | CANCELLED | ATTENDED | NO_SHOW
  status         String    @default("PENDING") @db.VarChar(20)
  approverId     String?   @map("approver_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text

  attendedAt        DateTime? @map("attended_at") @db.Date
  score             Decimal?  @db.Decimal(6, 2)
  passed            Boolean?
  certificateUrl    String?   @map("certificate_url") @db.Text
  certificateExpiry DateTime? @map("certificate_expiry") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee    Employee        @relation("TrainingNominee", fields: [employeeId], references: [id], onDelete: Cascade)
  nominatedBy User            @relation("TrainingNominatedBy", fields: [nominatedById], references: [id])
  approver    User?           @relation("TrainingApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([sessionId, employeeId])
  @@index([employeeId, status])
  @@index([certificateExpiry])
  @@map("training_nominations")
}

// ── Grievances ───────────────────────────────────────────────────────────────

model Grievance {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  category    String @db.VarChar(100)
  subject     String @db.VarChar(200)
  description String @db.Text

  /// Narrows visibility to ADMIN, HR, the complainant and the handler.
  isConfidential    Boolean @default(false) @map("is_confidential")
  /// Who it is about, when it is about a person — so the subject and their
  /// management line can be excluded from ever seeing it.
  againstEmployeeId String? @map("against_employee_id") @db.Uuid

  /// OPEN | ACKNOWLEDGED | INVESTIGATING | RESOLVED | CLOSED | WITHDRAWN
  status       String    @default("OPEN") @db.VarChar(20)
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  resolution   String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee        Employee         @relation("GrievanceRaisedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  againstEmployee Employee?        @relation("GrievanceAgainst", fields: [againstEmployeeId], references: [id], onDelete: SetNull)
  assignedTo      User?            @relation("GrievanceHandler", fields: [assignedToId], references: [id], onDelete: SetNull)
  events          GrievanceEvent[]

  @@index([employeeId, status])
  @@index([assignedToId, status])
  @@index([status])
  @@map("grievances")
}

model GrievanceEvent {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grievanceId String  @map("grievance_id") @db.Uuid
  /// STATUS_CHANGE | NOTE | ASSIGNED
  type        String  @db.VarChar(30)
  fromStatus  String? @map("from_status") @db.VarChar(20)
  toStatus    String? @map("to_status") @db.VarChar(20)
  note        String? @db.Text
  /// Internal notes are never shown to the complainant.
  isInternal  Boolean @default(false) @map("is_internal")
  actorUserId String? @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("GrievanceEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([grievanceId, createdAt])
  @@map("grievance_events")
}

/// One row per employee per accrual period.
///
/// This exists to make the monthly accrual IDEMPOTENT. Without it the job has
/// no way to tell a fresh month from a restart, and a container that bounces
/// twice on the 1st credits everyone twice — an error nobody notices until
/// somebody takes leave they were never entitled to.
model LeaveAccrualHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// The period credited, as its first day — so it sorts and range-queries as a
  /// date rather than as the string "2026-09".
  periodStart  DateTime @map("period_start") @db.Date
  leaveTypeKey String   @map("leave_type_key") @db.VarChar(100)
  /// Days credited. Fractional: a 2.5-day monthly accrual is common.
  days         Decimal  @db.Decimal(6, 2)
  /// The balance year the credit landed on, so a reversal can find it.
  year         Int
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The guard itself: one credit per employee, per period, per leave type.
  @@unique([employeeId, periodStart, leaveTypeKey])
  @@index([employeeId, year])
  @@map("leave_accrual_history")
}
