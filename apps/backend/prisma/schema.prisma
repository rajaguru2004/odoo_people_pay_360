  tags           String[]
  isArchived     Boolean      @default(false) @map("is_archived")
  isPrivate      Boolean      @default(false) @map("is_private")
  locationName   String?      @map("location_name") @db.VarChar(500)
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamp(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Project Management (nullable = legacy standalone task; set = workflow-driven project task)
  projectId    String?  @map("project_id") @db.Uuid
  statusId     String?  @map("status_id") @db.Uuid
  sprintId     String?  @map("sprint_id") @db.Uuid
  parentTaskId String?  @map("parent_task_id") @db.Uuid
  type         TaskType @default(TASK)
  storyPoints  Int?     @map("story_points")

  assignees   Employee[]       @relation("TaskAssignees")
  reporter    Employee?        @relation("ReportedTasks", fields: [reporterId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
  attachments TaskAttachment[]
  activities  TaskActivity[]
  workLogs    WorkLog[]
  timesheets  Timesheet[]

  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workflowStatus ProjectTaskStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  sprint         Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parentTask     Task?              @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks     Task[]             @relation("TaskHierarchy")
