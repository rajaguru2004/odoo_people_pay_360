  dependsOn      TaskDependency[]   @relation("DependentTask")

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isArchived])
  @@index([isPrivate])
  @@index([deletedAt])
  @@index([projectId])
  @@index([statusId])
  @@index([sprintId])
  @@index([parentTaskId])
  @@map("tasks")
}

