// =====================================================
// WORK CALENDAR & SCHEDULE
// =====================================================

enum ShiftType {
  MORNING // 8:00 - 12:00
  AFTERNOON // 13:00 - 17:00
  FULL_DAY // 8:00 - 17:00
  NIGHT // 18:00 - 22:00
  CUSTOM
  FLEXIBLE // no fixed window; employee works `requiredHours` across any sessions
}

// Work Schedule for Personal Calendar
model WorkSchedule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  date           DateTime  @db.Date
  shiftType      ShiftType @default(FULL_DAY) @map("shift_type")
  startTime      DateTime? @map("start_time") @db.Timestamp(6)
  endTime        DateTime? @map("end_time") @db.Timestamp(6)
  requiredHours  Decimal?  @map("required_hours") @db.Decimal(5, 2)
  isWorkDay      Boolean   @default(true) @map("is_work_day")
  notes          String?   @db.Text
  priorEmailSent Boolean   @default(false) @map("prior_email_sent")
  postEmailSent  Boolean   @default(false) @map("post_email_sent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation("EmployeeWorkSchedules", fields: [employeeId], references: [id], onDelete: Cascade)

  // NOTE: the uniqueness rule for this table is NOT expressible here.
  //
  // `hasScheduleConflict` followed by `create` is a check-then-act race with no
  // transaction around it, so a constraint is needed — but the rule is "no two
  // schedules for one employee on one date whose WINDOWS overlap", not "one row
  // per employee-day". A split day (a morning shift and an evening shift with a
  // gap, or two shifts that merely touch) is legitimate, which is exactly why
  // the overlap comparison is half-open.
  //
  // So the constraint is a `NULLS NOT DISTINCT` unique index on
  // (employee_id, date, start_time), which Prisma cannot express. It lives in
  // `migrations/20260816040000_work_schedule_unique_employee_date` and, because
  // `db push` would prune it, is repeated in `prisma/e2e-partial-indexes.sql`.
  @@index([employeeId, date])
  @@map("work_schedules")
}

// =====================================================
// COMPANY KNOWLEDGE BASE (for RAG Chatbot)
// =====================================================

model CompanyKnowledge {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  content   String                      @db.Text
  category  String
  tags      String[]
  embedding Unsupported("vector(384)")?
  metadata  Json?
  isActive  Boolean                     @default(true) @map("is_active")
  createdBy String                      @map("created_by") @db.Uuid
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  creator User @relation("UserKnowledge", fields: [createdBy], references: [id])

  @@index([category])
  @@index([isActive])
  @@index([createdAt])
  @@map("company_knowledge")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(255)
  message   String    @db.Text
  type      String    @default("INFO") @db.VarChar(50)
  link      String?   @db.VarChar(500)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// =====================================================
// TRAVEL MANAGEMENT
//
// An EXTENSION of the reimbursement feature, not a parallel expense system.
// A TravelRequest owns the trip and its multi-level approval; every currency
// amount it produces becomes a `Reimbursement` row tagged sourceType='TRAVEL',
// so payroll pays it out through the path that already exists.
// =====================================================

model TravelRequest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  purpose       String   @db.Text
  // DOMESTIC | INTERNATIONAL — INTERNATIONAL triggers the visa check.
  travelType    String   @map("travel_type") @db.VarChar(20)
  // PER_DIEM_DESTINATION library label.
  destination   String   @db.VarChar(200)
  country       String?  @db.VarChar(100)
  departureDate DateTime @map("departure_date") @db.Date
  returnDate    DateTime @map("return_date") @db.Date

  // Snapshotted from the library at submit. LibraryItem.remove() is a hard
  // delete with no referential integrity, so an approved trip must never depend
  // on the rate row still existing — or on it not having been edited since.
  perDiemRate Decimal? @map("per_diem_rate") @db.Decimal(12, 2)
  perDiemDays Int?     @map("per_diem_days")

  estimatedCost Decimal  @map("estimated_cost") @db.Decimal(12, 2)
  // Optional cash advance, recovered through the EXISTING loans ledger.
  advanceAmount Decimal? @map("advance_amount") @db.Decimal(12, 2)
  advanceLoanId String?  @map("advance_loan_id") @db.Uuid

  // PENDING | APPROVED | REJECTED | CANCELLED | COMPLETED
  status          String    @default("PENDING") @db.VarChar(20)
  approverId      String?   @map("approver_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamp(6)
  approverRemarks String?   @map("approver_remarks") @db.Text
  rejectedReason  String?   @map("rejected_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee            @relation("TravelRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver    User?               @relation("TravelApprover", fields: [approverId], references: [id], onDelete: SetNull)
  advanceLoan AdvanceLoanRequest? @relation("TravelAdvance", fields: [advanceLoanId], references: [id], onDelete: SetNull)
  itinerary   TravelItinerary[]

  @@index([employeeId, status])
  @@index([departureDate, returnDate])
  @@index([status])
  @@map("travel_requests")
}

model TravelItinerary {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  travelId  String    @map("travel_id") @db.Uuid
  legOrder  Int       @map("leg_order")
  // FLIGHT | TRAIN | ROAD | HOTEL | OTHER
  mode      String    @db.VarChar(30)
  fromPlace String?   @map("from_place") @db.VarChar(200)
  toPlace   String?   @map("to_place") @db.VarChar(200)
  startAt   DateTime  @map("start_at") @db.Timestamp(6)
  endAt     DateTime? @map("end_at") @db.Timestamp(6)
  reference String?   @db.VarChar(150)
  notes     String?   @db.Text

  travel TravelRequest @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@unique([travelId, legOrder])
  @@map("travel_itineraries")
}

// =====================================================
// SELF-SERVICE LETTERS
//
// Salary certificate, NOC, experience letter, embassy letter. Templates are DB
// rows rather than filesystem .hbs: HR must be able to reword a letter without a
// redeploy, and every letter needs an Arabic variant (the `locale` column).
// =====================================================

model LetterTemplate {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // SALARY_CERTIFICATE | NOC | EXPERIENCE | EMBASSY | ...
  key              String  @db.VarChar(50)
  name             String  @db.VarChar(200)
  locale           String  @default("en") @db.VarChar(5)
  /// Handlebars source, rendered to PDF through PdfService.
  bodyHtml         String  @map("body_html") @db.Text
  /// A salary certificate states someone's pay to a bank — it needs an HR
  /// signature step. Low-risk letters can be issued instantly.
  requiresApproval Boolean @default(true) @map("requires_approval")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([key, locale])
  @@map("letter_templates")
}

model LetterRequest {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  templateKey String  @map("template_key") @db.VarChar(50)
  locale      String  @default("en") @db.VarChar(5)
  purpose     String? @db.Text
  addressedTo String? @map("addressed_to") @db.VarChar(200)

  // PENDING | ISSUED | REJECTED
  status String @default("PENDING") @db.VarChar(20)

  /// Printed on the letter and verifiable at /letters/verify/:serial.
  serialNumber String? @unique @map("serial_number") @db.VarChar(50)
  /// `private://...` ref — never a public URL. Salary data must not be readable
  /// by link alone.
  fileRef      String? @map("file_ref") @db.Text
  /// The EmployeeDocument row that puts this letter in the employee's vault.
  documentId   String? @map("document_id") @db.Uuid

  issuedById     String?   @map("issued_by_id") @db.Uuid
  issuedAt       DateTime? @map("issued_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation("LetterRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  issuedBy User?    @relation("LetterIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status])
  @@map("letter_requests")
}

// =====================================================
// GRIEVANCE HANDLING
//
// The complement to the existing Discipline module: warnings flow HR→employee,
// grievances flow employee→HR. Deliberately NOT the approval engine — a
// grievance is a case with an assignee and a status trail, not a chain of
// approvers.
//
// Confidentiality is the part that must be right: a grievance about one's own
// manager must never be visible to that manager, so `isDeptInManagerScope` is
// explicitly NOT the access rule here.
// =====================================================

model Grievance {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  // GRIEVANCE_CATEGORY library label.
  category    String @db.VarChar(100)
  subject     String @db.VarChar(200)
  description String @db.Text

  /// Restricts visibility to ADMIN, HR_MANAGER, the complainant and the handler.
  isConfidential    Boolean @default(false) @map("is_confidential")
  /// Who the grievance is about, when it is about a person. Used to exclude the
  /// subject (and their management line) from ever seeing it.
  againstEmployeeId String? @map("against_employee_id") @db.Uuid

  // OPEN | ACKNOWLEDGED | INVESTIGATING | RESOLVED | CLOSED | WITHDRAWN
  status       String    @default("OPEN") @db.VarChar(20)
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  resolution   String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee        Employee         @relation("GrievanceRaisedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  againstEmployee Employee?        @relation("GrievanceAgainst", fields: [againstEmployeeId], references: [id], onDelete: SetNull)
  assignedTo      User?            @relation("GrievanceHandler", fields: [assignedToId], references: [id], onDelete: SetNull)
  events          GrievanceEvent[]

  @@index([employeeId, status])
  @@index([assignedToId, status])
  @@index([status])
  @@map("grievances")
}

/// Append-only trail — status changes and handler notes. The thing the
/// Discipline model lacks, and the reason a grievance can be audited later.
model GrievanceEvent {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grievanceId String  @map("grievance_id") @db.Uuid
  // STATUS_CHANGE | NOTE | ASSIGNED
  type        String  @db.VarChar(30)
  fromStatus  String? @map("from_status") @db.VarChar(20)
  toStatus    String? @map("to_status") @db.VarChar(20)
  note        String? @db.Text
  /// Internal notes are never shown to the complainant.
  isInternal  Boolean @default(false) @map("is_internal")
  actorUserId String? @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("GrievanceEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([grievanceId, createdAt])
  @@map("grievance_events")
}

// =====================================================
// HR BUDGETING
//
// The valuable idea is COMMITMENT: when a travel or training request is
// approved, that money is committed before it is spent, so Remaining is honest
// rather than lagging.
//
//   Remaining = Planned − (open commitments) − Actual
//
// A commitment becomes REALIZED (not released) the moment its spend shows up in
// actuals. That transition is the entire double-counting guard: an approved trip
// commits 500, spawns a per-diem reimbursement, and that reimbursement lands in
// a locked payroll — without the transition the same 500 would be subtracted
// twice.
//
// Actuals are NOT stored here. They are read from payroll/reimbursement rows,
// which are already the single source of truth; a second copy could only drift.
// =====================================================

model Budget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(200)
  fiscalYear Int      @map("fiscal_year")
  // Fiscal, not calendar — an Omani fiscal year need not start in January.
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  branchId   String   @map("branch_id") @db.Uuid
  // One budget = one currency. Amounts are never summed across currencies.
  currency   String   @default("OMR") @db.VarChar(3)
  // DRAFT | ACTIVE | CLOSED
  status     String   @default("DRAFT") @db.VarChar(20)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch    Branch       @relation(fields: [branchId], references: [id])
  createdBy User         @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  lines     BudgetLine[]

  @@unique([branchId, fiscalYear, name])
  @@index([branchId, status])
  @@map("budgets")
}

model BudgetLine {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetId      String  @map("budget_id") @db.Uuid
  // null = a company-wide line, used as the fallback when no department line
  // matches. Without it, spend by an employee in an unbudgeted department would
  // have nowhere to attach.
  departmentId  String? @map("department_id") @db.Uuid
  // BUDGET_CATEGORY library label: Payroll | Overtime | Travel | Training | ...
  category      String  @db.VarChar(100)
  plannedAmount Decimal @map("planned_amount") @db.Decimal(15, 2)
  notes         String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  commitments BudgetCommitment[]

  @@unique([budgetId, departmentId, category])
  @@index([budgetId])
  @@map("budget_lines")
}

/// Append-only-ish ledger: one row per committing request, status transitions
/// rather than deletes, so the history of a budget's consumption survives.
model BudgetCommitment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetLineId String @map("budget_line_id") @db.Uuid
  // TRAVEL | TRAINING | OVERTIME
  sourceType   String @map("source_type") @db.VarChar(30)
  sourceId     String @map("source_id") @db.Uuid

  amount Decimal @db.Decimal(15, 2)
  // OPEN     — approved, not yet spent; counts against Remaining
  // RELEASED — rejected/cancelled; counts against nothing
  // REALIZED — the spend has landed in actuals; stops counting as committed so
  //            the same money is not subtracted twice
  status String  @default("OPEN") @db.VarChar(20)

  committedAt  DateTime  @default(now()) @map("committed_at") @db.Timestamp(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedNote String?   @map("resolved_note") @db.Text

  line BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  // Idempotency: replaying an approval must update the existing commitment, not
  // add a second one.
  @@unique([sourceType, sourceId])
  @@index([budgetLineId, status])
  @@map("budget_commitments")
}

// =====================================================
// TRAINING MANAGEMENT
//
// Same shape as travel, and the same rule: a nomination owns the *request* and
// its approval; the money becomes `Reimbursement` rows tagged
// sourceType='TRAINING'. No training-expense table.
//
// The differentiator is `TrainingNomination.source = 'APPRAISAL'` +
// `appraisalResultId` — needs derived from the AI appraisal engine's
// `improvementsJson` / `recommendation`, with the provenance kept.
// =====================================================

model Course {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique @db.VarChar(50)
  title           String   @db.VarChar(200)
  // COURSE_CATEGORY library label.
  category        String?  @db.VarChar(100)
  provider        String?  @db.VarChar(200)
  description     String?  @db.Text
  durationHours   Decimal? @map("duration_hours") @db.Decimal(6, 2)
  defaultCost     Decimal? @map("default_cost") @db.Decimal(12, 2)
  // Months a certificate from this course stays valid. Drives the expiry
  // reminder registration; null = the certificate never expires.
  certValidMonths Int?     @map("cert_valid_months")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  sessions TrainingSession[]

  @@index([isActive])
  @@map("courses")
}

model TrainingSession {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  // null = open to every branch.
  branchId String? @map("branch_id") @db.Uuid

  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  location    String?  @db.VarChar(200)
  trainer     String?  @db.VarChar(200)
  seats       Int?
  costPerSeat Decimal? @map("cost_per_seat") @db.Decimal(12, 2)
  // SCHEDULED | RUNNING | COMPLETED | CANCELLED
  status      String   @default("SCHEDULED") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  nominations TrainingNomination[]

  @@index([startDate])
  @@index([status])
  @@map("training_sessions")
}

model TrainingNomination {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String @map("session_id") @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  nominatedById String @map("nominated_by_id") @db.Uuid

  // MANUAL | APPRAISAL — provenance for the appraisal-derived differentiator.
  source            String  @default("MANUAL") @db.VarChar(20)
  appraisalResultId String? @map("appraisal_result_id") @db.Uuid
  justification     String? @db.Text

  // Snapshot of TrainingSession.costPerSeat at nomination, for the same reason
  // travel snapshots its per-diem: an approved cost must not move later.
  cost Decimal? @db.Decimal(12, 2)

  // PENDING | APPROVED | REJECTED | CANCELLED | ATTENDED | NO_SHOW
  status         String    @default("PENDING") @db.VarChar(20)
  approverId     String?   @map("approver_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text

  attendedAt        DateTime? @map("attended_at") @db.Date
  score             Decimal?  @db.Decimal(6, 2)
  passed            Boolean?
  certificateUrl    String?   @map("certificate_url") @db.Text
  certificateExpiry DateTime? @map("certificate_expiry") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  session     TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee    Employee         @relation("TrainingNominee", fields: [employeeId], references: [id], onDelete: Cascade)
  nominatedBy User             @relation("TrainingNominatedBy", fields: [nominatedById], references: [id])
  approver    User?            @relation("TrainingApprover", fields: [approverId], references: [id], onDelete: SetNull)
  appraisal   AppraisalResult? @relation(fields: [appraisalResultId], references: [id], onDelete: SetNull)

  // One nomination per employee per session.
  @@unique([sessionId, employeeId])
  @@index([employeeId, status])
  @@index([certificateExpiry])
  @@map("training_nominations")
}

// =====================================================
// ASSET MANAGEMENT
// The HR half only: who holds what, and can they leave without returning it.
// Depreciation and disposal accounting are deliberately out of scope — that
// belongs in an accounting system.
// =====================================================

/// The five states an item in the register can be in. A real PG enum, not a
/// VarChar policed by `@IsIn` in the DTO (finding R15): the DTO only ever saw
/// the HTTP door, so a seed, a backfill, an MCP tool or a future service could
/// write anything under 20 characters, and the API then served it back, counted
/// it in `/assets/summary` byStatus, and made it UNREACHABLE through `?status=`
/// — the filter rejects the very value the row holds. The database now owns the
/// rule, so every writer obeys it.
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  LOST
  RETIRED
}

model AssetItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique PER BRANCH — see `@@unique([branchId, assetTag])` below.
  assetTag     String  @map("asset_tag") @db.VarChar(50)
  // LibraryItem ASSET_CATEGORY label (copied, not FK'd — the house pattern).
  category     String  @db.VarChar(100)
  name         String  @db.VarChar(200)
  serialNumber String? @map("serial_number") @db.VarChar(150)
  branchId     String  @map("branch_id") @db.Uuid

  status AssetStatus @default(AVAILABLE)

  purchaseDate   DateTime? @map("purchase_date") @db.Date
  purchaseCost   Decimal?  @map("purchase_cost") @db.Decimal(12, 2)
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  notes          String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch      Branch            @relation(fields: [branchId], references: [id])
  assignments AssetAssignment[]

  /// Asset numbering is a BRANCH's own scheme — two sites genuinely both run a
  /// "LAP-001" (finding R2). While this was globally `@unique`, the second
  /// branch to try was refused with a 409 naming a row the branch middleware
  /// hides from them: an error a branch-scoped HR can neither act on nor even
  /// see, because the search the message invites returns nothing.
  @@unique([branchId, assetTag])
  @@index([branchId, status])
  @@index([warrantyExpiry])
  @@index([category])
  @@map("asset_items")
}

/// One custody period. Open (returnedAt = null) means the employee still holds
/// it, which is what offboarding clearance checks. Rows are never updated in
/// place on re-assignment — a new row is written, so history is complete.
model AssetAssignment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId            String    @map("asset_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  assignedAt         DateTime  @map("assigned_at") @db.Date
  assignedById       String    @map("assigned_by_id") @db.Uuid
  conditionOut       String?   @map("condition_out") @db.VarChar(50)
  // Digital receipt: the employee confirming they took possession.
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.Timestamp(6)
  acknowledgedNote   String?   @map("acknowledged_note") @db.Text
  returnedAt         DateTime? @map("returned_at") @db.Date
  conditionIn        String?   @map("condition_in") @db.VarChar(50)
  returnReceivedById String?   @map("return_received_by_id") @db.Uuid
  notes              String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  asset      AssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("AssetHolder", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("AssetAssignedBy", fields: [assignedById], references: [id])
  returnedTo User?     @relation("AssetReturnReceivedBy", fields: [returnReceivedById], references: [id], onDelete: SetNull)

  @@index([employeeId, returnedAt])
  @@index([assetId])
  @@map("asset_assignments")
}

// =====================================================
// EXPIRY REMINDERS
// Tiered reminder dispatch log driving the single expiry-reminder cron.
// Replaces the per-entity `expiry_alert_sent_at` stamp, which allowed exactly
// one alert per record, ever.
// =====================================================

model ReminderDispatch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ReminderSource.key, e.g. 'legal_document' | 'contract' | 'asset_warranty'.
  sourceKey  String   @map("source_key") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  // Days-before-expiry tier that fired, e.g. 90 | 60 | 30 | 7.
  threshold  Int
  // Part of the identity on purpose: renewing a record moves its expiry, which
  // legitimately re-arms every tier without deleting a single history row.
  expiryDate DateTime @map("expiry_date") @db.Date
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamp(6)

  @@unique([sourceKey, entityId, threshold, expiryDate])
  @@index([sourceKey, sentAt])
  @@map("reminder_dispatches")
}

// =====================================================
// WHATSAPP NOTIFICATIONS (Evolution API)
//
// Neither table is registered in common/branch/branch-scope.map.ts. That is
// deliberate: Phase 2 resolves an identity from a @Public() webhook where
// getBranchContext() is null, and a scoped model would then be filtered
// non-deterministically the moment a context did exist. Same choice as
// CopilotConversation. Branch isolation for the admin views is enforced
// explicitly against the denormalised branch_id column instead.
// =====================================================

/// Delivery identity + consent for one WhatsApp number.
///
/// Deliberately NOT columns on Employee: `Employee.phone` is a free-text HR
/// field (dashes, spaces, inconsistent country prefixes) that is searchable,
/// counted in profile completion, and present in the bulk-import template.
/// Delivery needs a normalised, verified, consented number whose provenance is
/// auditable and which does not silently re-point when somebody tidies a profile.
model WhatsAppIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The tee only has Notification.userId, so keying on it avoids a join on
  /// every send. employeeId is denormalised for the admin roster and for
  /// branch-scoped filtering.
  userId     String  @map("user_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid

  /// E.164 with the leading '+'. Max real E.164 is 15 digits, so 16 chars.
  /// Unique from day one so Phase 2's one-phone-one-owner rule needs no
  /// index churn later.
  phoneE164 String  @unique @map("phone_e164") @db.VarChar(20)
  /// '<digits>@s.whatsapp.net' as returned by /chat/whatsappNumbers, cached so a
  /// send never needs a lookup round trip.
  waJid     String? @map("wa_jid") @db.VarChar(60)

  /// EMPLOYEE_PHONE (backfilled) | SELF (employee entered) | ADMIN (HR entered).
  source String @default("EMPLOYEE_PHONE") @db.VarChar(20)

  /// Consent. Default false: nobody is messaged until a human said yes.
  optedIn    Boolean   @default(false) @map("opted_in")
  optedInAt  DateTime? @map("opted_in_at") @db.Timestamp(6)
  optedOutAt DateTime? @map("opted_out_at") @db.Timestamp(6)

  /// Number confirmed to exist on WhatsApp. Distinct from optedIn: a number can
  /// be real and unconsented, or consented and wrong.
  verified      Boolean   @default(false)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamp(6)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamp(6)

  /// Consecutive hard delivery failures. At >= 5 the identity auto-suspends
  /// (verified -> false) so a dead number stops burning outbox attempts.
  failureCount Int     @default(0) @map("failure_count")
  lastError    String? @map("last_error") @db.Text

  // ---------------------------------------------------------------- Phase 2
  // Inbound. An ACTIVE identity means "messages from this number are this
  // user" — the same durable trust model as a registered push device.

  /// Reply address exactly as WhatsApp reports it. May be an @lid privacy id,
  /// which is why it is stored separately from phoneE164 and never conflated:
  /// one is where to reply, the other is who the sender is.
  remoteJid String? @map("remote_jid") @db.VarChar(100)
  /// PENDING (enrolled on the web, handset not confirmed) | ACTIVE | BLOCKED | REVOKED
  status    String  @default("PENDING") @db.VarChar(20)
  /// Free-text label so a user with two handsets can tell them apart.
  label     String? @db.VarChar(60)

  /// bcrypt of a 6-digit PIN. Set ONLY from the authenticated web page —
  /// never accepted over WhatsApp, or the channel could bootstrap its own trust.
  pinHash        String?   @map("pin_hash") @db.VarChar(255)
  pinSetAt       DateTime? @map("pin_set_at") @db.Timestamp(6)
  failedPinCount Int       @default(0) @map("failed_pin_count")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamp(6)

  /// The handset replied START, proving the WhatsApp account is live and consenting.
  handsetOptInAt DateTime? @map("handset_opt_in_at") @db.Timestamp(6)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamp(6)

  /// Persisted daily budget, so a restart cannot reset an abuser's allowance.
  dailyMsgCount Int       @default(0) @map("daily_msg_count")
  dailyMsgDate  DateTime? @map("daily_msg_date") @db.Date

  createdById String?   @map("created_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user     User              @relation("UserWhatsAppIdentities", fields: [userId], references: [id], onDelete: Cascade)
  sessions WhatsAppSession[]

  @@index([userId])
  @@index([employeeId])
  @@index([optedIn, verified])
  @@index([branchId])
  @@index([status])
  @@map("whatsapp_identities")
}

// =====================================================
// WHATSAPP INBOUND (Phase 2)
//
// None of these tables is in BRANCH_SCOPE either, and for a sharper reason than
// the Phase 1 pair: identity and session rows are read from a @Public() webhook
// where getBranchContext() is null, BEFORE any principal exists. Scoping them
// would make identity resolution succeed or fail depending on whatever context
// happened to be set, which is the worst possible failure mode for an auth
// lookup. Branch scope is applied where it belongs — inside the tool executor,
// once the principal has been built.
// =====================================================

/// A one-time code proving the employee controls the handset they entered.
model WhatsAppEnrollment {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  phoneE164 String @map("phone_e164") @db.VarChar(20)

  /// bcrypt. The code itself is never stored or recoverable.
  codeHash    String    @map("code_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at") @db.Timestamp(6)
  /// The web request's IP. Inet is valid here — unlike audit_logs, this is
  /// genuinely an IP address and never a phone number.
  createdIp   String?   @map("created_ip") @db.Inet

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([phoneE164, createdAt(sort: Desc)])
  @@map("whatsapp_enrollments")
}

/// Conversation state for one chat. Deliberately NOT authentication: an idle
/// session clears the in-progress flow, never the identity behind it.
model WhatsAppSession {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instance   String  @db.VarChar(100)
  remoteJid  String  @map("remote_jid") @db.VarChar(100)
  identityId String? @map("identity_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid

  /// In-progress multi-step flow (e.g. applying for leave).
  flowKey       String?   @map("flow_key") @db.VarChar(80)
  flowStep      Int?      @map("flow_step")
  slotsJson     Json?     @map("slots_json")
  flowExpiresAt DateTime? @map("flow_expires_at") @db.Timestamp(6)
  flowErrors    Int       @default(0) @map("flow_errors")

  /// The last numbered menu rendered, so a bare "3" can be resolved. Without
  /// this a numeric reply is a guess, and guessing can fire a mutation.
  lastMenuJson Json?     @map("last_menu_json")
  lastMenuAt   DateTime? @map("last_menu_at") @db.Timestamp(6)

  /// Step-up for the sensitive class (payslips, loan balances).
  pinVerifiedAt DateTime? @map("pin_verified_at") @db.Timestamp(6)

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamp(6)
  /// Consecutive messages we could not route. Reset by any resolved action or
  /// control verb, so it measures a RUN of confusion rather than a lifetime
  /// total — which is what decides when to stop repeating the same guesses.
  unknownStreak Int       @default(0) @map("unknown_streak")
  /// Optimistic concurrency: two messages arriving at once must not interleave
  /// halfway through a flow.
  version       Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  identity WhatsAppIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([instance, remoteJid])
  @@index([flowExpiresAt])
  @@index([userId])
  @@map("whatsapp_sessions")
}

/// Every inbound message. The first write IS the duplicate-delivery claim, and
/// the row is also the retry record — there is no broker to hold either.
model WhatsAppInboundMessage {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instance    String @db.VarChar(100)
  waMessageId String @map("wa_message_id") @db.VarChar(120)
  remoteJid   String @map("remote_jid") @db.VarChar(100)

  phoneE164 String? @map("phone_e164") @db.VarChar(20)
  pushName  String? @map("push_name") @db.VarChar(120)

  sessionId  String? @map("session_id") @db.Uuid
  identityId String? @map("identity_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid

  /// text | callback | location | unsupported
  inputKind         String  @map("input_kind") @db.VarChar(20)
  body              String? @db.Text
  callbackId        String? @map("callback_id") @db.VarChar(220)
  resolvedActionKey String? @map("resolved_action_key") @db.VarChar(80)

  /// RECEIVED | PROCESSING | DONE | FAILED | IGNORED
  status      String    @default("RECEIVED") @db.VarChar(20)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamp(6)

  /// Raw envelope with `apikey`, `server_url` and any base64 media stripped —
  /// the webhook body carries the instance credential.
  rawJson Json? @map("raw_json")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamp(6)
  processedAt DateTime? @map("processed_at") @db.Timestamp(6)

  @@unique([instance, waMessageId])
  @@index([status, nextRetryAt])
  @@index([userId, receivedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
  @@map("whatsapp_inbound_messages")
}

/// A write awaiting the user's "yes".
///
/// The arguments live here, server-side, and are never re-read from the reply:
/// a WhatsApp message is attacker-controllable text, so the only safe thing to
/// take from it is the fact that the user said yes.
model WhatsAppPendingAction {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String @map("session_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  identityId String @map("identity_id") @db.Uuid

  actionKey   String @map("action_key") @db.VarChar(80)
  toolName    String @map("tool_name") @db.VarChar(150)
  argsJson    Json   @map("args_json")
  previewJson Json?  @map("preview_json")

  /// PENDING | CONFIRMED | REJECTED | EXPIRED
  status     String    @default("PENDING") @db.VarChar(20)
  resultJson Json?     @map("result_json")
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@map("whatsapp_pending_actions")
}

/// Single-use capability for an approve/reject tapped from a notification.
///
/// Bound to BOTH the handset identity and the approver: a message forwarded to
/// another enrolled colleague fails even though the token string is intact.
/// Only the SHA-256 is stored, so the DB cannot leak a usable token.
model WhatsAppActionToken {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String @unique @map("token_hash") @db.VarChar(64)
  identityId String @map("identity_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  actionKey    String @map("action_key") @db.VarChar(80)
  toolName     String @map("tool_name") @db.VarChar(150)
  argsJson     Json   @map("args_json")
  resourceType String @map("resource_type") @db.VarChar(100)
  resourceId   String @map("resource_id") @db.Uuid

  /// PENDING | CONSUMED | EXPIRED | REVOKED
  status              String    @default("PENDING") @db.VarChar(20)
  expiresAt           DateTime  @map("expires_at") @db.Timestamp(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamp(6)
  consumedByMessageId String?   @map("consumed_by_message_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, resourceType, resourceId, status])
  @@index([status, expiresAt])
  @@map("whatsapp_action_tokens")
}

/// Durable outbound queue.
///
/// There is no queue infrastructure in this repo (no redis, no bullmq, no
/// event-emitter) and adding one for notifications is not proportionate. This
/// table IS the queue: a row is the claim, the payload and the delivery record.
/// The body is rendered at enqueue time so the drainer needs no domain context
/// and so what was sent stays provable after the source row changes — the same
/// reasoning as ReminderDispatch recording the decision rather than re-deriving it.
model WhatsAppMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Caller-supplied stable identity. Enqueue is createMany(skipDuplicates), so a
  /// replayed cron or a double-submit can never double-message a human.
  /// e.g. 'reminder:legal_document:<entityId>:30:2026-09-01:<userId>'
  dedupeKey String @unique @map("dedupe_key") @db.VarChar(200)

  /// No FK to users/employees on purpose: the delivery log must survive employee
  /// deletion. A cascade would erase the evidence that a message was sent.
  /// Mirrors how AttendanceSyncRun.triggeredBy is modelled.
  userId     String? @map("user_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  /// Denormalised for the admin log view and for explicit branch filtering.
  branchId   String? @map("branch_id") @db.Uuid

  toPhoneE164      String  @map("to_phone_e164") @db.VarChar(20)
  templateKey      String  @map("template_key") @db.VarChar(60)
  notificationType String? @map("notification_type") @db.VarChar(50)

  /// Fully rendered at enqueue time, immutable thereafter.
  body            String  @db.Text
  /// Tappable affordances, also decided at ENQUEUE time so the drainer needs no
  /// domain context and the offer stays as provable as the body.
  ///
  /// Holds only callback ids, which carry no authority — never a raw token. The
  /// token itself exists exactly once, inside the message that went out.
  interactiveJson Json?   @map("interactive_json")
  /// Phase 2 media support. The drainer resolves the private:// ref at send time
  /// so the outbox row stays small.
  mediaRef        String? @map("media_ref") @db.Text
  mediaMimeType   String? @map("media_mime_type") @db.VarChar(100)
  mediaFileName   String? @map("media_file_name") @db.VarChar(255)

  /// QUEUED | SENDING | SENT | FAILED | SKIPPED
  status            String    @default("QUEUED") @db.VarChar(20)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamp(6)
  lockedAt          DateTime? @map("locked_at") @db.Timestamp(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamp(6)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(120)
  lastError         String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  /// Drives the drainer's claim scan.
  @@index([status, nextAttemptAt])
  @@index([employeeId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("whatsapp_messages")
}

// =====================================================
// DISCORD CHANNEL
//
// Same shape as whatsapp_identities and for the same reasons: an identity row
// is authentication, consent is recorded with timestamps, and the table is
// deliberately absent from BRANCH_SCOPE because it is read from a @Public()
// interactions endpoint before any principal (and therefore any branch
// context) exists.
// =====================================================

/// Maps a Discord account to an ESS user.
model DiscordIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId     String  @map("user_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid

  /// Discord snowflake. Unique: one Discord account is one person, the same
  /// rule the WhatsApp channel applies to a handset.
  discordUserId String  @unique @map("discord_user_id") @db.VarChar(32)
  /// Denormalised for the admin roster; Discord usernames change.
  discordTag    String? @map("discord_tag") @db.VarChar(64)
  /// Cached DM channel id, so a notification need not re-open one every time.
  dmChannelId   String? @map("dm_channel_id") @db.VarChar(32)

  /// PENDING (code issued, not yet redeemed) | ACTIVE | REVOKED
  status String @default("PENDING") @db.VarChar(20)

  /// One-time linking code, hashed. Never stored in the clear.
  linkCodeHash  String?   @map("link_code_hash") @db.VarChar(255)
  linkExpiresAt DateTime? @map("link_expires_at") @db.Timestamp(6)
  linkedAt      DateTime? @map("linked_at") @db.Timestamp(6)

  optedIn    Boolean   @default(true) @map("opted_in")
  optedOutAt DateTime? @map("opted_out_at") @db.Timestamp(6)

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation("UserDiscordIdentities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([employeeId])
  @@index([status])
  @@map("discord_identities")
}

/// Outbound Discord notification log.
///
/// Mirrors whatsapp_messages: the row is the claim, the payload and the
/// delivery record, because this repo still has no queue infrastructure.
model DiscordMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  dedupeKey String @unique @map("dedupe_key") @db.VarChar(200)

  userId        String? @map("user_id") @db.Uuid
  employeeId    String? @map("employee_id") @db.Uuid
  branchId      String? @map("branch_id") @db.Uuid
  discordUserId String  @map("discord_user_id") @db.VarChar(32)

  templateKey      String  @map("template_key") @db.VarChar(60)
  notificationType String? @map("notification_type") @db.VarChar(50)
  body             String  @db.Text

  status            String    @default("QUEUED") @db.VarChar(20)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamp(6)
  lockedAt          DateTime? @map("locked_at") @db.Timestamp(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamp(6)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(64)
  lastError         String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("discord_messages")
}

/// Single-use capability to complete one geofenced check-in from a browser.
///
/// Discord has no location primitive — no attachment, no modal field — so a
/// geofenced branch can never be satisfied inside the chat. The bot hands out a
/// link instead, and this row is what the link carries.
///
/// The same four properties as whatsapp_action_tokens, for the same reasons:
/// only the hash is stored; it is bound to the Discord identity that asked;
/// consumption is an atomic CAS so a double tap checks in once; and the tool
/// name plus its static arguments live here, so the browser supplies nothing
/// but coordinates. A forwarded link is therefore useless to anyone else, and
/// the worst a stolen one can do is check its owner in from the thief's GPS —
/// which is why the TTL is minutes, not hours.
model DiscordActionToken {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String @unique @map("token_hash") @db.VarChar(64)
  identityId String @map("identity_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  /// CHECKIN today; the shape is deliberately not check-in specific.
  purpose   String @default("CHECKIN") @db.VarChar(40)
  actionKey String @map("action_key") @db.VarChar(80)
  toolName  String @map("tool_name") @db.VarChar(150)
  argsJson  Json   @map("args_json")

  /// PENDING | CONSUMED | EXPIRED
  status     String    @default("PENDING") @db.VarChar(20)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, purpose, status])
  @@index([status, expiresAt])
  @@map("discord_action_tokens")
}

/// One-time, single-use capability to complete ONE attendance action from
/// outside the chat — AND the receipt for whatever proof was collected on the
/// way.
///
/// Channel-agnostic successor to DiscordActionToken. The four properties that
/// made that table safe are unchanged: only the SHA-256 is stored, the row is
/// bound to the identity that asked for it, consumption is an atomic CAS, and
/// the tool name plus its arguments live HERE — the browser or the chat can
/// only add a position and a photo, never choose what happens.
///
/// Two are added, because face proof is now in scope. The row names the CHANNEL
/// it was minted for, checked against the actor channel when the proof is
/// spent; and it names the EMPLOYEE, so a proof can never be redeemed for
/// somebody else.
///
/// No foreign keys: `identity_id` points at whatsapp_identities OR
/// discord_identities depending on `channel`, so no single FK is expressible —
/// and like discord_messages this row is evidence, which has to outlive the
/// employee record it describes.
model ChannelVerificationToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// 'whatsapp' | 'discord'. Must equal the actor channel at spend time.
  channel String @db.VarChar(20)

  /// LINK — the token is handed to a browser as a one-time url.
  /// CHAT — the token is never revealed; the row IS a challenge, and the next
  ///        attachment in that conversation answers it.
  deliveryMode String @default("LINK") @map("delivery_mode") @db.VarChar(10)

  identityId String  @map("identity_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  /// Denormalised at issue time. The face proof is bound to THIS employee.
  employeeId String? @map("employee_id") @db.Uuid

  /// CHECKIN | CHECKOUT | LUNCH_IN | LUNCH_OUT
  purpose String @default("CHECKIN") @db.VarChar(20)

  /// What the holder still has to produce. The browser page reads these from
  /// peek() to decide which permissions to ask for.
  requireLocation Boolean @default(false) @map("require_location")
  requireFace     Boolean @default(false) @map("require_face")

  actionKey String @map("action_key") @db.VarChar(80)
  toolName  String @map("tool_name") @db.VarChar(150)
  argsJson  Json   @map("args_json")

  /// PENDING | CONSUMED | EXPIRED
  status String @default("PENDING") @db.VarChar(20)

  /// Bounds face retries. release() is generous by design, so without a cap a
  /// stolen link would be an unlimited face-match oracle for its whole TTL.
  attempts    Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")

  expiresAt  DateTime  @map("expires_at") @db.Timestamp(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(6)

  /// The proof receipt. Written only by the descriptor-matching path.
  faceVerifiedAt DateTime? @map("face_verified_at") @db.Timestamp(6)
  faceDistance   Float?    @map("face_distance")
  faceQuality    Float?    @map("face_quality")
  /// Admin-visible evidence: fraud in an HR context is deterred by being
  /// reviewable after the fact more than by anything checkable in the moment.
  faceImageUrl   String?   @map("face_image_url") @db.Text
  /// Anti-replay. Re-sending the same photo is the cheapest fraud there is,
  /// and the cheapest to catch.
  imageSha256    String?   @map("image_sha256") @db.VarChar(64)
  /// CAS target: a proof is spendable exactly once per claim.
  proofSpentAt   DateTime? @map("proof_spent_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId, purpose, status])
  @@index([channel, identityId, status])
  @@index([status, expiresAt])
  @@index([employeeId, createdAt(sort: Desc)])
  @@map("channel_verification_tokens")
}

// =====================================================
// FACE RECOGNITION FOR ATTENDANCE
// =====================================================

model FaceDescriptor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  descriptor Float[] // 128-dimensional face embedding vector
  imageUrl   String?  @map("image_url") @db.Text
  quality    Float // Detection confidence (0-1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation("EmployeeFaceDescriptors", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([quality])
  @@map("face_descriptors")
}

// =====================================================
// SYSTEM CONFIGURATION SETTINGS
// =====================================================

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("system_settings")
}

// =====================================================
// TASK TRACKER + TIMESHEET MANAGEMENT
// =====================================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  BLOCKED
}

enum TaskActivityType {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  EDITED
  COMPLETED
  COMMENTED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  NOTE_ADDED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ===== Project Management (Work Hive port) =====

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskType {
  TASK
  BUG
  EPIC
  STORY
  SUBTASK
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
  DUPLICATES
}

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskCode       String       @unique @map("task_code") @db.VarChar(20)
  title          String       @db.VarChar(500)
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  reporterId     String?      @map("reporter_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  startDate      DateTime?    @map("start_date") @db.Date
  completedDate  DateTime?    @map("completed_date") @db.Date
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(8, 2)
