model Holiday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  date        DateTime @db.Date
  year        Int
  isRecurring Boolean  @default(false) @map("is_recurring")
  branchId    String?  @map("branch_id") @db.Uuid // null => applies to all branches (company-wide)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Uniqueness is enforced by two partial unique indexes in the migration
  // (one global holiday per date, one holiday per date per branch) — Prisma
  // @@unique cannot express partial indexes.
  @@index([year])
  @@index([branchId])
