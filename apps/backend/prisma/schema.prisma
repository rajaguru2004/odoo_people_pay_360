model Reimbursement {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  type            String    @db.VarChar(100)
  amount          Decimal   @db.Decimal(12, 2)
  expenseDate     DateTime  @map("expense_date") @db.Date
  description     String?   @db.Text
  status          String    @default("PENDING") @db.VarChar(20)
  approverId      String?   @map("approver_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamp(6)
  approverRemarks String?   @map("approver_remarks") @db.Text
  rejectedReason  String?   @map("rejected_reason") @db.Text
  payrollItemId   String?   @map("payroll_item_id") @db.Uuid
  paidAt          DateTime? @map("paid_at") @db.Timestamp(6)

  // Provenance for claims spawned by an approved parent request. Travel and
  // Training do NOT get their own expense tables — a trip or a nomination owns
  // the *request*, and the money lands here so the existing payroll payout path
  // (payrollItemId back-link, APPROVED->PAID at lock) works unchanged.
  // 'TRAVEL' | 'TRAINING'; null for an ordinary standalone claim.
  sourceType     String? @map("source_type") @db.VarChar(30)
  // TravelRequest.id | TrainingNomination.id. Intentionally not an FK: one
  // nullable column cannot reference two tables, and the parent is resolved
  // through the same registry the approval engine uses.
  sourceId       String? @map("source_id") @db.Uuid
  // BUDGET_CATEGORY library label. Set at creation so the variance report can
  // attribute actual spend without re-deriving it from `type`.
  budgetCategory String? @map("budget_category") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver    User?                     @relation("ReimbursementApprover", fields: [approverId], references: [id], onDelete: SetNull)
  payrollItem PayrollItem?              @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  attachments ReimbursementAttachment[]

  @@index([employeeId])
  @@index([status])
  @@index([payrollItemId])
  @@index([sourceType, sourceId])
  @@map("reimbursements")
}

model ReimbursementAttachment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reimbursementId String    @map("reimbursement_id") @db.Uuid
  fileName        String    @map("file_name") @db.VarChar(255)
  fileUrl         String    @map("file_url") @db.Text
  fileSize        BigInt?   @map("file_size")
  mimeType        String?   @map("mime_type") @db.VarChar(100)
  uploadedBy      String?   @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime  @default(now()) @map("uploaded_at") @db.Timestamp(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(6)

  reimbursement Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  uploader      User?         @relation("ReimbursementAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([reimbursementId])
  @@map("reimbursement_attachments")
}

// =====================================================
// SALARY ADVANCE & LOAN MANAGEMENT
// =====================================================

/// Interest model for a loan product. NONE keeps the pre-v2 behaviour.
enum LoanInterestMethod {
  NONE
  FLAT
  REDUCING_BALANCE
}

/// How often an installment falls due. Payroll stays monthly regardless: it
/// collects every schedule row whose dueDate is on or before the period end, so
/// a WEEKLY loan contributes 4-5 rows to one run and a QUARTERLY loan one every
/// third run.
enum LoanDeductionFrequency {
  MONTHLY
  WEEKLY
  QUARTERLY
}

/// Lifecycle of ONE planned installment.
/// SCHEDULED/PARTIAL/PAID are driven by the payroll ledger at LOCK time.
/// DEFERRED/SKIPPED/WAIVED/WRITTEN_OFF/CLOSED_EARLY/CANCELLED are admin acts.
enum LoanScheduleStatus {
  SCHEDULED
  PARTIAL
  PAID
  DEFERRED
  SKIPPED
  WAIVED
  WRITTEN_OFF
  CLOSED_EARLY
  CANCELLED
}

enum LoanTransactionType {
  DISBURSEMENT
  PROCESSING_FEE
  EMI_RECOVERY
  PREPAYMENT
  WAIVER
  WRITE_OFF
  ADJUSTMENT
  SETTLEMENT
  CONVERSION
  TOPUP_SETTLEMENT
  REVERSAL
}

enum LoanTransactionStatus {
  POSTED
  REVERSED
}

enum LoanClosureType {
  AUTO
  MANUAL
  EARLY_CLOSURE
  FORECLOSED
  WRITE_OFF
  WAIVER
  SETTLEMENT
  CONVERTED
  TOPPED_UP
}

enum LoanProcessingFeeMode {
  DEDUCT_FROM_DISBURSEMENT
  ADD_TO_FIRST_EMI
  CAPITALIZE
}

enum LoanGraceMode {
  NONE
  MORATORIUM_FULL
  MORATORIUM_INTEREST_ONLY
}

/// Admin-managed loan product catalogue.
///
/// Deliberately NOT a LibraryItem: LibraryItem carries per-type metadata as
/// bolt-on nullable columns and already strains with one (perDiemRate); a loan
/// product needs ~25 policy fields.
///
/// Its values are SNAPSHOTTED onto the request at creation (the same rule as
/// LibraryItem.perDiemRate -> TravelRequest): editing a product must never
/// change the terms of a loan that is already approved.
model LoanType {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String  @unique @db.VarChar(40) // PERSONAL | SALARY_ADVANCE | VEHICLE | EDUCATION | EMERGENCY
  name      String  @db.VarChar(120)
  /// 'LOAN' | 'ADVANCE' — drives AdvanceLoanRequest.type so both flows stay unified.
  category  String  @default("LOAN") @db.VarChar(20)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  /// null => available in every branch (mirrors Holiday.branchId).
  branchId  String? @map("branch_id") @db.Uuid

  // ── Default terms ────────────────────────────────────────────────────────
  interestMethod         LoanInterestMethod     @default(NONE) @map("interest_method")
  /// Annual nominal rate, percent. 3dp so 8.375% is representable.
  interestRate           Decimal                @default(0) @map("interest_rate") @db.Decimal(6, 3)
  deductionFrequency     LoanDeductionFrequency @default(MONTHLY) @map("deduction_frequency")
  defaultInstallments    Int                    @default(12) @map("default_installments")
  maxInstallments        Int                    @default(24) @map("max_installments")
  processingFeePercent   Decimal                @default(0) @map("processing_fee_percent") @db.Decimal(6, 3)
  processingFeeFlat      Decimal                @default(0) @map("processing_fee_flat") @db.Decimal(12, 2)
  processingFeeMode      LoanProcessingFeeMode  @default(DEDUCT_FROM_DISBURSEMENT) @map("processing_fee_mode")
  /// Share of INTEREST (never principal) borne by the employer. 0-100.
  employerSubsidyPercent Decimal                @default(0) @map("employer_subsidy_percent") @db.Decimal(5, 2)
  gracePeriods           Int                    @default(0) @map("grace_periods")
  graceMode              LoanGraceMode          @default(NONE) @map("grace_mode")

  // ── Eligibility & affordability ──────────────────────────────────────────
  maxAmount               Decimal? @map("max_amount") @db.Decimal(12, 2)
  maxMultipleOfSalary     Decimal? @map("max_multiple_of_salary") @db.Decimal(6, 2)
  minServiceMonths        Int      @default(0) @map("min_service_months")
  maxActiveLoans          Int      @default(1) @map("max_active_loans")
  minNetSalaryAfterEmi    Decimal? @map("min_net_salary_after_emi") @db.Decimal(12, 2)
  maxEmiPercentOfNet      Decimal? @map("max_emi_percent_of_net") @db.Decimal(5, 2)
  minEmiAmount            Decimal? @map("min_emi_amount") @db.Decimal(12, 2)
  requiresSecurity        Boolean  @default(false) @map("requires_security")
  /// Employee has no `grade` column; grade/designation ceilings map to these.
  eligiblePositions       String[] @default([]) @map("eligible_positions")
  eligibleEmploymentTypes String[] @default([]) @map("eligible_employment_types")
  /// Recovery order when several loans compete for a limited net. Lower = first.
  priority                Int      @default(100)
  /// Pause EMI automatically in an unpaid-leave / zero-salary month.
  pauseOnUnpaidLeave      Boolean  @default(true) @map("pause_on_unpaid_leave")
  allowPrepayment         Boolean  @default(true) @map("allow_prepayment")
  allowWriteOff           Boolean  @default(true) @map("allow_write_off")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch   Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requests AdvanceLoanRequest[]

  @@index([isActive, sortOrder])
  @@index([branchId])
  @@map("loan_types")
}

/// Per-branch recovery policy. SystemSetting is key-unique with no branch
/// column and must not gain one — the established per-branch precedent in this
/// codebase is a dedicated table/column (see getGeofencingPolicy reading
/// Branch). Resolution chain:
///   LoanType -> LoanPolicy(branchId) -> LoanPolicy(null) -> SystemSetting -> default
model LoanPolicy {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null = global fallback row.
  branchId String? @unique @map("branch_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  minNetPayAmount               Decimal?            @map("min_net_pay_amount") @db.Decimal(12, 2)
  minNetPayPercent              Decimal?            @map("min_net_pay_percent") @db.Decimal(5, 2)
  maxTotalDeductionPercentOfNet Decimal?            @map("max_total_deduction_percent_of_net") @db.Decimal(5, 2)
  /// PARTIAL | DEFER | SKIP
  shortfallPolicy               String?             @map("shortfall_policy") @db.VarChar(20)
  /// CARRY_FORWARD | EXTEND_TENURE
  deferralMode                  String?             @map("deferral_mode") @db.VarChar(20)
  /// CONTINUE | PAUSE | EXTEND
  unpaidLeavePolicy             String?             @map("unpaid_leave_policy") @db.VarChar(20)
  gracePeriodCycles             Int?                @map("grace_period_cycles")
  maxActivePerEmployee          Int?                @map("max_active_per_employee")
  minServiceMonths              Int?                @map("min_service_months")
  maxAmountMultipleOfSalary     Decimal?            @map("max_amount_multiple_of_salary") @db.Decimal(6, 2)
  interestDefaultMethod         LoanInterestMethod? @map("interest_default_method")
  roundingTolerance             Decimal?            @map("rounding_tolerance") @db.Decimal(12, 2)
  writeOffRoles                 String?             @map("write_off_roles") @db.VarChar(200)
  waiverRoles                   String?             @map("waiver_roles") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("loan_policies")
}

model AdvanceLoanRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  type              String    @db.VarChar(20) // CHECK: 'ADVANCE' | 'LOAN'
  /// ORIGINAL principal. Immutable after disbursement — a change of principal is
  /// a prepayment (down) or a top-up (up), never an edit, or every historical
  /// closingBalance on the schedule becomes a lie.
  amount            Decimal   @db.Decimal(12, 2)
  reason            String?   @db.Text
  /// CHECK-constrained rather than a Prisma enum: converting the column is an
  /// ACCESS EXCLUSIVE rewrite on a table payroll reads, and `prisma migrate dev`
  /// is broken here so there is no shadow-DB rehearsal. See loan.types.ts.
  status            String    @default("PENDING") @db.VarChar(20)
  installments      Int       @default(1) // 1 for advance; set by approver for loan
  installmentAmount Decimal?  @map("installment_amount") @db.Decimal(12, 2)
  /// v2 SEMANTIC: PRINCIPAL repaid, NOT total cash. With interest, cash exceeds
  /// principal, and a cash-based counter would auto-complete loans early. This
  /// keeps `outstanding = amount - amountRepaid` and the existing completion
  /// test correct. Interest and fees have their own counters below.
  amountRepaid      Decimal   @default(0) @map("amount_repaid") @db.Decimal(12, 2)
  approverId        String?   @map("approver_id") @db.Uuid
  approvedAt        DateTime? @map("approved_at") @db.Timestamp(6)
  approverRemarks   String?   @map("approver_remarks") @db.Text
  rejectedReason    String?   @map("rejected_reason") @db.Text
  completedAt       DateTime? @map("completed_at") @db.Timestamp(6)

  // ── v2: product & identity ───────────────────────────────────────────────
  loanTypeId           String? @map("loan_type_id") @db.Uuid
  /// Human reference, e.g. LN-2026-000123. Unique => the doc's "duplicate loan
  /// reference number" case is a DB-level rejection, not an application race.
  /// Nullable and NOT backfilled for legacy rows; minted on first v2 touch.
  referenceNo          String? @unique @map("reference_no") @db.VarChar(40)
  /// Snapshot of payroll_currency at creation: an employee transferring to
  /// another entity must not silently re-denominate an existing loan.
  currency             String  @default("INR") @db.VarChar(3)
  /// Kept for reporting after an employee is archived (loan history must
  /// outlive the person for statutory audit).
  employeeCodeSnapshot String? @map("employee_code_snapshot") @db.VarChar(50)
  employeeNameSnapshot String? @map("employee_name_snapshot") @db.VarChar(200)

  // ── v2: interest terms, snapshotted from LoanType ────────────────────────
  interestMethod         LoanInterestMethod     @default(NONE) @map("interest_method")
  interestRate           Decimal                @default(0) @map("interest_rate") @db.Decimal(6, 3)
  deductionFrequency     LoanDeductionFrequency @default(MONTHLY) @map("deduction_frequency")
  processingFee          Decimal                @default(0) @map("processing_fee") @db.Decimal(12, 2)
  processingFeeMode      LoanProcessingFeeMode  @default(DEDUCT_FROM_DISBURSEMENT) @map("processing_fee_mode")
  employerSubsidyPercent Decimal                @default(0) @map("employer_subsidy_percent") @db.Decimal(5, 2)
  securityDeposit        Decimal                @default(0) @map("security_deposit") @db.Decimal(12, 2)
  gracePeriods           Int                    @default(0) @map("grace_periods")
  graceMode              LoanGraceMode          @default(NONE) @map("grace_mode")

  // ── v2: dates ────────────────────────────────────────────────────────────
  effectiveDate      DateTime? @map("effective_date") @db.Date
  disbursementDate   DateTime? @map("disbursement_date") @db.Date
  /// principal - fee when processingFeeMode = DEDUCT_FROM_DISBURSEMENT.
  disbursedAmount    Decimal?  @map("disbursed_amount") @db.Decimal(12, 2)
  /// Explicit column so grace/holiday shifting stays auditable instead of being
  /// re-derived on every schedule regeneration.
  firstDeductionDate DateTime? @map("first_deduction_date") @db.Date

  // ── v2: recovery control ─────────────────────────────────────────────────
  /// Lower = recovered first when net cannot cover every loan.
  priority   Int       @default(100)
  holdFrom   DateTime? @map("hold_from") @db.Date
  /// Deductions are suppressed while the cycle start is before holdUntil.
  holdUntil  DateTime? @map("hold_until") @db.Date
  holdReason String?   @map("hold_reason") @db.Text

  // ── v2: money counters (denormalised; LoanLedgerService is the ONLY writer) ─
  outstandingPrincipal Decimal? @map("outstanding_principal") @db.Decimal(12, 2)
  outstandingInterest  Decimal  @default(0) @map("outstanding_interest") @db.Decimal(12, 2)
  interestAccrued      Decimal  @default(0) @map("interest_accrued") @db.Decimal(12, 2)
  interestPaid         Decimal  @default(0) @map("interest_paid") @db.Decimal(12, 2)
  feesPaid             Decimal  @default(0) @map("fees_paid") @db.Decimal(12, 2)
  /// Snapshot at approval: principal + employee-borne interest + payable fees.
  totalPayable         Decimal? @map("total_payable") @db.Decimal(12, 2)
  writtenOffAmount     Decimal  @default(0) @map("written_off_amount") @db.Decimal(12, 2)
  waivedAmount         Decimal  @default(0) @map("waived_amount") @db.Decimal(12, 2)

  // ── v2: closure & restructuring ──────────────────────────────────────────
  closureType       LoanClosureType? @map("closure_type")
  closedAt          DateTime?        @map("closed_at") @db.Timestamp(6)
  closureRemarks    String?          @map("closure_remarks") @db.Text
  /// Bumped on every regeneration. Live schedule rows carry this version.
  scheduleVersion   Int              @default(0) @map("schedule_version")
  restructuredAt    DateTime?        @map("restructured_at") @db.Timestamp(6)
  /// Actor columns are plain uuids with no Prisma relation: they are audit
  /// provenance, not referential load-bearing, and a relation each would mean
  /// eight more back-references on User.
  restructuredBy    String?          @map("restructured_by") @db.Uuid
  createdOnBehalfBy String?          @map("created_on_behalf_by") @db.Uuid
  /// How this request was raised: SELF | ON_BEHALF | IMPORT | TRAVEL | CONVERSION | TOPUP
  approvalSource    String           @default("SELF") @map("approval_source") @db.VarChar(20)
  /// FINAL_PAY | GRATUITY | LEAVE_ENCASHMENT | ... set by the settlement flow.
  settlementMode    String?          @map("settlement_mode") @db.VarChar(30)
  convertedFromId   String?          @map("converted_from_id") @db.Uuid
  /// The loan this one topped up and settled. `LoanClosureType.TOPPED_UP` and
  /// `LoanTransactionType.TOPUP_SETTLEMENT` existed for this and had no
  /// producer, because there was no link to record.
  topupOfId         String?          @map("topup_of_id") @db.Uuid

  // ── v2: import (loans arriving with existing repayment history) ──────────
  importBatchId    String?  @map("import_batch_id") @db.Uuid
  openingPrincipal Decimal? @map("opening_principal") @db.Decimal(12, 2)
  openingRepaid    Decimal? @map("opening_repaid") @db.Decimal(12, 2)

  /// Optimistic concurrency for every balance-moving write outside the payroll
  /// transaction (prepay, close, write-off, waive, settle, convert, top-up).
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  /// Restrict, not Cascade: loan history must survive the employee record for
  /// statutory audit. employees.service.ts hardDelete() carries a matching
  /// application-level guard so this surfaces as a readable message, not P2003.
  employee         Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver         User?                        @relation("AdvanceLoanApprover", fields: [approverId], references: [id], onDelete: SetNull)
  loanType         LoanType?                    @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  convertedFrom    AdvanceLoanRequest?          @relation("LoanConversion", fields: [convertedFromId], references: [id], onDelete: SetNull)
  convertedInto    AdvanceLoanRequest[]         @relation("LoanConversion")
  topupOf          AdvanceLoanRequest?          @relation("LoanTopup", fields: [topupOfId], references: [id], onDelete: SetNull)
  toppedUpBy       AdvanceLoanRequest[]         @relation("LoanTopup")
  deductions       AdvanceLoanDeduction[]
  attachments      AdvanceLoanAttachment[]
  schedules        LoanSchedule[]
  transactions     LoanTransaction[]
  rateChanges      LoanRateChange[]
  notificationLogs AdvanceLoanNotificationLog[]
  // Set when this advance was raised by an approved trip.
  travelRequests   TravelRequest[]              @relation("TravelAdvance")

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@index([employeeId, status])
  @@index([employeeId, status, priority])
  @@index([loanTypeId])
  @@map("advance_loan_requests")
}

/// The PLAN: one row per planned installment, with its principal/interest split.
///
/// Written by the amortization engine at approval/disbursement. Payroll
/// GENERATION never writes here — status/paid* are a PROJECTION computed at
/// LOCK time from PAID ledger rows, plus explicit admin acts. That single rule
/// is what makes deleting a draft payroll a no-op for the plan and what stops
/// a re-run from double-charging.
model LoanSchedule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  /// Matches AdvanceLoanRequest.scheduleVersion for LIVE rows. Superseded rows
  /// keep their old version and status=CANCELLED — the audit trail for
  /// "schedule regenerated".
  version       Int      @default(1)
  installmentNo Int      @map("installment_no")
  dueDate       DateTime @map("due_date") @db.Date
  /// dueYear * 12 + dueMonth, denormalised from dueDate so "this cycle OR
  /// earlier" (which is what sweeps arrears forward) is ONE indexed comparison
  /// instead of an OR-of-tuples or per-row date arithmetic across 100k loans.
  dueCycleKey   Int      @map("due_cycle_key")
  dueMonth      Int      @map("due_month")
  dueYear       Int      @map("due_year")

  openingBalance           Decimal @map("opening_balance") @db.Decimal(12, 2)
  principalComponent       Decimal @map("principal_component") @db.Decimal(12, 2)
  interestComponent        Decimal @default(0) @map("interest_component") @db.Decimal(12, 2)
  /// Part of interestComponent the EMPLOYER pays. Never deducted from salary;
  /// carried for the interest-expense journal.
  employerSubsidyComponent Decimal @default(0) @map("employer_subsidy_component") @db.Decimal(12, 2)
  feeComponent             Decimal @default(0) @map("fee_component") @db.Decimal(12, 2)
  /// EMPLOYEE-PAYABLE = principal + (interest - subsidy) + fee. Payroll deducts
  /// THIS, not installmentAmount.
  emiAmount                Decimal @map("emi_amount") @db.Decimal(12, 2)
  closingBalance           Decimal @map("closing_balance") @db.Decimal(12, 2)

  status             LoanScheduleStatus @default(SCHEDULED)
  paidAmount         Decimal            @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paidPrincipal      Decimal            @default(0) @map("paid_principal") @db.Decimal(12, 2)
  paidInterest       Decimal            @default(0) @map("paid_interest") @db.Decimal(12, 2)
  /// Unpaid remainder of a PARTIAL row, swept forward by the dueCycleKey <= rule.
  carryForwardAmount Decimal            @default(0) @map("carry_forward_amount") @db.Decimal(12, 2)
  settledAt          DateTime?          @map("settled_at") @db.Timestamp(6)
  supersededAt       DateTime?          @map("superseded_at") @db.Timestamp(6)
  note               String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  request    AdvanceLoanRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deductions AdvanceLoanDeduction[]

  @@unique([requestId, version, installmentNo])
  @@index([requestId, status])
  @@index([dueCycleKey, status])
  @@index([dueDate, status])
  @@map("loan_schedules")
}

/// The payroll REPAYMENT LEDGER: one row per amount actually taken from one
/// payroll item. A schedule row may have 0..N of these (partial recovery,
/// arrears catch-up).
model AdvanceLoanDeduction {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String  @map("request_id") @db.Uuid
  /// Which planned installment this settles. NULL for legacy rows and for
  /// schedule-less advance recovery. SetNull, not Cascade: cancelling a
  /// superseded schedule row must never destroy a payment record.
  scheduleId    String? @map("schedule_id") @db.Uuid
  payrollItemId String? @map("payroll_item_id") @db.Uuid
  amount        Decimal @db.Decimal(12, 2)

  /// Split of `amount`, waterfall fee -> interest -> principal. A DB CHECK
  /// asserts the three sum to `amount`, so an engine rounding bug fails loudly
  /// at write time instead of silently drifting amountRepaid.
  principalComponent Decimal @default(0) @map("principal_component") @db.Decimal(12, 2)
  interestComponent  Decimal @default(0) @map("interest_component") @db.Decimal(12, 2)
  feeComponent       Decimal @default(0) @map("fee_component") @db.Decimal(12, 2)

  /// What was due vs what was taken — makes "why was nothing recovered in
  /// June?" answerable from the ledger alone.
  plannedAmount   Decimal? @map("planned_amount") @db.Decimal(12, 2)
  shortfallAmount Decimal  @default(0) @map("shortfall_amount") @db.Decimal(12, 2)
  /// FULL | PARTIAL | DEFER | SKIP | HOLD
  outcome         String?  @db.VarChar(20)
  /// AFFORDABLE | INSUFFICIENT_NET | ZERO_NET | UNPAID_LEAVE | ON_HOLD | ...
  reason          String?  @db.VarChar(30)

  month  Int
  year   Int
  /// PENDING (draft payroll) | PAID (locked) | SKIPPED (explanatory zero-amount
  /// row) | REVERSED (payroll unlocked) | VOID. SKIPPED/REVERSED/VOID sit
  /// OUTSIDE the live partial unique index so they never block a genuine later
  /// recovery.
  status String @default("PENDING") @db.VarChar(20)

  /// True when a payroll admin overrode the computed amount; suppresses the
  /// auto-clamp on re-run.
  isManual   Boolean   @default(false) @map("is_manual")
  reversedAt DateTime? @map("reversed_at") @db.Timestamp(6)
  reversedBy String?   @map("reversed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request     AdvanceLoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  schedule    LoanSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: after an unlock the payroll holds REVERSED rows
  /// whose history must survive the run being deleted. payrolls.remove()
  /// explicitly deletes the PENDING rows to keep the re-release behaviour.
  payrollItem PayrollItem?       @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  transaction LoanTransaction?

  @@index([requestId])
  @@index([payrollItemId])
  @@index([status])
  @@index([requestId, status])
  @@index([scheduleId, status])
  @@index([year, month, status])
  @@index([payrollItemId, status])
  @@map("advance_loan_deductions")
}

/// Every money event that is NOT a payroll deduction: disbursement, processing
/// fee, cash prepayment, waiver, write-off, adjustment, settlement recovery,
/// reversal. Both this and AdvanceLoanDeduction are written through the single
/// helper LoanLedgerService so the denormalised counters cannot drift.
model LoanTransaction {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String                @map("request_id") @db.Uuid
  type            LoanTransactionType
  status          LoanTransactionStatus @default(POSTED)
  transactionDate DateTime              @map("transaction_date") @db.Date
  /// Always POSITIVE. Direction is implied by `type`.
  amount          Decimal               @db.Decimal(12, 2)

  principalComponent Decimal  @default(0) @map("principal_component") @db.Decimal(12, 2)
  interestComponent  Decimal  @default(0) @map("interest_component") @db.Decimal(12, 2)
  feeComponent       Decimal  @default(0) @map("fee_component") @db.Decimal(12, 2)
  /// Outstanding principal immediately after this event — makes the employee
  /// statement one ordered scan with no running recomputation.
  balanceAfter       Decimal? @map("balance_after") @db.Decimal(12, 2)

  reference      String? @db.VarChar(120) // cheque / UTR / settlement id
  narration      String? @db.Text
  /// GRATUITY | LEAVE_ENCASHMENT | FINAL_PAY | BANK | CASH ...
  sourceType     String? @map("source_type") @db.VarChar(30)
  sourceId       String? @map("source_id") @db.Uuid
  /// Accounting hook. Null until posted to the GL.
  journalRef     String? @map("journal_ref") @db.VarChar(60)
  /// Retry/replay guard: a double-submitted prepayment cannot post twice.
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(120)

  /// Set on a REVERSAL row, pointing at what it reverses. The original is never
  /// deleted.
  reversalOfId String? @map("reversal_of_id") @db.Uuid
  /// Optional 1:1 mirror of a payroll deduction when accounting wants one
  /// unified stream. Unique => a deduction is mirrored at most once.
  deductionId  String? @unique @map("deduction_id") @db.Uuid

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  request    AdvanceLoanRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reversalOf LoanTransaction?      @relation("LoanTxnReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals  LoanTransaction[]     @relation("LoanTxnReversal")
  deduction  AdvanceLoanDeduction? @relation(fields: [deductionId], references: [id], onDelete: SetNull)

  @@index([requestId, transactionDate])
  @@index([type, status])
  @@index([journalRef])
  @@map("loan_transactions")
}

/// Audit + trigger record for a mid-loan rate/method change. Inserting a row is
/// what causes a schedule regeneration from `effectiveFrom`. Shipped now (five
/// real columns) so floating-rate support is a service change, not a migration.
model LoanRateChange {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String             @map("request_id") @db.Uuid
  effectiveFrom DateTime           @map("effective_from") @db.Date
  oldRate       Decimal            @map("old_rate") @db.Decimal(6, 3)
  newRate       Decimal            @map("new_rate") @db.Decimal(6, 3)
  oldMethod     LoanInterestMethod @map("old_method")
  newMethod     LoanInterestMethod @map("new_method")
  /// KEEP_TENURE (EMI moves) | KEEP_EMI (tenure moves)
  mode          String             @default("KEEP_TENURE") @db.VarChar(20)
  reason        String?            @db.Text

  scheduleVersionBefore Int      @map("schedule_version_before")
  scheduleVersionAfter  Int      @map("schedule_version_after")
  appliedAt             DateTime @default(now()) @map("applied_at") @db.Timestamp(6)
  appliedById           String?  @map("applied_by_id") @db.Uuid

  request AdvanceLoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, effectiveFrom])
  @@map("loan_rate_changes")
}

/// Records the DECISION taken on an employee's outstanding loans at exit and
/// its ledger effect. This is not an F&F module — the gratuity / leave
/// encashment payout itself remains external.
// A court-ordered attachment of earnings.
//
// `PayrollItem.garnishment` and `CycleContext.garnishment` both existed and
// payroll passed a hard-coded 0, so the requirement doc's headline case —
// "statutory deductions, garnishments, advances and loans compete for a limited
// net salary" — had a missing rung: there was nowhere to record that an order
// existed. This is that record.
//
// Deliberately NOT a SalaryComponent: every non-PAYROLL_CONFIG component is
// treated as an EARNING by payroll-earnings.util.ts, so a garnishment expressed
// as one would be added to pay rather than taken out of it.
model GarnishmentOrder {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  /// Court or authority reference, so a payslip query can be answered.
  reference  String  @db.VarChar(120)
  authority  String? @db.VarChar(200)

  /// Fixed amount per cycle. Exactly one of amount / percentOfNet is used.
  amount       Decimal? @db.Decimal(12, 2)
  /// Share of net pay per cycle, 0-100. Some orders are expressed this way.
  percentOfNet Decimal? @map("percent_of_net") @db.Decimal(5, 2)
  /// Stop once this much has been collected in total. Null = until endDate.
  totalCap     Decimal? @map("total_cap") @db.Decimal(12, 2)
  /// Running total actually recovered, maintained by payroll.
  collected    Decimal  @default(0) @db.Decimal(12, 2)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?   @db.Text

  /// Which order is satisfied first when pay cannot cover them all. Lower goes
  /// first; ties break on the older order, then on id, so the ladder is total
  /// and two runs over the same data allocate identically.
  priority Int @default(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  deductions GarnishmentDeduction[]

  @@index([employeeId, isActive])
  @@index([isActive, startDate])
  @@map("garnishment_orders")
}

// What one payroll run actually took under one order.
//
// The mirror of AdvanceLoanDeduction, and for the same reason: a running
// `collected` counter alone cannot say WHICH cycle took what, cannot be
// reconciled against a payslip, and cannot be reversed when a locked payroll is
// unlocked. The counter on the order stays as the fast read; this is the truth
// behind it.
model GarnishmentDeduction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  payrollItemId String?  @map("payroll_item_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  month         Int
  year          Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  order GarnishmentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// One order takes at most once per cycle, which is what makes a re-lock
  /// after an unlock safe: the second attempt loses on this index.
  @@unique([orderId, month, year])
  @@index([payrollItemId])
  @@map("garnishment_deductions")
}

// ── Accounting ──────────────────────────────────────────────────────────────
//
// Gap report §1: there is no accounting, GL or journal module anywhere, and
// `LoanTransaction.journalRef` is declared, indexed, and referenced by NOTHING.
// The whole of catalogue §14 was therefore 0% testable.
//
// What exists instead is the right feed: `LoanTransaction` is a complete,
// append-only money log with typed components and a reversal link. This is the
// posting side it was always waiting for, and nothing more — a full chart of
// accounts, periods and trial balances belong to a finance system, not here.

// A GL account, as this product needs to know about it.
//
// Deliberately thin: a code, a name, a type. The real chart of accounts lives
// in whatever system consumes these entries; this exists so a posting can name
// its debit and credit sides in the customer's own language rather than in
// hard-coded strings.
model LedgerAccount {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(40)
  name     String  @db.VarChar(200)
  /// ASSET | LIABILITY | INCOME | EXPENSE
  type     String  @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")
  /// null => used by every branch.
  branchId String? @map("branch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  debitLines     JournalLine[]   @relation("DebitAccount")
  creditLines    JournalLine[]   @relation("CreditAccount")
  debitMappings  LedgerMapping[] @relation("MappingDebitAccount")
  creditMappings LedgerMapping[] @relation("MappingCreditAccount")

  @@index([isActive, code])
  @@map("ledger_accounts")
}

// Which accounts a given kind of loan event posts to.
//
// The mapping is data, not code, because "loan receivable" is account 1310 in
// one company and 1205 in the next — and because a company that has not mapped
// an event should get a clear refusal rather than a posting to a guessed
// account.
model LedgerMapping {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The LoanTransactionType this mapping covers, plus DISBURSEMENT/WRITE_OFF etc.
  event    String  @db.VarChar(40)
  /// null => applies to every branch.
  branchId String? @map("branch_id") @db.Uuid

  debitAccountId  String @map("debit_account_id") @db.Uuid
  creditAccountId String @map("credit_account_id") @db.Uuid

  /// PRINCIPAL | INTEREST | FEE | TOTAL — which component of the event this
  /// line carries. One event can map several components to different accounts.
  component String  @default("TOTAL") @db.VarChar(20)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  debitAccount  LedgerAccount @relation("MappingDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount LedgerAccount @relation("MappingCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  /// Prisma cannot express a PARTIAL unique index, and `branch_id` is nullable
  /// — Postgres does not treat two NULLs as equal, so this declaration alone
  /// would let the company-wide mapping be duplicated without limit. The real
  /// rule is two partial indexes in the migration, mirrored into
  /// `prisma/e2e-partial-indexes.sql` and `prisma/db-push-preflight.sql` so all
  /// three provisioning paths agree. See R80.
  @@unique([event, component, branchId])
  @@index([event, isActive])
  @@map("ledger_mappings")
}

// One balanced journal entry.
//
// `sourceType`/`sourceId` name what caused it, so a posting can always be
// traced back to the money that produced it — and so a replay can find what has
// already been posted instead of posting it twice.
model JournalEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable, unique, and written back onto LoanTransaction.journalRef.
  reference String   @unique @db.VarChar(60)
  entryDate DateTime @map("entry_date") @db.Date
  narration String?  @db.Text

  /// LOAN_TRANSACTION for now; the column exists so payroll and reimbursement
  /// can post through the same service later.
  sourceType String  @map("source_type") @db.VarChar(40)
  sourceId   String  @map("source_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid

  /// POSTED | REVERSED. Never deleted: a reversal is another entry.
  status       String  @default("POSTED") @db.VarChar(20)
  reversalOfId String? @map("reversal_of_id") @db.Uuid

  postedById String?  @map("posted_by_id") @db.Uuid
  postedAt   DateTime @default(now()) @map("posted_at") @db.Timestamp(6)

  branch     Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  lines      JournalLine[]
  reversalOf JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[] @relation("JournalReversal")

  /// One posting per source event. This is what makes posting replayable: a
  /// second attempt loses on the index instead of duplicating the entry.
  @@unique([sourceType, sourceId, status])
  @@index([entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId String @map("entry_id") @db.Uuid

  debitAccountId  String  @map("debit_account_id") @db.Uuid
  creditAccountId String  @map("credit_account_id") @db.Uuid
  amount          Decimal @db.Decimal(12, 2)
  /// PRINCIPAL | INTEREST | FEE | TOTAL
  component       String  @default("TOTAL") @db.VarChar(20)
  narration       String? @db.Text

  entry         JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccount  LedgerAccount @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount LedgerAccount @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@map("journal_lines")
}

model LoanSettlement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  totalOutstanding Decimal   @default(0) @map("total_outstanding") @db.Decimal(12, 2)
  recovered        Decimal   @default(0) @db.Decimal(12, 2)
  waived           Decimal   @default(0) @db.Decimal(12, 2)
  writtenOff       Decimal   @default(0) @map("written_off") @db.Decimal(12, 2)
  carried          Decimal   @default(0) @db.Decimal(12, 2)
  /// Pre-state snapshot per loan, so reverseSettlement() can restore exactly.
  decisionsJson    Json      @map("decisions_json")
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime  @default(now()) @map("decided_at") @db.Timestamp(6)
  reversedAt       DateTime? @map("reversed_at") @db.Timestamp(6)
  reversedBy       String?   @map("reversed_by") @db.Uuid
  reversalReason   String?   @map("reversal_reason") @db.Text

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("loan_settlements")
}

/// Notification claim log. Reuses the primitive the reminders engine already
/// relies on: insert with skipDuplicates, and only the rows actually inserted
/// get sent. That is what stops a payroll rerun from resending "EMI deducted".
model AdvanceLoanNotificationLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String    @map("request_id") @db.Uuid
  event           String    @db.VarChar(40)
  /// '2026-08' for period-bound events, the mutation id for one-shot events,
  /// '' for lifecycle-once events.
  periodKey       String    @default("") @map("period_key") @db.VarChar(40)
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  channel         String    @default("IN_APP") @db.VarChar(10)
  status          String    @default("PENDING") @db.VarChar(20) // PENDING | SENT | FAILED
  attempts        Int       @default(0)
  lastError       String?   @map("last_error") @db.Text
  sentAt          DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  request AdvanceLoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, event, periodKey, recipientUserId, channel])
  @@index([status, attempts])
  @@map("advance_loan_notification_logs")
}

model AdvanceLoanAttachment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String    @map("request_id") @db.Uuid
  fileName   String    @map("file_name") @db.VarChar(255)
  fileUrl    String    @map("file_url") @db.Text
  fileSize   BigInt?   @map("file_size")
  mimeType   String?   @map("mime_type") @db.VarChar(100)
  uploadedBy String?   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamp(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamp(6)

  request  AdvanceLoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User?              @relation("AdvanceLoanAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("advance_loan_attachments")
}

model OvertimeRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  date            DateTime @db.Date
  startTime       DateTime @map("start_time") @db.Timestamp(6)
  endTime         DateTime @map("end_time") @db.Timestamp(6)
  hours           Decimal  @db.Decimal(5, 2)
  regularHours    Decimal  @default(0) @map("regular_hours") @db.Decimal(5, 2)
  lateHours       Decimal  @default(0) @map("late_hours") @db.Decimal(5, 2)
  doubleHours     Decimal  @default(0) @map("double_hours") @db.Decimal(5, 2)
  doubleLateHours Decimal  @default(0) @map("double_late_hours") @db.Decimal(5, 2)
  dayType         String   @default("WEEKDAY") @map("day_type") @db.VarChar(20)
  foodAllowance   Decimal  @default(0) @map("food_allowance") @db.Decimal(10, 2)
  otType          String   @default("REGULAR") @map("ot_type") @db.VarChar(20)

  // ── Approver review & edit ────────────────────────────────────────────────
  // An approver at their ACTIVE step may correct the worked window, override the
  // policy-computed food allowance and grant a site allowance. Persisted BEFORE
  // approvalEngine.decide() runs: an intermediate approver in a multi-step chain
  // returns early and never reaches finalizeOvertimeApproval(), so a write
  // deferred to there would silently lose every Step 1 SUPERVISOR edit.
  //
  // Approver-granted and not derivable from any policy, so — unlike
  // foodAllowance — it is deliberately absent from finalizeOvertimeApproval()'s
  // update payload, which is what keeps it alive through the approval recompute.
  siteAllowance         Decimal   @default(0) @map("site_allowance") @db.Decimal(10, 2)
  siteAllowanceNote     String?   @map("site_allowance_note") @db.Text
  // NULLABLE on purpose: "the approver did not touch it" and "the approver set
  // it to 0" are different facts. Null → the policy computes the allowance; any
  // value, 0 included, wins. Same shape as the HR payroll-item override.
  foodAllowanceOverride Decimal?  @map("food_allowance_override") @db.Decimal(10, 2)
  approverNote          String?   @map("approver_note") @db.Text
  editedById            String?   @map("edited_by_id") @db.Uuid
  editedAt              DateTime? @map("edited_at") @db.Timestamp(6)
  // What the employee actually filed. Snapshotted on the FIRST edit only, so a
  // second approver's edit does not overwrite the original with an edited value.
  originalStartTime     DateTime? @map("original_start_time") @db.Timestamp(6)
  originalEndTime       DateTime? @map("original_end_time") @db.Timestamp(6)

  // Snapshot of the Overtime Policy that governed this request when its hours
  // were classified/frozen, so payroll monetizes against the same policy. Null →
  // legacy global overtime settings (covers all pre-migration rows).
  overtimePolicyId String?   @map("overtime_policy_id") @db.Uuid
  reason           String    @db.Text
  status           String    @default("PENDING") @db.VarChar(50)
  approverId       String?   @map("approver_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason   String?   @map("rejected_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimePolicy OvertimePolicy? @relation(fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  editedBy       User?           @relation("OvertimeRequestEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([overtimePolicyId])
  @@index([editedById])
  @@map("overtime_requests")
}

// ── Overtime Policy engine ──────────────────────────────────────────────────
// NB: employment type is a CONTRACT_TYPE library label (a free string), NOT a
// Prisma enum — so it is admin-configurable from the Contract Type library.
// Holiday behaviour (STANDARD | IGNORE) likewise lives inside the `rules` JSON
// blob (TS enum HolidayBehaviorEnum in overtime-policy.types.ts), not a column.

// Reusable, admin-managed overtime rule set. Encapsulates rates, holiday
// behaviour, boundary time, allowances, caps and eligibility as a versioned
// JSON `rules` blob (shaped like the OvertimeConfig the calc engine already
// consumes). Assigned to employees via Employee Override → Employment Type →
// Company Default; the engine resolves the effective policy and reads its rules.
// Guarded by the `overtime_policy_enabled` kill-switch — off → legacy globals.
model OvertimePolicy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(150)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  // Exactly one active default (company-wide fallback). Enforced by a partial
  // unique index created in the migration.
  isDefault      Boolean  @default(false) @map("is_default")
  // Middle tier: at most one active policy per employment type (partial unique
  // index in the migration). A CONTRACT_TYPE library label. Null = not
  // employment-type-scoped.
  employmentType String?  @map("employment_type") @db.VarChar(100)
  schemaVersion  Int      @default(1) @map("schema_version")
  rules          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employees        Employee[]        @relation("EmployeeOvertimePolicy")
  overtimeRequests OvertimeRequest[]

  @@index([isActive])
  @@index([employmentType])
  @@map("overtime_policies")
}

model LeaveAccrualHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  year          Int
  month         Int
  daysAdded     Int      @map("days_added")
  balanceBefore Int      @map("balance_before")
  balanceAfter  Int      @map("balance_after")
  accrualType   String   @map("accrual_type") @db.VarChar(50)
  triggeredBy   String?  @map("triggered_by") @db.Uuid
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, year, month])
  @@map("leave_accrual_history")
}

/// One band of a statutory end-of-service entitlement.
///
/// A table rather than a setting because the rate is not one number. Oman's law
/// changed in 2023, the previous law used a lower rate for the first three years
/// of service, and the Social Protection Fund may carry a national's benefit
/// instead of the employer. All three are expressible here as rows; none of them
/// is expressible as `payroll_gratuity_rate`.
///
/// Retrofitting this shape after two years of accrued balances would mean
/// recalculating every employee's whole history, which is why it exists on day
/// one even though only one row is seeded.
model GratuityRule {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country          String    @db.VarChar(2)
  /// NATIONAL | GCC | EXPAT | ANY
  nationalityClass String    @map("nationality_class") @db.VarChar(20)
  /// Service band, half-open: [fromYears, toYears). NULL toYears = open-ended.
  fromYears        Decimal   @map("from_years") @db.Decimal(6, 3)
  toYears          Decimal?  @map("to_years") @db.Decimal(6, 3)
  /// Days of pay earned per year of service inside this band.
  daysPerYear      Decimal   @map("days_per_year") @db.Decimal(6, 3)
  /// BASIC | GROSS — which figure a day is priced from.
  basis            String    @default("BASIC") @db.VarChar(10)
  /// Divisor turning a monthly figure into a daily one.
  monthDays        Decimal   @default(30) @map("month_days") @db.Decimal(6, 3)
  /// Fraction the EMPLOYER bears. Oman's Social Protection Fund arrangement is
  /// a NATIONAL rule with employerShare = 0 — no schema change needed.
  employerShare    Decimal   @default(1) @map("employer_share") @db.Decimal(5, 4)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  accruals GratuityAccrual[]

  @@index([country, nationalityClass, effectiveFrom])
  @@map("gratuity_rules")
}

/// The gratuity one employee earned in one locked payroll period.
///
/// A provision, not a payslip line: it never appears on a payslip, never changes
/// take-home, and never enters a tax or insurance base. It is money the company
/// sets aside, and its purpose is to give Finance a liability figure they can
/// plan against.
///
/// Written when a payroll LOCKS, in the same transaction as the loan ledger, so
/// the provision moves when the money does — and reversed by the same unlock.
model GratuityAccrual {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  payrollId     String    @map("payroll_id") @db.Uuid
  month         Int
  year          Int
  /// The figure a day was priced from, per the rule's `basis`.
  basisAmount   Decimal   @map("basis_amount") @db.Decimal(12, 2)
  serviceYears  Decimal   @map("service_years") @db.Decimal(8, 4)
  daysAccrued   Decimal   @map("days_accrued") @db.Decimal(8, 4)
  /// Employer-borne amount for this month.
  amount        Decimal   @db.Decimal(12, 2)
  employerShare Decimal   @map("employer_share") @db.Decimal(5, 4)
  ruleId        String?   @map("rule_id") @db.Uuid
  /// Every input and every rule as applied. Never recomputed, because a
  /// settlement disputed five years later cannot be answered with "the system
  /// would calculate it differently now".
  workingJson   Json      @map("working_json") @db.JsonB
  /// ACCRUED | REVERSED | SETTLED
  status        String    @default("ACCRUED") @db.VarChar(20)
  reversedAt    DateTime? @map("reversed_at") @db.Timestamp(6)
  settlementId  String?   @map("settlement_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rule     GratuityRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  /// The idempotency guard that makes lock -> unlock -> lock safe.
  @@unique([employeeId, payrollId])
  @@index([employeeId, year, month])
  @@index([branchId, year, month])
  @@map("gratuity_accruals")
}

/// Whether a leave type can be turned into money, and whether it survives a
/// year end.
///
/// One model for two features because they are two ways of answering the same
/// question — what happens to leave an employee did not take — and splitting
/// them would mean two places to look when the answer is wrong. Each half is
/// behind its own flag.
///
/// `branchId` NULL is the company-wide default. Postgres treats NULLs as
/// distinct in a composite unique, so uniqueness is enforced by two PARTIAL
/// indexes in the migration rather than by `@@unique` here — the same trap
/// migration 20260805100000 exists to fix on `payrolls`.
model LeaveTypePolicy {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Matches `LibraryItem.label`, exactly as `LeaveTypeBalance.leaveTypeKey` does.
  leaveTypeKey String  @map("leave_type_key") @db.VarChar(100)
  branchId     String? @map("branch_id") @db.Uuid

  encashable           Boolean @default(false)
  maxEncashDaysPerYear Int?    @map("max_encash_days_per_year")
  /// BASIC | GROSS — which figure a day of leave is priced from.
  encashBasis          String  @default("BASIC") @map("encash_basis") @db.VarChar(10)
  /// Divisor turning a monthly figure into a daily one.
  monthDays            Decimal @default(30) @map("month_days") @db.Decimal(6, 3)
  /// Only leave already accrued may be encashed, not the whole allocation.
  accruedOnly          Boolean @default(true) @map("accrued_only")
  allowInService       Boolean @default(true) @map("allow_in_service")
  allowOnExit          Boolean @default(true) @map("allow_on_exit")

  carryForwardEnabled      Boolean @default(false) @map("carry_forward_enabled")
  carryForwardMaxDays      Int?    @map("carry_forward_max_days")
  carryForwardExpiryMonths Int?    @map("carry_forward_expiry_months")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([leaveTypeKey])
  @@map("leave_type_policies")
}

/// A request to be paid for leave instead of taking it.
///
/// Carries an explicit `employeeId` that ADMIN/HR_MANAGER may set — deliberately
/// unlike `Reimbursement`, whose missing `employeeId` is what stopped HR filing
/// on an employee's behalf. HR files encashment for a leaver every day, so the
/// field is product behaviour rather than a test convenience.
model LeaveEncashmentRequest {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  leaveTypeKey String @map("leave_type_key") @db.VarChar(100)
  year         Int

  days       Decimal  @db.Decimal(6, 2)
  /// Snapshotted at approval. A figure nobody can defend once the salary
  /// changes is a figure that loses an argument.
  ratePerDay Decimal? @map("rate_per_day") @db.Decimal(12, 2)
  amount     Decimal? @db.Decimal(12, 2)

  /// PENDING | APPROVED | REJECTED | PAID | CANCELLED
  status String @default("PENDING") @db.VarChar(20)

  /// Set when payroll pays it. Mutually exclusive with `settlementId` — paying
  /// through both is the failure mode a CHECK guards against.
  payrollItemId String? @map("payroll_item_id") @db.Uuid
  settlementId  String? @map("settlement_id") @db.Uuid

  reason         String?   @db.Text
  requestedBy    String?   @map("requested_by") @db.Uuid
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text
  paidAt         DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([branchId, status])
  @@map("leave_encashment_requests")
}

/// One execution of the year-end carry-forward.
///
/// The most dangerous operation in this area: it rewrites every employee's
/// balance. So it records what it did, stamps every row it touched, and can be
/// reversed exactly — and the unique key means running it twice cannot double
/// anyone's balance.
model LeaveCarryForwardRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  fromYear      Int       @map("from_year")
  toYear        Int       @map("to_year")
  leaveTypeKeys String[]  @map("leave_type_keys")
  employeeCount Int       @default(0) @map("employee_count")
  daysCarried   Decimal   @default(0) @map("days_carried") @db.Decimal(10, 2)
  daysLapsed    Decimal   @default(0) @map("days_lapsed") @db.Decimal(10, 2)
  /// APPLIED | REVERSED
  status        String    @default("APPLIED") @db.VarChar(20)
  workingJson   Json      @map("working_json") @db.JsonB
  executedBy    String?   @map("executed_by") @db.Uuid
  executedAt    DateTime  @default(now()) @map("executed_at") @db.Timestamp(6)
  reversedBy    String?   @map("reversed_by") @db.Uuid
  reversedAt    DateTime? @map("reversed_at") @db.Timestamp(6)

  @@unique([branchId, fromYear, toYear])
  @@map("leave_carry_forward_runs")
}

/// What an employee is owed when they leave, and the permanent working behind it.
///
/// Distinct from `PayrollRunType.FINAL_SETTLEMENT`, which is a payroll RUN. The
/// run pays pending salary through payroll, so it reaches the payslip, the wage
/// file and the bank; this document composes the whole exit package — gratuity,
/// leave encashment, notice pay, less loans and recoveries — and records how
/// every figure was arrived at. The run's net becomes this document's
/// PENDING_SALARY line.
model FinalSettlement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  /// RESIGNATION | TERMINATION | RETIREMENT | DEATH | CONTRACT_END
  variant         String   @db.VarChar(20)
  lastWorkingDate DateTime @map("last_working_date") @db.Date

  noticeServedDays   Int? @map("notice_served_days")
  noticeRequiredDays Int? @map("notice_required_days")

  /// DRAFT | APPROVED | PAID | CANCELLED
  status String @default("DRAFT") @db.VarChar(20)

  computedAt      DateTime @default(now()) @map("computed_at") @db.Timestamp(6)
  /// Every figure, every rule and every setting value read. Never recomputed:
  /// settlements are disputed years later, and "the system would calculate it
  /// differently now" is not an answer.
  workingJson     Json     @map("working_json") @db.JsonB
  totalEarnings   Decimal  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPayable      Decimal  @default(0) @map("net_payable") @db.Decimal(12, 2)

  /// The FINAL_SETTLEMENT payroll run that pays the salary half, if one exists.
  payrollId String? @map("payroll_id") @db.Uuid

  notes        String?   @db.Text
  preparedBy   String?   @map("prepared_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamp(6)
  paidAt       DateTime? @map("paid_at") @db.Timestamp(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    FinalSettlementLine[]

  @@index([employeeId, status])
  @@index([branchId, status])
  @@map("final_settlements")
}

/// One line of a settlement, and the record of anyone who changed it.
///
/// `computedAmount` is what the system worked out; `adjustedAmount` is what a
/// human decided instead. HR may override any line — they know things the
/// system does not — but a CHECK makes the reason mandatory, so an override can
/// never be silent.
model FinalSettlementLine {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  /// EARNING | DEDUCTION — carries the sign; amounts are always positive.
  category     String @db.VarChar(20)
  code         String @db.VarChar(50)
  label        String @db.VarChar(150)

  computedAmount   Decimal   @map("computed_amount") @db.Decimal(12, 2)
  adjustedAmount   Decimal?  @map("adjusted_amount") @db.Decimal(12, 2)
  adjustmentReason String?   @map("adjustment_reason") @db.Text
  adjustedBy       String?   @map("adjusted_by") @db.Uuid
  adjustedAt       DateTime? @map("adjusted_at") @db.Timestamp(6)

  sourceType   String? @map("source_type") @db.VarChar(30)
  sourceId     String? @map("source_id") @db.Uuid
  displayOrder Int     @default(0) @map("display_order")

  settlement FinalSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, displayOrder])
  @@map("final_settlement_lines")
}

/// A branch's payroll year: when each period opens, closes, cuts off and pays.
///
/// Deliberately NOT the period's identity. `Payroll.month` + `Payroll.year` and
/// `uniq_payroll_period_branch_batch_version` are untouched — a calendar
/// DESCRIBES a period, it never keys one. That is what makes this additive: a
/// branch with no calendar behaves exactly as every branch does today.
model PayrollCalendar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  year      Int
  name      String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  periods PayrollCalendarPeriod[]

  @@unique([branchId, year])
  @@map("payroll_calendars")
}

/// One month of a payroll calendar.
model PayrollCalendarPeriod {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calendarId    String   @map("calendar_id") @db.Uuid
  month         Int
  /// The window the period covers. Free to differ from the calendar month, which
  /// is the point: a 26th-to-25th period has to be expressible.
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  /// After this, inputs are late. Advisory unless `enforceCutOff` is set.
  cutOffDate    DateTime @map("cut_off_date") @db.Date
  paymentDate   DateTime @map("payment_date") @db.Date
  /// Enforcement is per PERIOD, not a global switch.
  ///
  /// Deliberately a column rather than a system setting: settings are global and
  /// shared, so a branch could not pilot enforcement without changing it for
  /// everyone. It also makes the behaviour testable in the default lane, which a
  /// global flag is not.
  enforceCutOff Boolean  @default(false) @map("enforce_cut_off")

  calendar PayrollCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, month])
  @@map("payroll_calendar_periods")
}

/// Money the employer is recovering from an employee, other than a loan.
///
/// One model with a `kind` rather than a table per case, because asset damage,
/// an asset never returned, a training bond and a notice shortfall are the same
/// thing mechanically — a fixed sum collected over instalments, bounded by what
/// the pay can bear — and differ only in what a payslip should call them.
///
/// `clearance.service.ts` already BLOCKS an exit while an asset is out, but no
/// money has ever moved: recovering meant raising a loan or a salary component
/// by hand, with nothing linking it back to the asset. `assetAssignmentId`
/// closes that.
model EmployeeRecovery {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid
  /// ASSET_DAMAGE | ASSET_LOSS | TRAINING_BOND | NOTICE_SHORTFALL | OTHER
  kind       String @db.VarChar(30)

  /// The assignment this recovery is for, when it is about an asset.
  assetAssignmentId String? @map("asset_assignment_id") @db.Uuid
  reference         String? @db.VarChar(100)

  totalAmount      Decimal  @map("total_amount") @db.Decimal(12, 2)
  amountRecovered  Decimal  @default(0) @map("amount_recovered") @db.Decimal(12, 2)
  /// NULL means "take whatever the pay can bear this period".
  instalmentAmount Decimal? @map("instalment_amount") @db.Decimal(12, 2)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  /// Lower runs first, as with garnishments.
  priority  Int       @default(200)

  /// ACTIVE | COMPLETED | CANCELLED | RECEIVABLE | WAIVED
  status String  @default("ACTIVE") @db.VarChar(20)
  reason String? @db.Text

  createdBy    String?   @map("created_by") @db.Uuid
  waivedBy     String?   @map("waived_by") @db.Uuid
  waivedAt     DateTime? @map("waived_at") @db.Timestamp(6)
  waivedReason String?   @map("waived_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([branchId, status])
  @@map("employee_recoveries")
}

/// Moving an employee between branches, as a reviewed act.
///
/// `UpdateEmployeeDto` deliberately omits `branchId`, and says why: moving an
/// employee crosses the isolation axis, so it "needs its own reviewed flow
/// rather than a field on this form". This is that flow. The DTO still omits
/// the field — a transfer is a different route, not a looser form.
model EmployeeTransfer {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  fromBranchId     String  @map("from_branch_id") @db.Uuid
  toBranchId       String  @map("to_branch_id") @db.Uuid
  fromDepartmentId String? @map("from_department_id") @db.Uuid
  toDepartmentId   String? @map("to_department_id") @db.Uuid

  effectiveDate DateTime @map("effective_date") @db.Date
  reason        String   @db.Text

  /// PENDING | APPROVED | REJECTED | APPLIED | CANCELLED
  status String @default("PENDING") @db.VarChar(20)

  requestedBy    String?   @map("requested_by") @db.Uuid
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamp(6)
  rejectedReason String?   @map("rejected_reason") @db.Text
  appliedAt      DateTime? @map("applied_at") @db.Timestamp(6)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamp(6)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([toBranchId, status])
  @@index([effectiveDate])
  @@map("employee_transfers")
}

/// A pay band.
///
/// A NEW axis, not a rename. `Employee.employmentType` is sometimes used as a
/// de-facto grade, but it is a CONTRACT_TYPE library label and it drives the
/// overtime-policy inheritance chain — repurposing it would change overtime for
/// everybody. Grade sits beside it and is nullable, so an installation that
/// never turns it on is unaffected.
model Grade {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  /// Seniority. Lower is junior; used for ordering and for band comparisons.
  level       Int
  minSalary   Decimal? @map("min_salary") @db.Decimal(12, 2)
  maxSalary   Decimal? @map("max_salary") @db.Decimal(12, 2)
  branchId    String?  @map("branch_id") @db.Uuid
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  components GradeSalaryComponent[]
  employees  Employee[]

  @@index([level])
  @@map("grades")
}

/// What a grade contributes to a salary structure.
///
/// A TEMPLATE, never an input to payroll. `SalaryComponent` remains the only
/// pay input the engine reads; these rows pre-fill it on hire and validate it on
/// edit. That is what keeps grade out of the calculation entirely.
model GradeSalaryComponent {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gradeId       String  @map("grade_id") @db.Uuid
  /// A SALARY_COMPONENT_TYPE library slug, as `SalaryComponent.componentType` is.
  componentType String  @map("component_type") @db.VarChar(50)
  /// FIXED | PERCENT_OF_BASIC
  valueType     String  @map("value_type") @db.VarChar(20)
  value         Decimal @db.Decimal(12, 4)
  isMandatory   Boolean @default(false) @map("is_mandatory")

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, componentType])
  @@map("grade_salary_components")
}

model SalaryComponent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  componentType String   @map("component_type") @db.VarChar(50)
  amount        Decimal  @db.Decimal(15, 2)
  effectiveDate DateTime @default(now()) @map("effective_date") @db.Date
  isActive      Boolean  @default(true) @map("is_active")
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isActive])
  @@map("salary_components")
}

model ChatHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  userMessage String   @map("user_message") @db.Text
  botResponse String   @map("bot_response") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([createdAt])
  @@map("chat_history")
}

// =====================================================
// EMPLOYEE PROFILE & DOCUMENTS (NEW)
// =====================================================

model EmployeeProfile {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @unique @map("employee_id") @db.Uuid

  // Personal Information
  placeOfBirth     String? @map("place_of_birth") @db.VarChar(255)
  nationality      String  @default("Vietnam") @db.VarChar(100)
  /// ISO-3166 alpha-2, uppercase. The free-text `nationality` above is left
  /// exactly as it is — it has a default of 'Vietnam' and is displayed in
  /// places this must not change — so end-of-service reads THIS instead.
  nationalityCode  String? @map("nationality_code") @db.VarChar(2)
  /// NATIONAL | GCC | EXPAT. Three classes from the start because Oman's 2023
  /// law treats them differently, and a two-way boolean would have to be
  /// migrated the day the third one is needed.
  ///
  /// NULL means UNKNOWN and is never silently read as EXPAT: gratuity refuses
  /// to accrue for an employee whose class nobody has recorded, rather than
  /// guessing at a statutory entitlement.
  nationalityClass String? @map("nationality_class") @db.VarChar(20)
  ethnicity        String? @db.VarChar(100)
  religion         String? @db.VarChar(100)
  maritalStatus    String? @map("marital_status") @db.VarChar(50)
  numberOfChildren Int     @default(0) @map("number_of_children")

  // Address Details
  permanentAddress String? @map("permanent_address") @db.Text
  temporaryAddress String? @map("temporary_address") @db.Text

  // Government IDs
  passportNumber String?   @map("passport_number") @db.VarChar(50)
  passportExpiry DateTime? @map("passport_expiry") @db.Date

  // Emergency Contact
  emergencyContactName         String? @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactRelationship String? @map("emergency_contact_relationship") @db.VarChar(100)
  emergencyContactPhone        String? @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactAddress      String? @map("emergency_contact_address") @db.Text

  // Education
  highestEducation         String? @map("highest_education") @db.VarChar(100)
  major                    String? @db.VarChar(255)
  university               String? @db.VarChar(255)
  graduationYear           Int?    @map("graduation_year")
  professionalCertificates String? @map("professional_certificates") @db.Text

  // Bank Information
  bankName              String? @map("bank_name") @db.VarChar(255)
  bankAccountNumber     String? @map("bank_account_number") @db.VarChar(50)
  bankAccountHolderName String? @map("bank_account_holder_name") @db.VarChar(255)
  bankBranch            String? @map("bank_branch") @db.VarChar(255)

  // Insurance & Tax
  taxCode               String? @map("tax_code") @db.VarChar(20)
  socialInsuranceNumber String? @map("social_insurance_number") @db.VarChar(20)
  healthInsuranceNumber String? @map("health_insurance_number") @db.VarChar(20)
  dependents            Int?    @default(0)

  // Work Experience (before joining company)
  workExperience Json? @map("work_experience")

  // Metadata
  profileCompletionPercentage Int       @default(0) @map("profile_completion_percentage")
  lastProfileUpdate           DateTime? @map("last_profile_update") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

// ── Enterprise Bank Master & payment info ───────────────────────────────────
// Admin-managed bank catalog, scoped per country (ISO-2, reuse CountryPreset
// codes e.g. "OM"). Employees pick a Bank instead of typing a free-text name.
model Bank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country   String   @db.VarChar(2) // ISO-2 e.g. "OM"
  name      String   @db.VarChar(255)
  bankCode  String?  @map("bank_code") @db.VarChar(20) // OM: 3-char CBO code embedded in IBAN positions 5-7
  swift     String?  @db.VarChar(11)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  changeRequests BankChangeRequest[]
  bankDetails    EmployeeBankDetail[]

  @@unique([country, name])
  @@index([country, isActive])
  @@map("banks")
}

// Configurable, per-country banking field schema. Drives BOTH the dynamic form
// rendering and validation for employee bank details — no banking field (IBAN,
// IFSC, SWIFT, sort code, routing number, …) is hardcoded. Onboarding a new
// country is pure configuration: add rows here.
model CountryBankingField {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country        String   @db.VarChar(2) // ISO-2
  fieldKey       String   @map("field_key") @db.VarChar(50) // internal key, e.g. "iban", "ifsc"
  label          String   @db.VarChar(100) // display name
  fieldType      String   @default("TEXT") @map("field_type") @db.VarChar(20) // TEXT | NUMBER | SELECT
  validationType String   @default("NONE") @map("validation_type") @db.VarChar(20) // NONE|IBAN|IFSC|SWIFT|SORT_CODE|ROUTING|NUMBER|REGEX
  regex          String?  @db.Text // custom pattern when validationType = REGEX
  options        Json?    @db.JsonB // choices when fieldType = SELECT
  required       Boolean  @default(true)
  displayOrder   Int      @default(0) @map("display_order")
  placeholder    String?  @db.VarChar(255)
  helpText       String?  @map("help_text") @db.VarChar(255)
  isSensitive    Boolean  @default(true) @map("is_sensitive") // mask in reads/audit/notifications
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([country, fieldKey])
  @@index([country, isActive])
  @@map("country_banking_fields")
}

// Versioned source of truth for an employee's approved bank details. Exactly one
// active row per employee (partial unique index in migration); payroll + WPS read
// only the active row. History preserved by keeping deactivated rows.
model EmployeeBankDetail {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  bankId            String   @map("bank_id") @db.Uuid
  // Dynamic, country-driven field values keyed by CountryBankingField.fieldKey.
  // The source of truth for all payment fields. Legacy scalar columns below are
  // kept nullable for back-compat / the free-text migration path only.
  data              Json?    @db.JsonB
  iban              String?  @db.VarChar(34)
  accountNumber     String?  @map("account_number") @db.VarChar(50)
  accountHolderName String?  @map("account_holder_name") @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  effectiveFrom     DateTime @default(now()) @map("effective_from") @db.Timestamp(6)
  source            String   @default("APPROVAL") @db.VarChar(20) // APPROVAL | MIGRATION
  sourceRequestId   String?  @map("source_request_id") @db.Uuid // the approved BankChangeRequest
  branchId          String?  @map("branch_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bank        Bank         @relation(fields: [bankId], references: [id])
  wpsFileRows WpsFileRow[]

  // Partial unique index enforced in migration:
  //   CREATE UNIQUE INDEX uniq_active_bank_detail ON employee_bank_details(employee_id) WHERE is_active;
  @@index([employeeId, isActive])
  @@map("employee_bank_details")
}

// The change request an employee submits. Never mutates the employee record — on
// final approval the app writes a new active EmployeeBankDetail. One PENDING
// request per employee (partial unique index in migration).
model BankChangeRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  bankId            String    @map("bank_id") @db.Uuid
  // Proposed dynamic field values keyed by CountryBankingField.fieldKey.
  data              Json?     @db.JsonB
  iban              String?   @db.VarChar(34)
  accountNumber     String?   @map("account_number") @db.VarChar(50)
  accountHolderName String?   @map("account_holder_name") @db.VarChar(255)
  status            String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED | CANCELLED
  requestedById     String    @map("requested_by_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bank     Bank     @relation(fields: [bankId], references: [id])

  // Partial unique index enforced in migration:
  //   CREATE UNIQUE INDEX uniq_pending_bank_change ON bank_change_requests(employee_id) WHERE status = 'PENDING';
  @@index([employeeId, status])
  @@map("bank_change_requests")
}

model EmployeeDocument {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String  @map("employee_id") @db.Uuid
  documentType String  @map("document_type") @db.VarChar(50)
  fileName     String  @map("file_name") @db.VarChar(255)
  fileUrl      String  @map("file_url") @db.Text
  fileSize     BigInt? @map("file_size")
  mimeType     String? @map("mime_type") @db.VarChar(100)
  description  String? @db.Text

  // Without these a personal document could never enter the reminder engine —
  // there was no date to expire against.
  issueDate         DateTime? @map("issue_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  /// True for letters and certificates the system produced, so the vault can
  /// tell them apart from what the employee uploaded.
  isSystemGenerated Boolean   @default(false) @map("is_system_generated")
  /// `private://...` ref when the file lives in the private bucket. Set for
  /// generated letters; null for legacy public uploads, which keep using fileUrl.
  privateRef        String?   @map("private_ref") @db.Text

  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploader User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  /// The engine's trace row, when this vault entry was machine-generated.
  generated GeneratedDocument[]

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("employee_documents")
}

// =====================================================
// EMPLOYEE ACTIVITY LOG - Track all employee activities
// =====================================================

model EmployeeActivity {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  // Activity details
  activityType String @map("activity_type") @db.VarChar(100) // 'profile_update', 'attendance', 'leave_request', etc.
