model AppraisalRun {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20) // PENDING|RUNNING|COMPLETED|FAILED|CANCELLED
  periodStart        DateTime  @map("period_start") @db.Date
  periodEnd          DateTime  @map("period_end") @db.Date
  periodLabel        String?   @map("period_label") @db.VarChar(100)
  // Branch the run was scoped to (null = all branches, global admin only).
  branchId           String?   @map("branch_id") @db.Uuid
  scopeJson          Json?     @map("scope_json") @db.JsonB // {departmentIds?, employeeIds?}
  createdById        String    @map("created_by_id") @db.Uuid
  model              String?   @db.VarChar(150)
  toolPlanJson       Json?     @map("tool_plan_json") @db.JsonB // AI-chosen tool plan (explainability)
  weightsJson        Json?     @map("weights_json") @db.JsonB
  executiveSummary   String?   @map("executive_summary") @db.Text
  orgInsightsJson    Json?     @map("org_insights_json") @db.JsonB
  totalEmployees     Int       @default(0) @map("total_employees")
  completedEmployees Int       @default(0) @map("completed_employees")
  toolCallCount      Int       @default(0) @map("tool_call_count")
  currentPhase       String?   @map("current_phase") @db.VarChar(30)
  error              String?   @db.Text
  startedAt          DateTime? @map("started_at") @db.Timestamp(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  results AppraisalResult[]
  events  AppraisalEvent[]

  @@index([branchId, createdAt(sort: Desc)])
  @@index([status])
  @@map("appraisal_runs")
}

model AppraisalResult {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String  @map("run_id") @db.Uuid
  employeeId     String? @map("employee_id") @db.Uuid
  // Snapshot fields so results stay renderable if the employee is later removed.
  employeeCode   String  @map("employee_code") @db.VarChar(50)
  employeeName   String  @map("employee_name") @db.VarChar(255)
  position       String? @db.VarChar(100)
  departmentId   String? @map("department_id") @db.Uuid
  departmentName String? @map("department_name") @db.VarChar(255)

  scoresJson       Json?   @map("scores_json") @db.JsonB // {overall, attendance, punctuality, productivity, ...}
  strengthsJson    Json?   @map("strengths_json") @db.JsonB
  improvementsJson Json?   @map("improvements_json") @db.JsonB
  risksJson        Json?   @map("risks_json") @db.JsonB
  summary          String? @db.Text
  recommendation   String? @db.VarChar(30) // PROMOTE|REWARD|MAINTAIN|COACH|PIP
  rankOverall      Int?    @map("rank_overall")
  rankDepartment   Int?    @map("rank_department")
  metricsJson      Json?   @map("metrics_json") @db.JsonB // raw collected aggregates (explainability trail)
  toolCallCount    Int     @default(0) @map("tool_call_count")
  status           String  @default("PENDING") @db.VarChar(20) // PENDING|COMPLETED|DEGRADED|FAILED
  error            String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  run                 AppraisalRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Training nominations derived from this appraisal result (provenance for the
  // appraisal-driven training-needs feature).
  trainingNominations TrainingNomination[]

  @@unique([runId, employeeId])
  @@index([runId, rankOverall])
  @@map("appraisal_results")
}

model AppraisalEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  type      String   @db.VarChar(30)
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  run AppraisalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@map("appraisal_events")
}

model CopilotPendingAction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  messageId      String?   @map("message_id") @db.Uuid // paused assistant CopilotMessage.id
  toolCallId     String    @map("tool_call_id") @db.VarChar(100)
  toolName       String    @map("tool_name") @db.VarChar(150)
  argsJson       Json      @map("args_json") @db.JsonB // server-side source of truth
  previewJson    Json?     @map("preview_json") @db.JsonB
  status         String    @default("PENDING") @db.VarChar(20) // PENDING|CONFIRMED|REJECTED|EXPIRED|FAILED
  resultJson     Json?     @map("result_json") @db.JsonB
  expiresAt      DateTime  @map("expires_at") @db.Timestamp(6)
  createdById    String    @map("created_by_id") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([status, expiresAt])
  @@map("copilot_pending_actions")
}

// =====================================================
// EMPLOYEE LEGAL DOCUMENT LIFECYCLE
// Visa lifecycle management inside the Employee Profile.
// Generic by design: future categories (PASSPORT, WORK_PERMIT,
// EMIRATES_ID, ...) are new enum values, not new tables.
// =====================================================

enum LegalDocumentCategory {
  VISA
  // Government identifiers. A wage file must carry a real national/labour
  // identifier — Employee.idCard cannot be used: the onboarding stepper sets it
  // to employeeCode, so it is an internal code, not a government number.
  LABOUR_CARD
  CIVIL_ID
  NATIONAL_ID
  WORK_PERMIT
  PASSPORT
  EMIRATES_ID
  IQAMA
  QID
  CPR
}

model EmployeeLegalDocument {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  category         LegalDocumentCategory @default(VISA)
  documentNumber   String                @map("document_number") @db.VarChar(100)
  documentType     String                @map("document_type") @db.VarChar(100) // VISA_TYPE library item label
  country          String                @db.VarChar(100)
  nationality      String?               @db.VarChar(2) // ISO-3166 alpha-2 code, employee's nationality at time of visa
  issueDate        DateTime              @map("issue_date") @db.Date
  expiryDate       DateTime              @map("expiry_date") @db.Date
  issuingAuthority String?               @map("issuing_authority") @db.VarChar(200)
  placeOfIssue     String?               @map("place_of_issue") @db.VarChar(200)
  sponsor          String?               @db.VarChar(200)
  remarks          String?               @db.Text

  // Lifecycle: ACTIVE | EXPIRED | RENEWED | CANCELLED.
  // EXPIRING_SOON is derived (expiry within alert window), never stored.
  status    String  @default("ACTIVE") @db.VarChar(30)
  // Exactly one current record per (employee, category, country) —
  // enforced by a partial unique index (WHERE is_current) in the migration.
  isCurrent Boolean @default(true) @map("is_current")

  // Renewal chain: new record points at the record it replaced.
  // Old record becomes status=RENEWED, isCurrent=false. History is never overwritten.
  renewedFromId String? @map("renewed_from_id") @db.Uuid

  // Stamped by the daily expiry-alert cron so each record alerts once.
  expiryAlertSentAt DateTime? @map("expiry_alert_sent_at") @db.Timestamp(6)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  employee    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy   User?                     @relation("LegalDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  renewedFrom EmployeeLegalDocument?    @relation("LegalDocumentRenewalChain", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    EmployeeLegalDocument[]   @relation("LegalDocumentRenewalChain")
  attachments LegalDocumentAttachment[]

  @@index([employeeId, category])
  @@index([category, status])
  @@index([expiryDate])
  @@map("employee_legal_documents")
}

model LegalDocumentAttachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(255)
  fileUrl         String   @map("file_url") @db.Text
  fileSize        BigInt?  @map("file_size")
  mimeType        String?  @map("mime_type") @db.VarChar(100)
  uploadedById    String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamp(6)

  legalDocument EmployeeLegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  uploadedBy    User?                 @relation("LegalDocumentAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([legalDocumentId])
  @@map("legal_document_attachments")
}

// =====================================================
// EXTERNAL ATTENDANCE PROVIDERS
// A branch may delegate attendance capture to an external system (biometric
// vendor, face-recognition analytics platform, ...). We mirror their records
// into `attendances` read-only; our own ESS check-in flow is untouched.
// Provider-agnostic by design: `provider` is a registry key and everything
// vendor-specific lives in `options`, so adding a vendor needs no migration.
// =====================================================
model AttendanceIntegration {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // One provider per branch. Unique, not just indexed: two concurrent syncs
  // writing the same branch would race on the same attendance rows.
  branchId String @unique @map("branch_id") @db.Uuid

  provider    String  @db.VarChar(50) // registry key, e.g. 'fusion-analytics'
  displayName String  @map("display_name") @db.VarChar(100)
  enabled     Boolean @default(false) // cron only picks up enabled rows

  // --- Connection ---
  baseUrl        String  @map("base_url") @db.VarChar(255)
  authScheme     String  @default("header") @map("auth_scheme") @db.VarChar(20) // header | bearer
  authHeaderName String? @map("auth_header_name") @db.VarChar(100)
  // AES-256-GCM at rest (common/crypto/secret-crypto.ts). Never returned to the
  // UI — the read projection exposes only a boolean + a masked hint.
  authSecretEnc  String? @map("auth_secret_enc") @db.Text

  // --- Identity on the remote side ---
  externalBranchId String  @map("external_branch_id") @db.VarChar(100) // e.g. 'TAGGER'
  externalTenantId String? @map("external_tenant_id") @db.VarChar(50) // e.g. '10'

  // Provider-specific knobs, shape declared by the provider's configSchema
  // (calculationVersion, sourceTimezone, pageSize, ...).
  options Json?

  // --- Sync behaviour ---
  conflictPolicy      String  @default("PROVIDER_WINS_SAFE") @map("conflict_policy") @db.VarChar(30)
  syncIntervalMinutes Int     @default(15) @map("sync_interval_minutes")
  // How many days back each cron run re-reads, so late-arriving punches correct
  // an earlier ABSENT instead of being lost.
  lookbackDays        Int     @default(3) @map("lookback_days")
  autoCreateAbsent    Boolean @default(false) @map("auto_create_absent")

  // --- Last-run summary (denormalized from AttendanceSyncRun for cheap display) ---
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamp(6)
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(20) // OK | PARTIAL | ERROR
  lastSyncError  String?   @map("last_sync_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  runs   AttendanceSyncRun[]

  @@index([enabled])
  @@map("attendance_integrations")
}

// One row per sync attempt (cron, manual, or dry run). The operator-facing
// audit trail: what window was read, what was written, and why anything was
// skipped. Kept out of AuditLog because these are system events, not user acts.
model AttendanceSyncRun {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationId String @map("integration_id") @db.Uuid

  trigger     String   @db.VarChar(20) // CRON | MANUAL | DRY_RUN
  windowStart DateTime @map("window_start") @db.Date
  windowEnd   DateTime @map("window_end") @db.Date

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(6)
  status     String    @default("RUNNING") @db.VarChar(20) // RUNNING | OK | PARTIAL | ERROR

  fetched    Int @default(0)
  matched    Int @default(0)
  created    Int @default(0)
  updated    Int @default(0)
  skipped    Int @default(0)
  unmapped   Int @default(0)
  errorCount Int @default(0) @map("error_count")

  // Per-record outcomes, capped in the service so a bad day cannot bloat the row.
  details     Json?
  // User who pressed Sync/Preview. Raw id, no relation — mirrors how
  // AttendanceCorrection.approverId is modelled.
  triggeredBy String? @map("triggered_by") @db.Uuid

  integration AttendanceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt(sort: Desc)])
  @@map("attendance_sync_runs")
}

// =====================================================
// WAGE PROTECTION SYSTEM (WPS) — salary payment files
//
// The HRMS never moves money. It produces the official salary instruction file
// the employer uploads to their bank; the bank validates it and transfers.
//
// Format-agnostic by design: `format` is a registry key and everything
// country-specific lives in JSONB validated against the adapter's declared
// schema, so adding the UAE / KSA / Qatar needs no migration.
//
// Status columns are VARCHAR, not Postgres enums: ALTER TYPE ... ADD VALUE cannot
// run in a transaction, and bank acknowledgement vocabularies differ per country.
// Validation lives in the DTOs (@IsIn) and the registry.
// =====================================================

/// Employer registration as the wage authority knows it.
///
/// Deliberately NOT on Branch: one Ministry establishment registration commonly
/// covers several branches, so putting these on Branch would duplicate them the
/// first time a customer has two offices. And the required fields differ per
/// country (Oman: MoL establishment no + CR; UAE: MOHRE employer id + routing
/// code), which is why `data` is JSONB validated against
/// WpsFormat.employerConfigSchema rather than a fixed column set.
model WpsEmployerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255) // operator-facing label
  legalName String   @map("legal_name") @db.VarChar(255)
  country   String   @db.VarChar(2) // ISO-3166 alpha-2
  format    String   @db.VarChar(50) // registry key this data was validated against
  /// Keys = format.employerConfigSchema[].name. Values of `secret: true` fields are
  /// AES-256-GCM ciphertext (common/crypto/secret-crypto.ts), masked on every read.
  data      Json?    @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  configurations WpsConfiguration[]

  @@index([country, isActive])
  @@map("wps_employer_profiles")
}

/// Which wage-file format a branch pays through, and under which employer.
/// One row per branch (unique, not merely indexed) — two concurrent generations
/// for the same branch would race on the same bank-detail freeze.
model WpsConfiguration {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String   @unique @map("branch_id") @db.Uuid
  employerProfileId String   @map("employer_profile_id") @db.Uuid
  format            String   @db.VarChar(50)
  enabled           Boolean  @default(false)
  /// Defaults for format.runOptionsSchema; overridable per run.
  defaultRunOptions Json?    @map("default_run_options") @db.JsonB
  /// WARNING codes an admin has pre-accepted for this branch. BLOCKING codes can
  /// never appear here — they are not waivable.
  acceptedWarnings  String[] @default([]) @map("accepted_warnings")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch          Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employerProfile WpsEmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Restrict)
  files           WpsFile[]

  @@index([enabled])
  @@map("wps_configurations")
}

/// One generated wage file (or file set).
///
/// Immutable once GENERATED — a correction is a NEW row at version+1 pointing
/// back, mirroring Payroll's own version/previousVersionId convention. The
/// original is never overwritten, because the bank may already hold it.
model WpsFile {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NOT NULL: a wage file always belongs to one employer/branch. A null-branch
  /// (legacy company-wide) payroll spans countries and cannot produce one file.
  branchId        String  @map("branch_id") @db.Uuid
  payrollId       String  @map("payroll_id") @db.Uuid
  configurationId String? @map("configuration_id") @db.Uuid

  format      String @db.VarChar(50)
  /// The adapter's spec revision at generation time, so a historical file always
  /// records which bank layout it was written against.
  specVersion String @map("spec_version") @db.VarChar(100)

  /// GENERATING | GENERATED | FAILED | SUBMITTED | ACKNOWLEDGED
  /// | PARTIALLY_REJECTED | REJECTED | SUPERSEDED | CANCELLED
  status String @default("GENERATING") @db.VarChar(30)

  version           Int     @default(1)
  previousVersionId String? @map("previous_version_id") @db.Uuid

  // --- The artifact ---
  fileName   String? @map("file_name") @db.VarChar(255)
  /// `private://…` ref from StorageService. NOT a URL — deliberately not
  /// representable as one. Reachable only via GET /secure-files/wps-file/:id.
  privateRef String? @map("private_ref") @db.Text
  mimeType   String? @map("mime_type") @db.VarChar(100)
  byteSize   Int?    @map("byte_size")
  /// SHA-256 of the PRIMARY artifact's bytes — the tamper fingerprint.
  sha256     String? @db.VarChar(64)
  /// Companion artifacts: [{ fileName, privateRef, mimeType, byteSize, sha256 }]
  companions Json?   @db.JsonB

  // --- Contents ---
  employeeCount    Int      @default(0) @map("employee_count")
  /// Integer MINOR units (baisa/fils), summed from wps_file_rows.net_minor.
  /// Never derived from payrolls.total_amount: the file's header total must equal
  /// the sum of its own detail rows, which is what a bank validator recomputes.
  totalMinor       Decimal  @default(0) @map("total_minor") @db.Decimal(24, 0)
  currency         String   @db.VarChar(3)
  currencyExponent Int      @map("currency_exponent")
  paymentDate      DateTime @map("payment_date") @db.Date
  periodMonth      Int      @map("period_month")
  periodYear       Int      @map("period_year")

  // --- Snapshots: what was true AT generation, not what is true now ---
  runOptions        Json? @map("run_options") @db.JsonB
  employerSnapshot  Json? @map("employer_snapshot") @db.JsonB // secrets stripped
  preflightSnapshot Json? @map("preflight_snapshot") @db.JsonB // incl. accepted WARNINGs

  // --- Lifecycle ---
  generatedBy     String   @map("generated_by") @db.Uuid
  generatedAt     DateTime @default(now()) @map("generated_at") @db.Timestamp(6)
  generationError String?  @map("generation_error") @db.Text

  submittedBy         String?   @map("submitted_by") @db.Uuid
  submittedAt         DateTime? @map("submitted_at") @db.Timestamp(6)
  submissionReference String?   @map("submission_reference") @db.VarChar(120)

  bankResponseAt    DateTime? @map("bank_response_at") @db.Timestamp(6)
  bankResponseRef   String?   @map("bank_response_ref") @db.VarChar(120)
  bankResponseNotes String?   @map("bank_response_notes") @db.Text
  rejectedCount     Int       @default(0) @map("rejected_count")
  recordedBy        String?   @map("recorded_by") @db.Uuid

  downloadCount Int @default(0) @map("download_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payroll         Payroll           @relation(fields: [payrollId], references: [id], onDelete: Restrict)
  configuration   WpsConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  previousVersion WpsFile?          @relation("WpsFileVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    WpsFile[]         @relation("WpsFileVersions")
  rows            WpsFileRow[]

  // Partial unique index enforced in migration (concurrency guard — only one
  // generation may be in flight per payroll):
  //   CREATE UNIQUE INDEX uniq_wps_generating_per_payroll
  //     ON wps_files(payroll_id) WHERE status = 'GENERATING';
  @@unique([payrollId, version], name: "unique_wps_payroll_version")
  @@index([branchId, status])
  @@index([payrollId])
  @@index([status])
  @@map("wps_files")
}

/// Per-employee snapshot of what the file actually told the bank.
///
/// Required, not optional: bank rejections are PER ROW, so PARTIALLY_REJECTED has
/// nowhere to hang a per-employee code without this; createRevision() creates NEW
/// PayrollItem ids, so a v2-vs-v1 diff would lose its link; and support must be
/// able to answer "was X in the January file, for how much, to which account"
/// without downloading and parsing a live payment file.
///
/// Stores bank_detail_id, NOT the IBAN: EmployeeBankDetail rows are append-only
/// (deactivated, never mutated), so the FK reproduces the exact account that was
/// paid without duplicating the sensitive value.
model WpsFileRow {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wpsFileId     String  @map("wps_file_id") @db.Uuid
  employeeId    String  @map("employee_id") @db.Uuid
  payrollItemId String? @map("payroll_item_id") @db.Uuid
  bankDetailId  String? @map("bank_detail_id") @db.Uuid
  sequence      Int // 1-based position in the file

  employeeCodeSnapshot String  @map("employee_code_snapshot") @db.VarChar(50)
  employeeNameSnapshot String  @map("employee_name_snapshot") @db.VarChar(255)
  /// { LABOUR_CARD: '…', CIVIL_ID: '…' } — masked in every read projection.
  identifierSnapshot   Json?   @map("identifier_snapshot") @db.JsonB
  bankCodeSnapshot     String? @map("bank_code_snapshot") @db.VarChar(20)
  /// maskAccount() output only — last 4. Never the full number.
  accountMasked        String? @map("account_masked") @db.VarChar(40)

  basicMinor      Decimal @default(0) @map("basic_minor") @db.Decimal(24, 0)
  allowancesMinor Decimal @default(0) @map("allowances_minor") @db.Decimal(24, 0)
  deductionsMinor Decimal @default(0) @map("deductions_minor") @db.Decimal(24, 0)
  netMinor        Decimal @map("net_minor") @db.Decimal(24, 0)
  currency        String  @db.VarChar(3)

  /// INCLUDED | ACCEPTED | REJECTED
  status          String  @default("INCLUDED") @db.VarChar(20)
  rejectionCode   String? @map("rejection_code") @db.VarChar(50)
  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  wpsFile     WpsFile             @relation(fields: [wpsFileId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollItem PayrollItem?        @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  bankDetail  EmployeeBankDetail? @relation(fields: [bankDetailId], references: [id], onDelete: SetNull)

  @@unique([wpsFileId, employeeId], name: "unique_wps_file_employee")
  @@index([wpsFileId, status])
  @@index([employeeId])
  @@map("wps_file_rows")
}

// ── Employee Profile Template ───────────────────────────────────────────────
// Replaces the hardcoded employee form. The set of fields, their labels, order,
// sections, requiredness and per-role visibility are DATA; the code only knows
// HOW to render and validate each named field type. Generalizes the pattern
// CountryBankingField already proved for bank details.
//
// Storage is HYBRID and deliberately so: a template field either binds to a real
// column on employees/employee_profiles (see EMPLOYEE_BOUND_COLUMNS) or lives in
// employees.custom_fields JSONB. Payroll, WPS wage files, letters and exports
// read the columns, so those may be relabelled and reordered but never dropped.

/// One template per scope. The COMPANY row (branch_id NULL) is the fallback; a
/// BRANCH row overrides it wholesale for that branch — a full copy rather than a
/// sparse delta, because branches genuinely differ by country (Branch.country).
///
/// Partial unique indexes are raw SQL only (migration 20260807120000):
///   uniq_profile_template_company : ((true))    WHERE scope='COMPANY' AND is_active
///   uniq_profile_template_branch  : (branch_id) WHERE scope='BRANCH'  AND is_active
model ProfileTemplate {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope    String  @db.VarChar(10) // COMPANY | BRANCH
  branchId String? @map("branch_id") @db.Uuid // NULL for COMPANY
  /// The country preset this template was seeded from (ISO-2). Drives which
  /// defaults the seeder reconciles against on every boot.
  country  String? @db.VarChar(2)
  name     String  @db.VarChar(150)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch   Branch?                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sections ProfileTemplateSection[]
  fields   ProfileTemplateField[]

  @@index([scope, isActive])
  @@index([branchId, isActive])
  @@map("profile_templates")
}

/// A group of fields. `wizardStep` groups sections into steps of the employee
/// create wizard, so an admin can regroup the wizard without a code change.
model ProfileTemplateSection {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  /// Stable identity. Never renamed — `label` is what the admin edits.
  sectionKey String  @map("section_key") @db.VarChar(50)
  label      String  @db.VarChar(150)
  /// lucide-react icon name, rendered by the frontend section header.
  icon       String? @db.VarChar(50)

  wizardStep   Int @default(1) @map("wizard_step")
  columns      Int @default(2)
  displayOrder Int @default(0) @map("display_order")

  isActive       Boolean  @default(true) @map("is_active")
  /// [] = visible to every role.
  visibleToRoles String[] @default([]) @map("visible_to_roles")

  origin       String  @default("SYSTEM") @db.VarChar(10) // SYSTEM | CUSTOM
  /// Set by any admin write. Once true the boot seeder never touches this row.
  isCustomized Boolean @default(false) @map("is_customized")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  template ProfileTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   ProfileTemplateField[]

  @@unique([templateId, sectionKey])
  @@index([templateId, displayOrder])
  @@map("profile_template_sections")
}

/// One configured field. Everything except `fieldKey` is admin-editable.
model ProfileTemplateField {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  sectionId  String @map("section_id") @db.Uuid
  /// IMMUTABLE: stored values are keyed by it, and for bound fields it is also
  /// the DTO property name so validation errors land on the right form control.
  fieldKey   String @map("field_key") @db.VarChar(60)
  label      String @db.VarChar(150)
  fieldType  String @default("TEXT") @map("field_type") @db.VarChar(25)

  /// COLUMN => routed through EMPLOYEE_BOUND_COLUMNS to a real column.
  /// JSONB  => employees.custom_fields[fieldKey]. Admin-created fields are
  /// always JSONB; the API refuses to create a COLUMN field.
  storage     String  @default("JSONB") @db.VarChar(10)
  /// Denormalized for reads and for the builder UI. The code registry is truth.
  boundColumn String? @map("bound_column") @db.VarChar(80)

  validationType String   @default("NONE") @map("validation_type") @db.VarChar(25)
  regex          String?  @db.Text
  minValue       Decimal? @map("min_value") @db.Decimal(18, 4)
  maxValue       Decimal? @map("max_value") @db.Decimal(18, 4)
  minLength      Int?     @map("min_length")
  maxLength      Int?     @map("max_length")
  required       Boolean  @default(false)

  /// Static [{value,label}] choices; ignored when optionSource is set.
  options      Json?   @db.JsonB
  /// Live option source: a LibraryType name, or DEPARTMENT | BRANCH | EMPLOYEE.
  optionSource String? @map("option_source") @db.VarChar(40)

  placeholder  String? @db.VarChar(255)
  helpText     String? @map("help_text") @db.VarChar(500)
  defaultValue String? @map("default_value") @db.Text
  colSpan      Int     @default(1) @map("col_span")
  displayOrder Int     @default(0) @map("display_order")

  /// [] = every role. Enforced in the service on BOTH read and write, because
  /// the check needs the resolved template and so cannot live in a guard.
  visibleToRoles  String[] @default([]) @map("visible_to_roles")
  editableByRoles String[] @default([]) @map("editable_by_roles")
  /// What an employee may see / change on their own record. `selfEditable`
  /// replaces the hardcoded allowlist that used to sit in EmployeesController.
  selfVisible     Boolean  @default(true) @map("self_visible")
  selfEditable    Boolean  @default(false) @map("self_editable")

  isSensitive         Boolean @default(false) @map("is_sensitive")
  isActive            Boolean @default(true) @map("is_active")
  includeInCompletion Boolean @default(false) @map("include_in_completion")

  // ── Provenance: how a shipped preset update avoids clobbering admin edits ──
  origin           String  @default("SYSTEM") @db.VarChar(10) // SYSTEM | CUSTOM
  systemRevision   Int     @default(1) @map("system_revision")
  /// Set by any admin write. Once true the boot seeder skips this row forever,
  /// which is what makes "our v2 must not overwrite their customization" true.
  /// An admin "deleting" a system field sets isActive=false AND this, so the
  /// create-only upsert can never resurrect it.
  isCustomized     Boolean @default(false) @map("is_customized")
  /// We stopped shipping this field. Flagged, never deleted — stored values in
  /// the bound column or the JSONB bag must survive.
  systemDeprecated Boolean @default(false) @map("system_deprecated")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  template ProfileTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section  ProfileTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldKey])
  @@index([templateId, isActive])
  @@index([sectionId, displayOrder])
  @@map("profile_template_fields")
}

/// Telegram chat -> ESS user.
///
/// Third delivery channel, same shape as DiscordIdentity. The one Telegram
/// specific: a bot cannot open a conversation, the human must press Start
/// first, so the PRIVATE CHAT ID is what we actually send to and it is the
/// unique key. For a private chat that id equals the user id, but they are
/// different concepts and a group chat id is negative — storing the chat id
/// keeps the send path honest about what it holds.
model TelegramIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId     String  @map("user_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid

  /// Private chat id — the sendMessage target. Unique: one Telegram chat is one
  /// person, the rule both other channels apply to a handset / an account.
  telegramChatId String  @unique @map("telegram_chat_id") @db.VarChar(32)
  /// Telegram user id. Equals the chat id for a private chat; kept separately
  /// because a future group feature would break that assumption.
  telegramUserId String? @map("telegram_user_id") @db.VarChar(32)
  /// Denormalised for the admin roster; Telegram usernames change and are optional.
  username       String? @map("username") @db.VarChar(64)

  /// PENDING (code issued, not yet redeemed) | ACTIVE | REVOKED
  status String @default("PENDING") @db.VarChar(20)

  /// One-time linking code, hashed. Never stored in the clear.
  linkCodeHash  String?   @map("link_code_hash") @db.VarChar(255)
  linkExpiresAt DateTime? @map("link_expires_at") @db.Timestamp(6)
  linkedAt      DateTime? @map("linked_at") @db.Timestamp(6)

  optedIn    Boolean   @default(true) @map("opted_in")
  optedOutAt DateTime? @map("opted_out_at") @db.Timestamp(6)

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamp(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation("UserTelegramIdentities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([employeeId])
  @@index([status])
  @@map("telegram_identities")
}

/// Outbound Telegram message log.
///
/// Mirrors discord_messages: the row is the claim, the payload and the delivery
/// record, because this repo still has no queue infrastructure.
///
/// `user_id` is nullable here for a reason the other two channels do not have —
/// a login alert to the ops group is addressed to a CHAT, not to a person, and
/// a failed login may not correspond to any user at all.
model TelegramMessage {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  dedupeKey String @unique @map("dedupe_key") @db.VarChar(200)

  userId     String? @map("user_id") @db.Uuid
  employeeId String? @map("employee_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid
  /// Target chat. A negative value is a group; that is how alerts are addressed.
  chatId     String  @map("chat_id") @db.VarChar(32)

  templateKey      String  @map("template_key") @db.VarChar(60)
  notificationType String? @map("notification_type") @db.VarChar(50)
  /// Telegram HTML. Rendered at enqueue so a template change cannot rewrite history.
  body             String  @db.Text

  status            String    @default("QUEUED") @db.VarChar(20)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamp(6)
  lockedAt          DateTime? @map("locked_at") @db.Timestamp(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamp(6)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(64)
  lastError         String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("telegram_messages")
}

// =====================================================
// DYNAMIC DOCUMENT ENGINE
//
// One renderer for every PDF the portal emits, replacing the per-module
// approach that produced exactly one PDF (letters) in four years.
//
// The document TYPE catalogue is CODE (src/documents/document-types.ts), not a
// table. A type an admin could create would be a row that no context resolver
// backs — it would list in the UI, accept a template, and then fail at
// generation with nothing to populate it. That is the "setting an admin can
// see but nothing reads" defect CLAUDE.md §4 names. Templates are rows;
// types are not.
// =====================================================

/// Template identity. Stable across every publish, so a document generated two
/// years ago can still name the template it came from.
///
/// The wording lives in versions, never here — this row holds only what does
/// not change when an admin rewrites a paragraph.
model DocumentTemplate {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Key into DOCUMENT_TYPES. VarChar rather than an enum for the same reason
  /// LetterTemplate.key is: the catalogue is code and grows without a migration.
  typeKey String @map("type_key") @db.VarChar(50)
  locale  String @default("en") @db.VarChar(5)

  /// COMPANY | BRANCH — the ProfileTemplate override pattern.
  scope    String  @db.VarChar(10)
  /// NULL for COMPANY. A branch with no row of its own resolves to the COMPANY
  /// row, which is why BRANCH_SCOPE registers this as 'direct-or-global':
  /// plain 'direct' would hide the company template from every branch, because
  /// NULL never matches an IN (...) list.
  branchId String? @map("branch_id") @db.Uuid

  name        String  @db.VarChar(200)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  /// The one version that rendering uses. NULL until first publish — a
  /// template with only a draft cannot generate anything, which is the point:
  /// half-finished wording must not be able to reach a bank.
  publishedVersionId String? @unique @map("published_version_id") @db.Uuid

  /// SYSTEM rows are reconciled by the boot seeder; once an admin writes,
  /// isCustomized is set and the seeder never touches the row again. Same
  /// contract as ProfileTemplateSection.isCustomized.
  origin       String  @default("SYSTEM") @db.VarChar(10) // SYSTEM | CUSTOM
  isCustomized Boolean @default(false) @map("is_customized")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch           Branch?                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  publishedVersion DocumentTemplateVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         DocumentTemplateVersion[] @relation("TemplateVersions")

  @@index([typeKey, locale, isActive])
  @@index([scope, isActive])
  @@index([branchId, isActive])
  @@map("document_templates")
}

/// An immutable snapshot of wording and layout, once published.
///
/// Two partial unique indexes (see the migration) enforce at most one DRAFT and
/// at most one PUBLISHED row per template. They are the concurrency rule: two
/// admins publishing at once fail at the database rather than racing in a
/// service method.
model DocumentTemplateVersion {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  /// 1-based and monotonic per template. Printed in the version picker and in
  /// audit rows, so it must not be inferred from createdAt ordering — two rows
  /// created in the same millisecond would then be unorderable.
  versionNo  Int    @map("version_no")

  // DRAFT | PUBLISHED | ARCHIVED
  status String @default("DRAFT") @db.VarChar(20)

  /// What the visual builder reads and writes: the block document. The SOURCE
  /// OF TRUTH for an admin-authored template.
  ///
  /// NULL for a template authored before the builder existed (the migrated
  /// letters), which carry hand-written bodyHtml instead. Rendering never reads
  /// this field, so both kinds render through one path.
  docJson Json? @map("doc_json") @db.JsonB

  /// Compiled from docJson and ALREADY SANITIZED, at save time, so what is
  /// stored is what was approved. Never trusted again at render.
  bodyHtml   String  @map("body_html") @db.Text
  /// Admin-owned CSS. The envelope's base CSS is prepended and cannot be
  /// removed — an admin must not be able to delete the Arabic font stack and
  /// turn every Arabic letter into tofu.
  styleCss   String? @map("style_css") @db.Text
  /// Repeating page footer. Rendered into page.pdf's footerTemplate, NOT into
  /// the body: Chromium is the only thing that knows the page count, and CSS
  /// paged-media margin boxes are unsupported.
  footerHtml String? @map("footer_html") @db.Text

  pageFormat  String @default("A4") @map("page_format") @db.VarChar(10) // A4 | A5 | Letter | Legal
  orientation String @default("PORTRAIT") @db.VarChar(10) // PORTRAIT | LANDSCAPE
  /// {top,right,bottom,left} in mm.
  marginsMm   Json?  @map("margins_mm") @db.JsonB

  /// Letterhead pinned to THIS version, not to the template: changing
  /// stationery is a publish, and last year's letters must still show last
  /// year's letterhead.
  letterheadId String? @map("letterhead_id") @db.Uuid

  /// sha256 over the rendered inputs. Copied onto every generated document, so
  /// the trace survives even the row deletion that onDelete: Restrict prevents.
  contentHash String @map("content_hash") @db.VarChar(64)

  changeNote    String?   @map("change_note") @db.Text
  createdById   String?   @map("created_by_id") @db.Uuid
  publishedById String?   @map("published_by_id") @db.Uuid
  publishedAt   DateTime? @map("published_at") @db.Timestamp(6)
  archivedAt    DateTime? @map("archived_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  template     DocumentTemplate    @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  publishedFor DocumentTemplate?   @relation("PublishedVersion")
  letterhead   DocumentAsset?      @relation(fields: [letterheadId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("DocTemplateVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy  User?               @relation("DocTemplateVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  documents    GeneratedDocument[]

  @@unique([templateId, versionNo])
  @@index([templateId, status])
  @@map("document_template_versions")
}

/// Letterhead artwork, signature images, seals.
///
/// PRIVATE bucket only. The public bucket carries an allow-all s3:GetObject
/// policy, and StorageService says outright that an unguessable filename is
/// not protection. A letterhead is the artwork that makes a document look
/// authentic to a bank; world-readable stationery is a forgery kit. The
/// renderer never needs a URL for it — the bytes are inlined as a data: URI.
model DocumentAsset {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind     String  @db.VarChar(20) // LETTERHEAD | SIGNATURE | SEAL
  name     String  @db.VarChar(200)
  scope    String  @db.VarChar(10) // COMPANY | BRANCH
  branchId String? @map("branch_id") @db.Uuid

  privateRef String @map("private_ref") @db.Text
  mimeType   String @map("mime_type") @db.VarChar(100)
  fileSize   BigInt @map("file_size")
  /// sha256. Doubles as the cache key for the inlined data: URI (immutable, so
  /// it never needs invalidating) and as proof that the artwork behind a
  /// published version never changed underneath it.
  contentHash String @map("content_hash") @db.VarChar(64)
  widthPx     Int?   @map("width_px")
  heightPx    Int?   @map("height_px")

  /// Continuation-page artwork. NULL means page 1's design is used throughout —
  /// most companies have a lighter continuation sheet, and getting that wrong
  /// is the commonest real-world letterhead defect.
  contPrivateRef  String? @map("cont_private_ref") @db.Text
  contContentHash String? @map("cont_content_hash") @db.VarChar(64)

  /// Content-safe area in mm, measured off the artwork by whoever uploads it.
  /// The renderer pads the content wrapper by these, so body text can never sit
  /// on the letterhead's own logo or footer strip.
  safeTopMm    Decimal @default(35) @map("safe_top_mm") @db.Decimal(6, 2)
  safeRightMm  Decimal @default(18) @map("safe_right_mm") @db.Decimal(6, 2)
  safeBottomMm Decimal @default(25) @map("safe_bottom_mm") @db.Decimal(6, 2)
  safeLeftMm   Decimal @default(18) @map("safe_left_mm") @db.Decimal(6, 2)

  isActive    Boolean @default(true) @map("is_active")
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch      Branch?                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy   User?                     @relation("DocumentAssetAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  versions    DocumentTemplateVersion[]
  signatories DocumentSignatory[]

  @@index([kind, isActive])
  @@index([scope, isActive])
  @@index([branchId, isActive])
  @@map("document_assets")
}

/// Who signs a document, with what image.
///
/// A table rather than a CSV setting because a signatory has a name, a title,
/// an ordering, a branch AND a signature image. Packing six fields plus a file
/// reference into a comma-separated string would need a parser, and would be a
/// setting that lies about its own shape.
model DocumentSignatory {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope    String  @db.VarChar(10) // COMPANY | BRANCH
  branchId String? @map("branch_id") @db.Uuid
  name     String  @db.VarChar(200)
  title    String  @db.VarChar(200)
  /// Stable key a template references, e.g. {{signatory.hr.name}}. Never
  /// renamed — `name` is what the admin edits.
  slotKey  String  @map("slot_key") @db.VarChar(40) // hr | finance | ceo | branch_manager

  signatureAssetId String? @map("signature_asset_id") @db.Uuid
  displayOrder     Int     @default(0) @map("display_order")
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  signatureAsset DocumentAsset? @relation(fields: [signatureAssetId], references: [id], onDelete: SetNull)

  @@unique([slotKey, branchId])
  @@index([scope, isActive])
  @@index([branchId, isActive])
  @@map("document_signatories")
}

/// One rendered artefact: what was produced, from which pinned version, for
/// whom, by whom, and where the bytes are.
model GeneratedDocument {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeKey String @map("type_key") @db.VarChar(50)
  locale  String @default("en") @db.VarChar(5)

  /// The branch that ISSUED it — deliberately NOT the employee's current
  /// branch. A transfer afterwards must not retroactively move a document
  /// already sent to a bank. NOT NULL, and stamped explicitly by the service:
  /// PrismaService only auto-stamps branchId when effectiveBranchId is
  /// non-null, and a global admin who has not narrowed the picker has null.
  branchId String @map("branch_id") @db.Uuid

  /// The pinned version. Restrict, not Cascade: deleting the version a
  /// document was rendered from would erase why the document says what it says.
  templateVersionId   String? @map("template_version_id") @db.Uuid
  /// Copied, so the trace survives even the delete Restrict is meant to
  /// prevent. NULL for pre-engine letters, which were never backfilled —
  /// inventing a pin for them would be a false trace.
  templateContentHash String? @map("template_content_hash") @db.VarChar(64)

  /// Whom it is about. NULL for company-wide artefacts (a payroll register).
  employeeId String? @map("employee_id") @db.Uuid
  /// Pointer at the record the document describes: a payrollItemId, a loanId, a
  /// settlementId. Interpreted by the type's resolver, never joined.
  subjectType String? @map("subject_type") @db.VarChar(40)
  subjectId   String? @map("subject_id") @db.Uuid
  /// The exact params it was generated with (month, year, date range).
  /// Reproducibility: version + subject + params regenerates the same document.
  params      Json?   @db.JsonB

  /// Printed on the document and verifiable. Shares a namespace with letter
  /// serials so old and new documents verify through one route.
  serialNumber String? @unique @map("serial_number") @db.VarChar(50)

  privateRef String @map("private_ref") @db.Text
  fileName   String @map("file_name") @db.VarChar(255)
  fileSize   BigInt @map("file_size")
  pageCount  Int?   @map("page_count")

  /// The vault row, when this document belongs in an employee's file.
  employeeDocumentId String? @map("employee_document_id") @db.Uuid
  /// Set when the batch drainer produced it.
  batchId            String? @map("batch_id") @db.Uuid

  generatedById String   @map("generated_by_id") @db.Uuid
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch           Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  version          DocumentTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  employee         Employee?                @relation("GeneratedDocumentSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeDocument EmployeeDocument?        @relation(fields: [employeeDocumentId], references: [id], onDelete: SetNull)
  batch            DocumentBatch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  generatedBy      User                     @relation("GeneratedDocumentAuthor", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([typeKey, generatedAt])
  @@index([employeeId, typeKey])
  @@index([branchId, generatedAt])
  @@index([batchId])
  @@map("generated_documents")
}

/// A bulk run. Outbox table plus a cron drainer — the in-house async pattern
/// (WhatsAppMessage + whatsapp-outbox.scheduler.ts). There is no Bull, no
/// Redis and no job table in this codebase, and adding one to render PDFs
/// would be a new piece of infrastructure for a problem the repo has already
/// answered twice.
model DocumentBatch {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeKey           String @map("type_key") @db.VarChar(50)
  locale            String @default("en") @db.VarChar(5)
  branchId          String @map("branch_id") @db.Uuid
  templateVersionId String @map("template_version_id") @db.Uuid

  // QUEUED | RUNNING | COMPLETED | COMPLETED_WITH_ERRORS | FAILED | CANCELLED
  //
  // COMPLETED_WITH_ERRORS is a distinct state on purpose. A run that quietly
  // reports COMPLETED while eleven employees got nothing is the failure mode
  // this whole table exists to prevent.
  status String @default("QUEUED") @db.VarChar(25)
  // MERGED | INDIVIDUAL
  deliveryMode String @default("INDIVIDUAL") @map("delivery_mode") @db.VarChar(15)

  params Json? @db.JsonB

  totalCount  Int @default(0) @map("total_count")
  doneCount   Int @default(0) @map("done_count")
  failedCount Int @default(0) @map("failed_count")

  /// MERGED only: the single concatenated PDF.
  resultRef      String? @map("result_ref") @db.Text
  resultFileName String? @map("result_file_name") @db.VarChar(255)

  /// Set when a worker claims the row. A row RUNNING longer than the stale
  /// window is reclaimed by the sweep, as the WhatsApp outbox does.
  claimedAt  DateTime? @map("claimed_at") @db.Timestamp(6)
  startedAt  DateTime? @map("started_at") @db.Timestamp(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(6)
  lastError  String?   @map("last_error") @db.Text

  requestedById String @map("requested_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy User                @relation("DocumentBatchRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  items       DocumentBatchItem[]
  documents   GeneratedDocument[]

  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@map("document_batches")
}

model DocumentBatchItem {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId String @map("batch_id") @db.Uuid

  employeeId String? @map("employee_id") @db.Uuid
  subjectId  String? @map("subject_id") @db.Uuid

  // PENDING | RENDERING | DONE | FAILED | SKIPPED
  status   String @default("PENDING") @db.VarChar(15)
  attempts Int    @default(0)
  /// The refusal, verbatim. A batch that silently drops people is worse than
  /// one that says which people and why.
  lastError String? @map("last_error") @db.Text

  generatedDocumentId String? @map("generated_document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  batch    DocumentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee Employee?     @relation("DocumentBatchSubject", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@map("document_batch_items")
}
