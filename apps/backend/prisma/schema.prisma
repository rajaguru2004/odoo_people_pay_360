/// Whether a leave type can be turned into money, and whether it survives a
/// year end.
///
/// One model for two features because they are two ways of answering the same
/// question — what happens to leave an employee did not take — and splitting
/// them would mean two places to look when the answer is wrong. Each half is
/// behind its own flag.
///
/// `branchId` NULL is the company-wide default. Postgres treats NULLs as
/// distinct in a composite unique, so uniqueness is enforced by two PARTIAL
/// indexes in the migration rather than by `@@unique` here — the same trap
/// migration 20260805100000 exists to fix on `payrolls`.
model LeaveTypePolicy {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Matches `LibraryItem.label`, exactly as `LeaveTypeBalance.leaveTypeKey` does.
  leaveTypeKey String  @map("leave_type_key") @db.VarChar(100)
  branchId     String? @map("branch_id") @db.Uuid

  encashable           Boolean @default(false)
  maxEncashDaysPerYear Int?    @map("max_encash_days_per_year")
  /// BASIC | GROSS — which figure a day of leave is priced from.
  encashBasis          String  @default("BASIC") @map("encash_basis") @db.VarChar(10)
  /// Divisor turning a monthly figure into a daily one.
  monthDays            Decimal @default(30) @map("month_days") @db.Decimal(6, 3)
  /// Only leave already accrued may be encashed, not the whole allocation.
  accruedOnly          Boolean @default(true) @map("accrued_only")
  allowInService       Boolean @default(true) @map("allow_in_service")
  allowOnExit          Boolean @default(true) @map("allow_on_exit")

  carryForwardEnabled      Boolean @default(false) @map("carry_forward_enabled")
  carryForwardMaxDays      Int?    @map("carry_forward_max_days")
  carryForwardExpiryMonths Int?    @map("carry_forward_expiry_months")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([leaveTypeKey])
  @@map("leave_type_policies")
}

/// One execution of the year-end carry-forward.
///
/// The most dangerous operation in this area: it rewrites every employee's
/// balance. So it records what it did, stamps every row it touched, and can be
/// reversed exactly — and the unique key means running it twice cannot double
/// anyone's balance.
model LeaveCarryForwardRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  fromYear      Int       @map("from_year")
  toYear        Int       @map("to_year")
  leaveTypeKeys String[]  @map("leave_type_keys")
  employeeCount Int       @default(0) @map("employee_count")
  daysCarried   Decimal   @default(0) @map("days_carried") @db.Decimal(10, 2)
  daysLapsed    Decimal   @default(0) @map("days_lapsed") @db.Decimal(10, 2)
  /// APPLIED | REVERSED
  status        String    @default("APPLIED") @db.VarChar(20)
  workingJson   Json      @map("working_json") @db.JsonB
  executedBy    String?   @map("executed_by") @db.Uuid
  executedAt    DateTime  @default(now()) @map("executed_at") @db.Timestamp(6)
  reversedBy    String?   @map("reversed_by") @db.Uuid
  reversedAt    DateTime? @map("reversed_at") @db.Timestamp(6)

  @@unique([branchId, fromYear, toYear])
  @@map("leave_carry_forward_runs")
}

