# ─────────────────────────────────────────────────────────────────────────────
# Backend environment for the e2e suite.
#
# A SEPARATE DATABASE, on a separate port, is the whole point: the e2e run
# truncates and reseeds, and pointing it at the dev database would delete
# whatever you were working on. Copy to `.env.test` (git-ignored) and start the
# stack with `npm run e2e:up` from the repo root.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:8174/people_pay_360_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:8174/people_pay_360_test?schema=public"

PORT=3411
NODE_ENV="test"
CORS_ORIGIN="http://127.0.0.1:3410"

JWT_SECRET="e2e-only-signing-key"
JWT_EXPIRES_IN="1d"

SEED_ADMIN_EMAIL="admin@peoplepay360.com"
SEED_ADMIN_PASSWORD="Admin@123"

STORAGE_ENABLED="false"
MAIL_ENABLED="false"
ODOO_ENABLED="false"
