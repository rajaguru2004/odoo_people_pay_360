# ─────────────────────────────────────────────────────────────────────────────
# People Pay 360 — Backend environment
#
# Copy to `.env` and fill in. `.env` is TRACKED in this repo and holds
# local-dev defaults only; anything that is a real secret belongs in the
# deployment's own environment (docker-compose `environment:` / CI secrets),
# never in a committed file.
#
# PORTS ARE OFFSET FROM THE HRM/ESS CHECKOUT ON PURPOSE. Both stacks run on the
# same workstation, so this one uses 3011 (API), 3010 (portal), 8074 (Postgres)
# and 9014 (MinIO) instead of 3001 / 3000 / 8068 / 9009. Nothing else differs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection the app runs on; DIRECT_URL is the
# unpooled one Prisma needs for migrations/introspection. They are identical
# for a plain local Postgres and diverge only behind a pooler (pgbouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:8074/people_pay_360?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:8074/people_pay_360?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3011
NODE_ENV="development"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3010"

# ── JWT ──────────────────────────────────────────────────────────────────────
# The app REFUSES TO BOOT on a blank JWT_SECRET (see common/config/require-secret.ts).
# That is deliberate: a defaulted signing key means every deployment that forgot
# to set one shares it, and any of them can mint a token for all the others.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-in-production-openssl-rand-base64-48"
JWT_EXPIRES_IN="7d"

# ── Seed / bootstrap admin ───────────────────────────────────────────────────
# Used ONCE by prisma/seed.ts to create the first administrator. The seed
# upserts, so re-running it never duplicates the account — but it also never
# resets a password that has since been changed in the app.
SEED_ADMIN_EMAIL="admin@peoplepay360.com"
SEED_ADMIN_PASSWORD="Admin@123"

# ── Object storage (MinIO / S3-compatible) ───────────────────────────────────
# Host-side values. docker-compose overrides them with the in-network ones —
# inside a container `localhost` is the container itself, which is the classic
# "Connection timeout" at boot while MinIO was up the whole time.
STORAGE_ENABLED="false"
MINIO_ENDPOINT="localhost"
MINIO_PORT=9014
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="StrongPassword@123"
MINIO_BUCKET="people-pay-360"
# Address a BROWSER uses for public objects. Without it, stored URLs would read
# http://minio:9000/... and resolve nowhere outside the compose network.
MINIO_PUBLIC_URL="http://localhost:9014"

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_ENABLED="false"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_FROM="noreply@peoplepay360.com"
MAIL_FROM_NAME="People Pay 360"

# ── Odoo integration ─────────────────────────────────────────────────────────
# External Odoo instance this platform syncs employees / payroll journals with.
# Disabled until a URL and API key are present; every call is a no-op while off,
# so a checkout with no Odoo reachable still boots and serves the whole app.
ODOO_ENABLED="false"
ODOO_BASE_URL=""             # e.g. https://odoo.example.com
ODOO_DB=""                   # Odoo database name
ODOO_USERNAME=""
ODOO_API_KEY=""              # Odoo API key / password for the integration user

# ── Settings encryption ──────────────────────────────────────────────────────
# Master secret used to encrypt integration credentials stored in the
# system_settings table. Kept OUT of the database it protects, and separate
# from JWT_SECRET so a leaked token key cannot decrypt stored credentials.
SETTINGS_ENCRYPTION_KEY=""   # 32+ random chars; falls back to JWT_SECRET if blank
