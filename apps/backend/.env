# ─────────────────────────────────────────────────────────────────────────────
# People Pay 360 — backend, HOST-side local development values.
#
# These are the values used by `npm run dev`, prisma and jest running ON THE
# HOST. docker-compose.yml loads this file too, but its `environment:` block
# overrides DATABASE_URL/DIRECT_URL/MINIO_* with the in-network addresses —
# `localhost` inside a container is the container itself.
#
# Local-dev defaults only. Nothing real belongs in here.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 3011, not 3001: offset from the HRM/ESS checkout so both stacks run at once.
PORT=3011
TZ=Asia/Muscat

# ── Database ─────────────────────────────────────────────────────────────────
# 8074 is the host port ppx_postgres publishes for its internal 5432.
# DIRECT_URL must match DATABASE_URL — `prisma db push` connects through the
# direct URL, so a mismatch pushes the schema at a different database than the
# one the running server reads.
DATABASE_URL="postgresql://postgres:postgres@localhost:8074/people_pay_360?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:8074/people_pay_360?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Mandatory: auth.module.ts refuses to boot without it.
JWT_SECRET="local-dev-only-not-a-real-secret-change-me"
JWT_EXPIRES_IN="7d"

# Decrypts the API keys stored in system_settings, so it cannot live in the same
# database. Blank falls back to JWT_SECRET; changing it makes anything already
# encrypted unreadable.
SETTINGS_ENCRYPTION_KEY="+nfoyqZfZ41eScQXV5w6NVRgLkqh8LOEyeazvqIOj20="

# ── URLs ─────────────────────────────────────────────────────────────────────
# Where the portal answers — used for the links in verification/reset emails.
FRONTEND_URL="http://localhost:3010"
BACKEND_PUBLIC_URL="http://localhost:3011"
CORS_ORIGIN="http://localhost:3010,http://127.0.0.1:3010"

# ── MinIO object storage ─────────────────────────────────────────────────────
# 9014 is the host port ppx_minio publishes for its internal 9000.
# MINIO_PUBLIC_URL is the address a BROWSER fetches stored objects from; without
# it, saved URLs name an address that resolves only inside the compose network.
MINIO_ENDPOINT=localhost
MINIO_PORT=9014
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=StrongPassword@123
MINIO_BUCKET=attendance-photos
MINIO_PRIVATE_BUCKET=secure-documents
MINIO_PUBLIC_URL=http://localhost:9014
# Seconds a bucket check may take at boot before it counts as a failure.
MINIO_INIT_TIMEOUT_MS=10000

# ── Face recognition ─────────────────────────────────────────────────────────
# Distance threshold, lower = stricter. Confidence = (1 - distance) * 100.
FACE_RECOGNITION_THRESHOLD="0.4"
FACE_RECOGNITION_MAX_DESCRIPTORS="5"
FACE_RECOGNITION_MIN_QUALITY="0.5"

# ── Outbound channels ────────────────────────────────────────────────────────
# All off locally. Each one reaches a real person the moment it is switched on,
# so opt in deliberately rather than inheriting a default.
MAIL_ENABLED=false
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="noreply@peoplepay360.local"
MAIL_FROM_NAME="People Pay 360"

WHATSAPP_ENABLED=false
WHATSAPP_INBOUND_ENABLED=false
WHATSAPP_BASE_URL=""
WHATSAPP_INSTANCE_NAME=""
WHATSAPP_API_KEY=""
WHATSAPP_WEBHOOK_SECRET="dev-local-webhook-secret-change-me"

# ── HR Copilot / MCP ─────────────────────────────────────────────────────────
# Managed in the UI (Settings → HR Copilot); the DB value wins. These are the
# first-boot fallback only, and off until a key is saved there.
COPILOT_ENABLED=false
MCP_ENABLED=false
MCP_AUDIT_READS="true"
MCP_MAX_ITEMS="50"
COPILOT_LLM_BASE_URL="https://openrouter.ai/api/v1"
COPILOT_LLM_API_KEY=""
COPILOT_MAX_ITERATIONS="8"
COPILOT_PENDING_ACTION_TTL_MINUTES="10"
COPILOT_RATE_LIMIT="2000"
COPILOT_RATE_WINDOW_MS="300000"
