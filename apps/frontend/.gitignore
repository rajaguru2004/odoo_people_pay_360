# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Test artifacts. Paths are relative to apps/frontend, which is where this
# .gitignore lives — the per-role sessions in .auth/ are real access tokens.
e2e/.auth/
e2e/.results/
e2e/.report/
# Deliberate hub captures — a record of what the page drew, not a fixture.
e2e/.screens/

# User-manual capture output: the annotated screenshots, the reconnaissance
# sweep, the session the capture signs in with, and the manifest that ties the
# legends to the badges. All of it is REGENERATED by:
#
#   scripts/manual-stack.sh up && scripts/manual-stack.sh seed
#   scripts/manual-stack.sh capture
#
# Roughly 40 MB of PNGs per run and rewritten on every capture, so it is build
# output rather than source. What IS tracked is e2e/manual/ — the specs that
# produce it.
e2e/.manual/

# The administrator manual's capture output, on the same terms as e2e/.manual/
# above: regenerated by `scripts/manual-stack.sh admin-capture`, and build
# output rather than source.
e2e/.manual-admin/

# The user-manual pipeline's own Next build directory (NEXT_DIST_DIR). Separate
# from .next so a dev server in this checkout and the manual's build cannot
# fight over the same output.
.next-manual/

# The Clarity verification build (NEXT_DIST_DIR), for the same reason: the
# browser check in docs/ANALYTICS-CLARITY.md needs a production build with the
# project id baked in, and must not fight a dev server over .next.
.next-clarity-verify/

# The mobile-UI preview build (NEXT_DIST_DIR). A `next dev` pointed at the local
# test backend, run beside the everyday dev server on :3000 — they cannot share
# .next, because the second one to start dies on `Unable to acquire lock at
# .next/dev/lock`. See docs/ESS-MOBILE-UI-TRACKER.md.
.next-mobile-dev/
