{
  "name": "ess-portal-frontend",
  "version": "0.1.0",
  "author": "rajaguru2004",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:matrix": "playwright test --config e2e/playwright.config.ts route-matrix",
    "test:e2e:mobile": "playwright test --config e2e/playwright.config.ts ess-mobile --project employee",
    "test:e2e:time": "playwright test --config e2e/playwright.config.ts time-",
    "test:e2e:org": "playwright test --config e2e/playwright.config.ts organization-",
    "test:e2e:people": "playwright test --config e2e/playwright.config.ts people-",
    "test:e2e:finance": "playwright test --config e2e/playwright.config.ts finance-",
    "test:e2e:report": "playwright show-report e2e/.report",
    "test:e2e:leave": "playwright test --config e2e/playwright.config.ts leave",
    "test:e2e:overtime": "playwright test --config e2e/playwright.config.ts overtime",
    "test:e2e:leave-ot": "playwright test --config e2e/playwright.config.ts \"(leave|overtime|approvals)\"",
    "test:e2e:approval-chain": "E2E_ALLOW_FLAG_FLIP=1 playwright test --config e2e/playwright.config.ts approval-chain",
    "test:e2e:attendance": "playwright test --config e2e/playwright.config.ts attendance-",
    "test:component:leave-ot": "vitest run --project component app/dashboard/leaves app/dashboard/overtime app/dashboard/my-leaves app/dashboard/my-overtime app/dashboard/my-department app/dashboard/approvals",
    "test:e2e:payroll": "playwright test --config e2e/playwright.config.ts \"(payroll|bank-)\"",
    "test:e2e:payroll-edge": "playwright test --config e2e/playwright.config.ts \"payroll-edge\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.62.11",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/luxon": "^3.7.1",
    "@uiw/react-md-editor": "^4.1.1",
    "@xyflow/react": "^12.10.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.26.2",
    "grapesjs": "^0.22.12",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "next": "16.1.3",
    "next-intl": "^4.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.1",
    "react-intersection-observer": "^10.0.2",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "^0.8.10",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
