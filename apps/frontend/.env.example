# ─────────────────────────────────────────────────────────────────────────────
# People Pay 360 — Portal environment
#
# Copy to `.env.local`. EVERY `NEXT_PUBLIC_*` VALUE HERE IS BUILD-TIME:
# `next build` inlines it into the browser bundle, so setting one on a running
# container does nothing. For Docker they must be passed as --build-arg (see
# apps/frontend/Dockerfile and the `frontend.build.args` block in
# docker-compose.yml).
# ─────────────────────────────────────────────────────────────────────────────

# Where the API lives. Leave it UNSET for same-origin, which is correct behind
# the catch-all rewrite in next.config.ts; set it explicitly for a split
# deployment (portal on one host, API on another).
NEXT_PUBLIC_API_URL=http://localhost:3011

# Private network hop used by the SSR rewrite only — never reaches the browser.
# Set this when the container can address the API by a name the browser cannot
# (e.g. the compose service name).
# BACKEND_INTERNAL_URL=http://backend:3011

# Product naming shown before the backend's branding settings load.
NEXT_PUBLIC_APP_NAME=People Pay 360

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Leave commented out to ship with analytics disabled — no script is loaded and
# every tracking call is a no-op.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
