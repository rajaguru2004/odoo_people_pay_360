# ─────────────────────────────────────────────────────────────────────────────
# People Pay 360 — portal environment TEMPLATE.
#
#   cp apps/frontend/.env.example apps/frontend/.env.local
#
# Every NEXT_PUBLIC_* value here is BUILD-TIME. `next build` inlines it, so
# setting one on a running container does nothing — pass it as a --build-arg.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3011

# Uncomment to run against a deployed API instead of the local one:
# NEXT_PUBLIC_API_URL=https://api.peoplepay360.example.com

NEXT_PUBLIC_APP_NAME=People Pay 360

# ── Optional analytics ───────────────────────────────────────────────────────
# Both no-op when unset. The axios interceptor records METHOD + sanitised
# endpoint + status for every write — never a request or response body.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_DEBUG=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_CLARITY_ALLOW_LOCALHOST=

# ── Server-side only ─────────────────────────────────────────────────────────
# Runtime, never sent to the browser: used by the SSR rewrite and
# generateMetadata(). Set to the in-network API address when running in Docker.
# BACKEND_INTERNAL_URL=http://backend:3011
