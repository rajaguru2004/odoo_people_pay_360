# Local development. See .env.example for what each value means and why every
# NEXT_PUBLIC_* here is a BUILD-time value rather than a runtime one.

# Local backend. Ports are offset from the HRM/ESS checkout (3011/3010 instead
# of 3001/3000) so both stacks can run on this machine at once.
NEXT_PUBLIC_API_URL=http://localhost:3011

# Uncomment to run against a deployed API instead of the local one:
# NEXT_PUBLIC_API_URL=https://api.peoplepay360.example.com

NEXT_PUBLIC_APP_NAME=People Pay 360

# Analytics off in development.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Demo accounts on the sign-in screen ──────────────────────────────────────
# A collapsible panel offering the accounts `npm run db:seed` creates, so a
# fresh checkout can be opened without looking an address up.
#
# Unset it behaves as: ON outside production, OFF in a production build. Set it
# to "true" only for a deployment whose data is genuinely throwaway — the panel
# prints an administrator email and its password is inlined into the JS bundle,
# so on a real workforce it is an admin account handed to anyone who opens the
# page.
# NEXT_PUBLIC_DEMO_LOGINS=true
#
# Only needed if you seeded with a different SEED_ADMIN_PASSWORD.
# NEXT_PUBLIC_DEMO_PASSWORD=Admin@123
