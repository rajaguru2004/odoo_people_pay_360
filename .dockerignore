# ── Node dependencies ─────────────────────────────────────────────────────────
node_modules
apps/backend/node_modules
apps/frontend/node_modules

# ── Build outputs ─────────────────────────────────────────────────────────────
apps/backend/dist
apps/frontend/.next
apps/frontend/out

# ── VCS ───────────────────────────────────────────────────────────────────────
.git
.gitignore

# ── Editor & tooling ─────────────────────────────────────────────────────────
.agents
.idea
.vscode

# ── Docs (not needed in image) ────────────────────────────────────────────────
*.md
docs

# ── Env files (secrets should not be baked into images) ──────────────────────
apps/backend/.env
apps/frontend/.env.local

# NOTE: Per-service Dockerfiles (apps/backend/Dockerfile, apps/frontend/Dockerfile)
# have their own scoped .dockerignore files. This root .dockerignore is only
# active when someone builds from the monorepo root.
